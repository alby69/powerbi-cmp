table ANALISI_PRODOTTO

	measure Agenzia =
			
			VAR importo_cg =
			    CALCULATE (
			        [Importo],
			        FILTER ( MOVCG, MOVCG[Conto] = "4030004" && MOVCG[Source Code] = "ACQUISTI" )
			    )
			VAR importo_acc =
			    CALCULATE (
			        [Importo Accantonamenti],
			        FILTER ( ACCANTONAMENTI, ACCANTONAMENTI[Conto] = "4030004" )
			    )
			RETURN
			    importo_cg + importo_acc
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure Controstallie =
			
			CALCULATE (
			    [Importo],
			    FILTER ( MOVCG, ( MOVCG[Conto] = "4030008" && MOVCG[Progetto] = "ML04" ) )
			)
		displayFolder: COSTO_ACQUISTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Dogana =
			
			CALCULATE (
			    [Importo],
			    FILTER (
			        MOVCG,
			        ( MOVCG[Conto] = "4030002"
			            && MOVCG[Source Code] = "ACQUISTI" )
			    )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure Perizia =
			
			CALCULATE (
			    [Importo],
			    FILTER ( MOVCG, MOVCG[Conto] = "4030007" && MOVCG[Progetto] = "ML04" )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure 'Recupero Controstallie' =
			
			CALCULATE ( [Importo], FILTER ( MOVCG, MOVCG[Conto] = "3400025" ) )
		displayFolder: COSTO_ACQUISTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Recupero Dazi Doganali' =
			
			VAR filtro_nave =
			    { SELECTEDVALUE ( MEZZI_TRASPORTO[Codice Mezzo] ) }
			VAR importo_rec =
			    CALCULATE (
			        [Importo Doc Vendita],
			        FILTER (
			            'DOCUMENTO VENDITA',
			            'DOCUMENTO VENDITA'[No_] = "3400026"
			                || 'DOCUMENTO VENDITA'[Progetto] = "ML04"
			                || 'DOCUMENTO VENDITA'[Mezzo Trasporto] IN filtro_nave
			        )
			    )
			RETURN
			    importo_rec
			/*
			    CALCULATE(
			        importo_rec,
			        VALUES(MEZZI_TRASPORTO[Nr_])
			    )
			*/
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure 'Recupero Spese Terzi' =
			
			CALCULATE ( [Importo], FILTER ( MOVCG, MOVCG[Conto] = "3400023" ) )
		displayFolder: COSTO_ACQUISTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rimorchio =
			
			CALCULATE (
			    [Importo],
			    FILTER ( MOVCG, MOVCG[Conto] = "4030006" && MOVCG[Progetto] = "ML04" )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure 'Trasporto Acquisti' =
			
			VAR trasp =
			    CALCULATE (
			        [Importo],
			        FILTER ( MOVCG, MOVCG[Conto] = "4030003" && MOVCG[Source Code] = "REGACQ" )
			    )
			
			/*
			VAR trasp_2 =
			    CALCULATE (
			        [Importo],
			        FILTER (
			            MOVCG,
			            MOVCG[Conto] = "2030004"
			                && MOVCG[Source Code] = "REGACQ"
			                && MOVCG[Progetto] = "AS10"
			        )
			    )
			*/
			RETURN
			    trasp
			    //trasp + trasp_2
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure COSTI_ACCESSORI_GPL =
			
			VAR costi_acc = [Dogana] + [Agenzia] + [Rimorchio] + [Perizia] + [Controstallie] - [Recupero Spese Terzi] - [Recupero Controstallie] - [Recupero Dazi Doganali]
			RETURN
			    costi_acc
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure '€/Ton CostoGPL_Resa' =
			
			DIVIDE ( [Total Costs NAVI], [Qta Ton Acquisto IPEM CD], 0 )
		displayFolder: COSTO_ACQUISTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'COSTO GPL' =
			
			[Materia Prima €] + [Trasporto Acquisti]
		displayFolder: COSTO_ACQUISTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Materia Prima € OLD' =
			
			VAR imp_mp =
			    CALCULATE (
			        [Importo Accantonamenti],
			        FILTER ( ACCANTONAMENTI, ACCANTONAMENTI[Conto] = "4020002" )
			    )
			VAR imp_mp_2 =
			    CALCULATE (
			        [Importo Accantonamenti],
			        FILTER ( ACCANTONAMENTI, ACCANTONAMENTI[Conto] = "2030004" )
			    )
			RETURN
			    imp_mp + imp_mp_2
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure 'Total Costs NAVI' =
			
			[COSTO GPL] + [COSTI_ACCESSORI_GPL]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure 'Materia Prima €' =
			
			VAR imp_mp =
			    CALCULATE (
			        [Importo],
			        FILTER ( MOVCG, MOVCG[Conto] = "4020002" && MOVCG[Source Code] = "REGACQ" )
			    )
			VAR imp_mp_2 =
			    CALCULATE (
			        [Importo],
			        FILTER (
			            MOVCG,
			            MOVCG[Conto] = "2030004"
			                && MOVCG[Source Code]
			                IN { "REGACQ", "REGACQIC" }
			                && MOVCG[Progetto] = ""
			        )
			    )
			RETURN
			    imp_mp + imp_mp_2
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

	measure 'Materia Prima € 2' =
			
			CALCULATE (
			    [Importo],
			    FILTER (
			        MOVCG,
			        MOVCG[Conto] = "2030004"
			            && MOVCG[Source Type] = ""
			            && MOVCG[Mezzo Trasporto] <> ""
			    )
			)
		displayFolder: COSTO_ACQUISTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Perizia 2' =
			
			CALCULATE (
			    [Importo ACQ],
			    FILTER ( MOVCG, MOVCG[Conto] = "4030007" && MOVCG[Progetto] = "ML04" )
			)
		displayFolder: COSTO_ACQUISTO

	measure 'Costo Acquisto Qta Ton' =
			
			IF ( ISBLANK ( [Qta Ton] ), BLANK (), [CMP Acquisto] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Recupero Spese Trasporto' =
			
			CALCULATE ( ABS ( [Importo] ), FILTER ( MOVCG, MOVCG[Conto] = "3400024" ) )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: COSTO_ACQUISTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'CMP Acquisto CUM' =
			
			CALCULATE (
			    [CMP Acquisto],
			    FILTER ( ALL ( CALENDARIO ), CALENDARIO[Date] <= MAX ( CALENDARIO[Date] ) )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: CMP

	measure 'CMP Prodotto' =
			
			DIVIDE ( [Total Costs NAVI], [Qta Ton] )
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CMP Acquisto CD' =
			
			DIVIDE ( [Total Costs NAVI], [Qta Ton Acquisto IPEM CD] )
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CMP Prodotto CUM' =
			
			CALCULATE (
			    [CMP Prodotto],
			    FILTER ( ALL ( CALENDARIO ), CALENDARIO[Date] <= MAX ( CALENDARIO[Date] ) )
			)
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CMP Acquisto' = ```
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			VAR filtro_articolo = { SELECTEDVALUE ( ARTICOLI[Codice Articolo], BLANK () ) }
			
			VAR cmp_mix = [Costo Tab MIX Resa]
			VAR cmp_propano = [Costo Tab Propano]
			
			VAR qta_mix = SUMX('Tab MIX', 'Tab MIX'[Qta BIL] )
			VAR qta_propano = SUMX('Tab PROPANO', 'Tab PROPANO'[Qta Ton IPEM] )
			
			VAR cmp_ALL = DIVIDE((cmp_mix * qta_mix) + (cmp_propano * qta_propano),qta_mix + qta_propano)
			
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", cmp_mix,
			        filtro_gruppo = "PROPANO", cmp_propano,
			        filtro_gruppo = BLANK (), cmp_ALL // IF(filtro_articolo IN {"1","1T"},cmp_mix,cmp_propano) 
			    )
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: CMP

		changedProperty = FormatString

	measure 'CMP Acquisto Prodotto' =
			
			DIVIDE ( [Importo Acquisto], [Qta Acquisto], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: CMP

		changedProperty = FormatString

	measure 'Importo Costo Acquisto' =
			
			[Qta Ton Acquisto IPEM CD] * [CMP Acquisto]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO_PRODOTTO

		changedProperty = FormatString

	measure 'Importo Acquisto' = ```
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			VAR filtro_articolo = { SELECTEDVALUE ( ARTICOLI[Codice Articolo], BLANK () ) }
			
			VAR imp_mix = [Importo Costo Tab MIX]
			VAR imp_propano = [Importo Costo Tab Propano]
			
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", imp_mix,
			        filtro_gruppo = "PROPANO", imp_propano,
			        filtro_gruppo = BLANK (), imp_mix + imp_propano //IF(filtro_articolo IN {"1","1T"},imp_mix,imp_propano)
			    )
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_PRODOTTO

		changedProperty = FormatString

	measure 'Margine Unitario' = ```
			
			    IF ([Prezzo Vendite] > 0,
			        [Prezzo Vendite] - [CMP Acquisto],
			        0
			    )
			/*
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			
			VAR imp_mix = [Prezzo Vendita] - [CMP Acquisto]
			VAR imp_propano = [Prezzo Vendita] - [CMP Acquisto]
			
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", imp_mix,
			        filtro_gruppo = "PROPANO", imp_propano,
			        filtro_gruppo = BLANK (), DIVIDE(imp_mix + imp_propano,2,0) //IF(filtro_articolo IN {"1","1T"},imp_mix,imp_propano)
			    )
			*/    
			```
		displayFolder: MARGINE

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Profitto' = DIVIDE ( [Importo Margine], [Importo Vendita], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: MARGINE

		changedProperty = FormatString

	measure 'QoQ Profitto Cliente' = ```
			
			VAR last_q = 
			    CALCULATE(
			        [% Profitto],
			        DATEADD(CALENDARIO[Date],-1,QUARTER)
			    )
			RETURN    
			    [% Profitto] - last_q
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: MARGINE

		changedProperty = FormatString

	measure 'QoQ Vendite Cliente' = ```
			
			VAR last_q = 
			    CALCULATE(
			        [Importo Vendita %],
			        DATEADD(CALENDARIO[Date],-1,QUARTER)
			    )
			RETURN    
			    [Importo Vendita %] - last_q
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: MARGINE

		changedProperty = FormatString

	measure 'Trasporto Vendite' =
			
			CALCULATE ( [Importo], FILTER ( MOVCG, ( MOVCG[Conto] = "4110045" ) ) )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filtro Anno' =
			
			SELECTEDVALUE ( CALENDARIO[Year] )

	measure 'Filtro Mese' =
			
			SELECTEDVALUE ( CALENDARIO[MonthName] )

	measure 'Costo Venduto' = ```
			[CMP Giacenza] * [Qta Vendita]
			/*
			VAR imp_giacenza = [Importo Giacenza]
			VAR imp_giacenza_LM = CALCULATE ( imp_giacenza, DATEADD ( CALENDARIO[Date], -1, MONTH ) )
			VAR imp_giacenza_NM = CALCULATE ( imp_giacenza, DATEADD ( CALENDARIO[Date], 1, MONTH ) )
			
			VAR importo_acquisto_cm = [Importo Acquisto]
			
			RETURN
			    imp_giacenza_LM +
			    importo_acquisto_cm -
			    imp_giacenza_NM
			    
			/*
			    (qta_rim_iniziali * cmp_LM) +
			    importo_acquisto_cm -
			    (qta_rim_finali * cmp)
			*/
			*/
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

	measure 'Importo Giacenza Iniziale' =
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			//VAR filtro_articolo = { SELECTEDVALUE ( ARTICOLI[Codice Articolo], BLANK () ) }
			
			VAR qta_mix = CALCULATE (
			    [Importo],
			    FILTER ( MOVCG, MOVCG[Conto] = "4010003") //rimaneze iniziale MIX
			)
			VAR qta_propano = CALCULATE (
			    [Importo],
			    FILTER ( MOVCG, MOVCG[Conto] = "4010002") //rimaneze iniziale Propano
			)
			
			VAR qta_ALL = qta_mix + qta_propano
			
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_ALL
			    )
			
			
			//[Qta Ton Giacenza] * [CMP Giacenza]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_PRODOTTO

		changedProperty = FormatString

	measure 'CMP Giacenza' = ```
			(([Importo Acquisto] + [Importo Giacenza Iniziale]) / ([Qta Acquisto] + [Qta Giacenza Iniziale])
			/*
			CMP Giacenza = 
			VAR GiacenzaMesePrecedente = 
			    CALCULATE(
			        [Importo Giacenza],
			        DATEADD(CALENDARIO[Date], -1, MONTH)
			    )
			
			VAR GiacenzaIniziale = 
			    COALESCE(GiacenzaMesePrecedente, [Importo Giacenza Iniziale])
			
			RETURN
			    DIVIDE(
			        [Importo Acquisto] + GiacenzaIniziale,
			        [Qta Acquisto] + [Qta Giacenza Iniziale]
			    )
			*/
			/*
			IF(ISBLANK([CMP Acquisto AVG YTD]),
			    BLANK(),
			    [CMP Acquisto AVG YTD]
			)
			*/
			/*
			VAR misura = [CMP Acquisto AVG QTD]
			//VAR misura = [CMP Acquisto]
			VAR cmp_LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -1, MONTH ) )
			VAR cmp_2LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -2, MONTH ) )
			VAR cmp_3LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -3, MONTH ) )
			VAR cmp_4LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -4, MONTH ) )
			
			VAR tot_cmp = cmp_LM + cmp_2LM + cmp_3LM + cmp_4LM
			VAR nr_cmp = 4
			
			RETURN
				DIVIDE(tot_cmp,nr_cmp,0)
			*/)
			```
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CMP Acquisto AVG QTD' = ```
			
			    AVERAGEX (
			        VALUES(CALENDARIO[MonthInCalendar]),
			        TOTALQTD([CMP Acquisto],CALENDARIO[Date])
			    )
			```
		formatString: 0.00
		displayFolder: CMP

		changedProperty = FormatString

	measure 'CMP Acquisto AVG YTD' = ```
			
			    AVERAGEX (
			        VALUES(CALENDARIO[MonthInCalendar]),
			        TOTALYTD([CMP Acquisto],CALENDARIO[Date])
			    )
			```
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CMP Giacenza YTD' =
			
			VAR misura = [CMP Acquisto AVG YTD]
			//VAR misura = [CMP Acquisto]
			VAR cmp_LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -1, MONTH ) )
			VAR cmp_2LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -2, MONTH ) )
			VAR cmp_3LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -3, MONTH ) )
			VAR cmp_4LM = CALCULATE ( misura, DATEADD ( CALENDARIO[Date], -4, MONTH ) )
			
			VAR tot_cmp = cmp_LM + cmp_2LM + cmp_3LM + cmp_4LM
			VAR nr_cmp = 4
			
			RETURN
				DIVIDE(tot_cmp,nr_cmp,0)
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CMP Acquisto 2' = ```
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			VAR filtro_articolo = { SELECTEDVALUE ( ARTICOLI[Codice Articolo], BLANK () ) }
			
			VAR cmp_mix = AVERAGEX('Tab MIX', 'Tab MIX'[Costo] )
			VAR cmp_propano = AVERAGEX('Tab PROPANO', 'Tab PROPANO'[Costo] )
			
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", cmp_mix,
			        filtro_gruppo = "PROPANO", cmp_propano,
			        filtro_gruppo = BLANK (), DIVIDE(cmp_mix + cmp_propano,2,0) // IF(filtro_articolo IN {"1","1T"},cmp_mix,cmp_propano) 
			    )
			```
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Margine' = [Qta Vendita] * [Margine Unitario]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: MARGINE

	measure 'Nr Mezzi' =
			CALCULATE(
			    COUNTX(MEZZI_TRASPORTO,[Qta Ton Acquisto IPEM CD]),
			    MEZZI_TRASPORTO[Codice Mezzo] <> "ATB"
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo Venduto 2' =
			[Importo Giacenza Iniziale] - [Importo Acquisto]
			/*
			    CALCULATE ( [Importo Giacenza], DATEADD ( CALENDARIO[Date], -1, MONTH ) ) +
			    [Importo Acquisto] -
			    CALCULATE ( [Importo Giacenza], DATEADD ( CALENDARIO[Date], +1, MONTH ) )
			*/

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo Venduto 3' =
			
			
			VAR imp_giacenza = [Importo Giacenza Iniziale]
			VAR imp_giacenza_LM = CALCULATE ( imp_giacenza, DATEADD ( CALENDARIO[Date], -1, MONTH ) )
			VAR imp_giacenza_NM = CALCULATE ( imp_giacenza, DATEADD ( CALENDARIO[Date], 1, MONTH ) )
			
			VAR importo_acquisto_cm = [Importo Acquisto]
			
			RETURN
			    imp_giacenza_LM +
			    importo_acquisto_cm -
			    imp_giacenza_NM

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CMP Acquisto MEDIAN YTD' = ```
			
			    MEDIANX(
			        VALUES(CALENDARIO[MonthInCalendar]),
			        TOTALYTD([CMP Acquisto],CALENDARIO[Date])
			    )
			```
		displayFolder: CMP

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Giacenza Finale' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			//VAR filtro_articolo = { SELECTEDVALUE ( ARTICOLI[Codice Articolo], BLANK () ) }
			
			VAR qta_mix = CALCULATE (
			    [Importo],
			    FILTER ( MOVCG, MOVCG[Conto] = "3300003") //rimaneze iniziale MIX
			)
			VAR qta_propano = CALCULATE (
			    [Importo],
			    FILTER ( MOVCG, MOVCG[Conto] = "3300002") //rimaneze iniziale Propano
			)
			
			VAR qta_ALL = qta_mix + qta_propano
			
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_ALL
			    )
			
			
			```
		displayFolder: IMPORTO_PRODOTTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Movimento Mese' = ```
			[Importo Acquisto] - ([Qta Vendita] * [CMP Giacenza])
			
			/*
			VAR DataMax = MAX(CALENDARIO[Date])
			
			RETURN
			    [Importo Giacenza Iniziale] +
			    CALCULATE (
			        [Importo Acquisto] - ([Qta Vendita] * [CMP Giacenza]),
			        FILTER (
			            ALL (CALENDARIO),
			            CALENDARIO[Date] <= DataMax
			        )
			    )
			*/
			
			```
		displayFolder: IMPORTO_PRODOTTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Giacenza Iniziale (Finale)'
		displayFolder: IMPORTO_PRODOTTO

		annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":"\nVAR ValoreCorrente = [Importo Giacenza Iniziale]   -- da MOVCG, presente solo a gen\n\nVAR ValorePrecedente =\n    CALCULATE(\n        [Importo Giacenza],                        -- giacenza FINALE del mese precedente\n        DATEADD(CALENDARIO[Date], -1, MONTH)\n    )\n\nRETURN\n    IF(NOT ISBLANK(ValoreCorrente), ValoreCorrente, ValorePrecedente)"}

		annotation 277cc1b9-af89-4597-8e15-cacc25c0886b = ```
				È stata rilevata una dipendenza circolare: Measure: 'ANALISI_PRODOTTO'[Importo Giacenza Iniziale (Finale)], Measure: 'ANALISI_PRODOTTO'[Importo Giacenza], Measure: 'ANALISI_PRODOTTO'[Importo Giacenza Iniziale (Finale)].
				
				```

	measure 'Importo Giacenza' =
			
			VAR Risultato =
			    [Importo Giacenza Iniziale] +
			    CALCULATE (
			        [Importo Movimento Mese],
			        DATESYTD ( CALENDARIO[Date] )
			    )
			
			RETURN
			    IF ( ABS ( Risultato ) > 100000000, BLANK (), Risultato )
			
			//    [Importo Giacenza Iniziale (Finale)] + [Importo Movimento Mese]
		displayFolder: IMPORTO_PRODOTTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

