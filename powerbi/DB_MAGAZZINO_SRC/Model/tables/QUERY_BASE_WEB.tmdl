table QUERY_BASE_WEB

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: Name

		annotation SummarizationSetBy = Automatic

	column Value
		dataType: string
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic

	partition QUERY_BASE_WEB = m
		mode: import
		queryGroup: DIM
		source =
				//==================================================
				// QUERY_BASE_WEB
				//==================================================
				
				let
				    Output =
				        [
				            PREZZI = PREZZI_MIX,
				            COMP = TAB_COMPETENZA
				        ]
				in
				    Output

	annotation PBI_NavigationStepName = Navigazione

	annotation PBI_ResultType = Record

