table FACT_Vendite

	measure 'Qta Tab Vendite' =
			// Somma totale delle quantità presenti nella tabella FACT_Vendite
			SUMX('FACT_Vendite', 'FACT_Vendite'[Quantity])
		annotation PBI_Description = "Somma quantità tabella vendite"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Qta Vendite' =
			// Conteggio totale dei movimenti di vendita (basato sulla colonna CountQta)
			SUM('FACT_Vendite'[CountQta])
		annotation PBI_Description = "Conteggio record vendite"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CodiceArticolo
		summarizeBy: none
		isNameInferred
		sourceColumn: DIM_Articoli[CodiceArticolo]

		annotation SummarizationSetBy = Automatic

	column Quantity
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Qta]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CodiceSoggetto
		summarizeBy: none
		isNameInferred
		sourceColumn: FACT_Magazzino[CodiceSoggetto]

		annotation SummarizationSetBy = Automatic

	column CodiceCategoria
		summarizeBy: none
		isNameInferred
		sourceColumn: FACT_Magazzino[CodiceCategoria]

		annotation SummarizationSetBy = Automatic

	column CodiceDeposito
		summarizeBy: none
		isNameInferred
		sourceColumn: FACT_Magazzino[CodiceDeposito]

		annotation SummarizationSetBy = Automatic

	column MonthInCalendar
		summarizeBy: none
		isNameInferred
		sourceColumn: DIM_Calendario[MonthInCalendar]

		annotation SummarizationSetBy = Automatic

	column Date
		formatString: Short Date
		summarizeBy: none
		isNameInferred
		sourceColumn: DIM_Calendario[Date]

		annotation SummarizationSetBy = Automatic

	column Gruppo =
			IF (
				'FACT_Vendite'[CodiceCategoria] = "NAZPERM",
				SWITCH (
					TRUE(),
					'FACT_Vendite'[CodiceSoggetto] = "C00261", "LIQUIGAS",
					'FACT_Vendite'[CodiceSoggetto] = "C00229", "BUTANGAS",
					'FACT_Vendite'[CodiceSoggetto] = "C00525", "ANORD",
					"IPEM"
				),
				BLANK()
			)
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CountQta
		formatString: 0
		summarizeBy: sum
		sourceColumn: [# Qta]

		annotation SummarizationSetBy = Automatic

	partition FACT_Vendite = calculated
		mode: import
		source = ```
				
				VAR filtro_articolo = {"1","1T","2","2T"}
				
				VAR tab_vendite =
				        SUMMARIZECOLUMNS(            
				            DIM_Calendario[MonthInCalendar],
				            DIM_Calendario[Date],
				            DIM_Articoli[CodiceArticolo],
				            FACT_Magazzino[CodiceSoggetto],
				            FACT_Magazzino[CodiceCategoria],
				            FACT_Magazzino[CodiceDeposito],
				            FILTER(FACT_Magazzino,FACT_Magazzino[TipoMovimento] = "Vendita"),
				            TREATAS(filtro_articolo,DIM_Articoli[CodiceArticolo]),
				            "Qta", ABS([Qta Magazzino]),
				            "# Qta", COUNTROWS(FACT_Magazzino)
				
				        )
				RETURN
				    FILTER(
				        tab_vendite,
				        DIM_Calendario[MonthInCalendar] <> BLANK()
				    )
				
				```

	annotation PBI_Id = 3ac231cfec2b4c2589b5b284d7fb0a55
