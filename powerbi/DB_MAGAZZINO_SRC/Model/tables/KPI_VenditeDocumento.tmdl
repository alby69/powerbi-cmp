			        filtro_gruppo = BLANK (), DIVIDE(importo_tot,qta_tot,0)
			    )
			*/
			```

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Media 2' = ```
			AVERAGEX(DIM_Calendario,[Qta Vendita Forecast])
			/*
			VAR first_year = IF(
			        SELECTEDVALUE(DIM_Calendario[Year]) <> BLANK(),
			        SELECTEDVALUE(DIM_Calendario[Year]) - 6,
			        MIN(DIM_Calendario[Year])
			    )
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            DIM_Calendario,
			            DIM_Calendario[Year],
			            "qta_vendite_anno", [Qta Vendita]
			    	),
			    	VALUE(DIM_Calendario[Year]) >= first_year &&
			    	VALUE(DIM_Calendario[Year]) <= YEAR(TODAY()) &&
			        [Qta Vendita] > 0
			    	
			    )
			
			VAR media = 
