table KPI_VenditeDocumento

	measure 'Importo Doc Vendita' =
			
			SUMX ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[Importo] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO

		changedProperty = FormatString

	measure 'Importo Articolo Doc Vendita' =
			
			CALCULATE (
			    KPI_VenditeDocumento[Importo Doc Vendita],
			    FILTER ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[TipoRiga] = "Articolo" )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo FT Doc Vendita' =
			
			CALCULATE (
			    KPI_VenditeDocumento[Importo Doc Vendita],
			    FILTER (
			        'FACT_DocumentoVendita',
			        'FACT_DocumentoVendita'[TipoRiga] = "Articolo"
			            && 'FACT_DocumentoVendita'[TipoDocumento] = "FT VENDITA"
			    )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo NC Doc Vendita' =
			
			CALCULATE (
			    KPI_VenditeDocumento[Importo Doc Vendita],
			    FILTER ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[TipoDocumento] = "NC VENDITA" )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita' =
			
			KPI_VenditeDocumento[Importo FT Doc Vendita] - KPI_VenditeDocumento[Importo Trasporto Doc Vendita] - KPI_VenditeDocumento[Importo NC Doc Vendita]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Costo Prodotto Doc Vendita' =
			
			[Costo Prodotto Mov_Val] * [Qta Doc Vendita Articolo]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Margine Doc Vendita' =
			
			[Margine Ton Doc Vendita] * [Qta Doc Vendita Articolo]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo FT PASSAGGIO Doc Vendita' =
			
			CALCULATE (
			    KPI_VenditeDocumento[Importo Doc Vendita],
			    REMOVEFILTERS ( DIM_Articoli ),
			    'FACT_DocumentoVendita'[TipoRiga] = "Conto",
			    'FACT_DocumentoVendita'[TipoDocumento] = "FT VENDITA"
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo NC PASSAGGIO Doc Vendita' =
			
			CALCULATE (
			    KPI_VenditeDocumento[Importo Doc Vendita],
			    FILTER (
			        'FACT_DocumentoVendita',
			        'FACT_DocumentoVendita'[TipoRiga] = "Conto"
			            && 'FACT_DocumentoVendita'[TipoDocumento] = "NC VENDITA"
			    )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto PASSAGGIO Doc Vendita' =
			
			KPI_VenditeDocumento[Importo FT PASSAGGIO Doc Vendita] - KPI_VenditeDocumento[Importo NC PASSAGGIO Doc Vendita]
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto FILTER Doc Vendita' =
			
			IF (
			    SELECTEDVALUE ( DIM_GruppiVendita[Gruppo] ) = "PASSAGGIO",
			    KPI_VenditeDocumento[Importo Netto PASSAGGIO Doc Vendita],
			    KPI_VenditeDocumento[Importo Netto Doc Vendita]
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Controllo (Doc - CG)' =
			
			KPI_Vendite[Importo Vendite] - KPI_Vendite[Importo Vendite (CG)]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Trasporto Doc Vendita' =
			
			SUMX ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[CostoTrasporto] )
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Doc Vendita - Trasporto' =
			
			KPI_VenditeDocumento[Importo Doc Vendita] - KPI_VenditeDocumento[Importo Trasporto Doc Vendita]
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita' = ```
			[Importo Netto Doc Vendita]   //[Qta Vendita] * [Prezzo Medio Vendita]
			/*
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "PROPANO", [Importo Netto Doc Vendita],
			        filtro_gruppo = "MIX", [Importo Doc Vendita - Trasporto],
			        filtro_gruppo = BLANK (), [Importo Doc Vendita - Trasporto]
			    )
			*/    
			```
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Acquisto Cliente' = [Qta Vendita] * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO

		changedProperty = FormatString

	measure 'Importo Vendita %' =
			
			VAR vendite_cliente = [Importo Vendita]
			VAR tot_vendite =
			    CALCULATE (
			        [Importo Vendita],
			        REMOVEFILTERS ( DIM_Clienti[Nome] )
			    )
			RETURN
			    DIVIDE ( vendite_cliente, tot_vendite, 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: IMPORTO

		changedProperty = FormatString

	measure 'Importo Vendita % LQ' =
			
			CALCULATE ( [Importo Vendita %], DATEADD ( DIM_Calendario[Date], -1, QUARTER ) )
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita N DAYS' = ```
			
			VAR NrOfDays = 90
			VAR ris = 
			    CALCULATE(
			        [Importo Vendita],
			        DATEADD(DIM_Calendario[Date],-NrOfDays,DAY)
			    )
			RETURN
			    ris
			```
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita IPEM N DAYS' = ```
			
			VAR NrOfDays = 90
			VAR importo_vendita_IPEM = 
			    CALCULATE(
			        [Importo Vendita],
			        //FILTER(DIM_Deposito,DIM_Deposito[Code]= "IPEM")
			        FILTER('FACT_DocumentoVendita','FACT_DocumentoVendita'[CodiceDeposito] = "IPEM")
			    )
			
			VAR ris = 
			    CALCULATE(
			        importo_vendita_IPEM,
			        DATEADD(DIM_Calendario[Date], -NrOfDays, DAY)
			    )
			RETURN
			    ris
			```
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita Articolo' =
			
			CALCULATE (
			    [Qta Doc Vendita],
			    FILTER ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[TipoRiga] = "Articolo" )
			)
		formatString: #,0.00
		displayFolder: QTA

	measure 'Qta Doc Vendita Cliente' =
			
