table KPI_VenditeDocumento

	measure 'Importo Doc Vendita' =
			
			SUMX ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[Importo] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo lordo da documenti di vendita"

		changedProperty = FormatString

	measure 'Importo Articolo Doc Vendita' =
			
			CALCULATE (
			    [Importo Doc Vendita],
			    'FACT_DocumentoVendita'[TipoRiga] = "Articolo"
			)
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo filtrato per righe di tipo Articolo"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo FT Doc Vendita' =
			
			CALCULATE (
			    [Importo Doc Vendita],
			    'FACT_DocumentoVendita'[TipoRiga] = "Articolo"
			        && 'FACT_DocumentoVendita'[TipoDocumento] = "FT VENDITA"
			)
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo totale fatture di vendita (FT VENDITA)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo NC Doc Vendita' =
			
			CALCULATE (
			    [Importo Doc Vendita],
			    'FACT_DocumentoVendita'[TipoDocumento] = "NC VENDITA"
			)
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo totale note di credito di vendita (NC VENDITA)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita' =
			
			[Importo FT Doc Vendita] - [Importo Trasporto Doc Vendita] - [Importo NC Doc Vendita]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo netto vendita (FT - Trasporto - NC)"

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Costo Prodotto Doc Vendita' =
			
			[Costo Prodotto] * [Qta Doc Vendita Articolo]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo del costo del prodotto basato sulla quantità e costo unitario"

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Margine Doc Vendita' =
			
			[Margine Ton Doc Vendita] * [Qta Doc Vendita Articolo]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo del margine calcolato su quantità e margine per tonnellata"

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo FT PASSAGGIO Doc Vendita' =
			
			CALCULATE (
			    [Importo Doc Vendita],
			    REMOVEFILTERS ( DIM_Articoli ),
			    'FACT_DocumentoVendita'[TipoRiga] = "Conto",
			    'FACT_DocumentoVendita'[TipoDocumento] = "FT VENDITA"
			)
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo fatture per movimenti di passaggio"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo NC PASSAGGIO Doc Vendita' =
			
			CALCULATE (
			    [Importo Doc Vendita],
			    'FACT_DocumentoVendita'[TipoRiga] = "Conto"
			        && 'FACT_DocumentoVendita'[TipoDocumento] = "NC VENDITA"
			)
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo note di credito per movimenti di passaggio"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto PASSAGGIO Doc Vendita' =
			
			[Importo FT PASSAGGIO Doc Vendita] - [Importo NC PASSAGGIO Doc Vendita]
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo netto per movimenti di passaggio"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto FILTER Doc Vendita' =
			
			IF (
			    SELECTEDVALUE ( DIM_GruppiVendita[Gruppo] ) = "PASSAGGIO",
			    [Importo Netto PASSAGGIO Doc Vendita],
			    [Importo Netto Doc Vendita]
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo netto filtrato dinamicamente tra Passaggi e Vendite Dirette"

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Controllo (Doc - CG)' =
			
			KPI_Vendite[Importo Vendite] - KPI_Vendite[Importo Vendite (CG)]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Differenza tra importo da documenti e importo da contabilità generale"

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Trasporto Doc Vendita' =
			
			SUMX ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[CostoTrasporto] )
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo totale dei costi di trasporto da documenti"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Doc Vendita - Trasporto' =
			
			[Importo Doc Vendita] - [Importo Trasporto Doc Vendita]
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo lordo documenti al netto del trasporto"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita' = ```
			[Importo Netto Doc Vendita]
			```
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo vendita principale (netto documenti)"

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Acquisto Cliente' = [Qta Vendita] * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo stimato di acquisto per il cliente basato sul CMP"

		changedProperty = FormatString

	measure 'Importo Vendita %' =
			
			VAR vendite_cliente = [Importo Vendita]
			VAR tot_vendite =
			    CALCULATE (
			        [Importo Vendita],
			        REMOVEFILTERS ( DIM_Clienti[Nome] )
			    )
			RETURN
			    DIVIDE ( vendite_cliente, tot_vendite, 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Percentuale dell'importo vendita del cliente sul totale"

		changedProperty = FormatString


	measure 'Importo Vendita N DAYS' = ```
			
			VAR NrOfDays = 90
			VAR ris = 
			    CALCULATE(
			        [Importo Vendita],
			        DATEADD(DIM_Calendario[Date],-NrOfDays,DAY)
			    )
			RETURN
			    ris
			```
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo vendita riferito agli ultimi N giorni (default 90)"

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita IPEM N DAYS' = ```
			
			VAR NrOfDays = 90
			VAR importo_vendita_IPEM = 
			    CALCULATE(
			        [Importo Vendita],
			        'FACT_DocumentoVendita'[CodiceDeposito] = "IPEM"
			    )
			
			VAR ris = 
			    CALCULATE(
			        importo_vendita_IPEM,
			        DATEADD(DIM_Calendario[Date], -NrOfDays, DAY)
			    )
			RETURN
			    ris
			```
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Importo vendita deposito IPEM negli ultimi N giorni"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita Articolo' =
			
			CALCULATE (
			    [Qta Doc Vendita],
			    'FACT_DocumentoVendita'[TipoRiga] = "Articolo"
			)
		formatString: #,0.00
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta per righe di tipo Articolo"

	measure 'Qta Doc Vendita Cliente' =
			
			CALCULATE (
			    [Qta Doc Vendita Articolo],
			    DIM_Clienti[CodiceCliente] = SELECTEDVALUE ( DIM_Clienti[CodiceCliente] )
			)
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta filtrata per il cliente selezionato"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita' =
			
			SUMX ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[Quantity] )
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità totale da documenti di vendita"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita IPEM' =
			
			CALCULATE (
			    [Qta Doc Vendita Articolo],
			    'FACT_DocumentoVendita'[CodiceDeposito] = "IPEM"
			)
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta da deposito IPEM"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita FT' =
			
			CALCULATE (
			    [Qta Doc Vendita Articolo],
			    'FACT_DocumentoVendita'[TipoDocumento] = "FT VENDITA"
			)
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità totale fatture di vendita"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita NC' =
			
			CALCULATE (
			    [Qta Doc Vendita],
			    'FACT_DocumentoVendita'[TipoDocumento] = "NC VENDITA"
			)
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità totale note di credito di vendita"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita Netta' =
			
			[Qta Doc Vendita FT] - [Qta Doc Vendita NC]
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità netta venduta (FT - NC)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}


	measure 'Qta Doc Vendita Gruppo Articolo' =
			
			VAR filtro_gruppo = { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			RETURN
			    IF(filtro_gruppo <> BLANK(),
			        CALCULATE (
			            [Qta Doc Vendita],
			            'FACT_DocumentoVendita'[GruppoRegistrazioneProdotto] = filtro_gruppo
			        ),
			        0
			    )
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta per gruppo registrazione prodotto"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita' = [Qta Doc Vendita Netta]
		formatString: #,0.00
		displayFolder: KPI Qta
		annotation PBI_Description = "Misura principale per la quantità venduta"

		changedProperty = FormatString



	measure 'Qta Vendita ALL' =
			
			SUMX ( ALL ( 'FACT_DocumentoVendita' ), [Qta Vendita] )
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità totale venduta (senza filtri)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita 3000002' = ```
			
			CALCULATE (
			    [Qta Doc Vendita],
			    'FACT_DocumentoVendita'[CodiceArticolo] = "3000002" &&
			    'FACT_DocumentoVendita'[TipoDocumento] = "FT VENDITA"
			)
			```
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta per l'articolo specifico 3000002"

		annotation PBI_FormatHint = {"isGeneralNumber":true}


	measure 'Qta Vendita AVG YTD Monthly' = ```
			
			
			    CALCULATE(
			        [Qta Vendita AVG Day],
			        ALL(DIM_Calendario),
			        DIM_Calendario[MonthInCalendar] <= MAX(DIM_Calendario[MonthInCalendar]) &&
			        DIM_Calendario[Year] = MAX(DIM_Calendario[Year])
			    )
			```
		formatString: #,0.00
		displayFolder: KPI Qta
		annotation PBI_Description = "Media mensile della quantità venduta YTD"

		changedProperty = FormatString

	measure 'Qta Vendita IPEM' = ```
			
			    CALCULATE(
			        [Qta Vendita],
			        'FACT_DocumentoVendita'[CodiceDeposito] = "IPEM"
			    )
			```
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta da deposito IPEM (misura base)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Media Pesata' = ```
			
			VAR qta_vendita_anno = 
			    CALCULATE(
			        [Qta Vendita],
			        ALL(DIM_Calendario[MonthName],DIM_Calendario[MonthOfYear])
			    )
			VAR tab_mese =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'FACT_DocumentoVendita',
			            DIM_Calendario[Year],
			            DIM_Calendario[MonthName]
			        ),
			        "Qta Mese", [Qta Vendita],
			        "Peso", DIVIDE([Qta Vendita],qta_vendita_anno,0)
			    )
			RETURN
			    SUMX(
			        tab_mese,
			        [Peso] * [Qta Mese]
			    )
			```
		formatString: #,0.00
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità media pesata sulle vendite mensili"

		changedProperty = FormatString

	measure 'Qta Vendita Cliente CUM' = ```
			
			VAR cliente_rank =
			    RANKX(
			        ALL(DIM_Clienti[Nome & Codice]),
			        [Qta Vendita],,
			        DESC,
			        Dense
			    )
			VAR RunningTotal =
			    CALCULATE(
			        [Qta Vendita],
			        FILTER(
			            ALL(DIM_Clienti[Nome & Codice]),
			            cliente_rank >= RANKX(
			                                ALL(DIM_Clienti[Nome & Codice]),
			                                [Qta Vendita],,
			                                DESC,
			                                Dense
			                            )
			        )
			    )
			RETURN
			    IF(
			        [Qta Vendita]<> BLANK(),
			        RunningTotal
			    )
			```
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità cumulata per classifica clienti"

		annotation PBI_FormatHint = {"isGeneralNumber":true}



	measure 'Importo Netto Doc Vendita LM CUM' =
			
			CALCULATE (
			    [Importo Netto Doc Vendita LM],
			    FILTER (
			        ALLSELECTED ( DIM_Calendario ),
			        DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			)
		displayFolder: KPI Time Intelligence
		annotation PBI_Description = "Importo netto mese precedente cumulato"

		annotation PBI_FormatHint = {"isGeneralNumber":true}


	measure 'Importo Netto Doc Vendita -2M CUM' =
			
			CALCULATE (
			    [Importo Netto Doc Vendita -2M],
			    FILTER (
			        ALLSELECTED ( DIM_Calendario ),
			        DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			)
		displayFolder: KPI Time Intelligence
		annotation PBI_Description = "Importo netto 2 mesi fa cumulato"

		annotation PBI_FormatHint = {"isGeneralNumber":true}


	measure 'Importo Vendite CY-LY' =
			
			[Importo Netto FILTER Doc Vendita] - CALCULATE([Importo Netto FILTER Doc Vendita], SAMEPERIODLASTYEAR(DIM_Calendario[Date]))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: KPI Time Intelligence
		annotation PBI_Description = "Differenza importo vendite tra anno corrente e precedente"

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}


	measure 'Qta Vendita Forecast CUM' = ```
			
			SUMX(
			    FILTER (
			        ALLSELECTED ( DIM_Calendario[Date] ),
			        DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    ),
			    [Qta Vendita Forecast]
			    
			)
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Quantità forecast cumulata"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast MA 30D' =
			
			VAR day_week =
			    SELECTEDVALUE ( DIM_Calendario[DayOfWeekName] )
			VAR weekend =
			    IF ( day_week IN { "sabato", "domenica" }, TRUE (), FALSE () )
			RETURN
			    IF( ISBLANK([Qta Vendita]) && weekend = FALSE(),
			        AVERAGEX (
			            DATESINPERIOD ( DIM_Calendario[Date], LASTDATE ( DIM_Calendario[Date] ), -30, DAY ),
			            [Qta Vendita]
			        ),
			        BLANK ()
			    )
		displayFolder: KPI Forecast
		annotation PBI_Description = "Media mobile 30 giorni per il forecast quantità"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast TOT' =
			
			IF (
			    ISBLANK ( [Qta Vendita] ),
			    CALCULATE (
			        [Qta Vendita Forecast MA 30D],
			        SAMEPERIODLASTYEAR ( DIM_Calendario[Date] )
			    ),
			    BLANK ()
			)
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast totale quantità combinato"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Remain' = ```
			
			VAR LastDateWithSales =
			    CALCULATE ( MAX ( 'FACT_DocumentoVendita'[DataSpedizione] ), REMOVEFILTERS () )
			VAR ForecastRemain =
			    CALCULATE (
			        [Qta Vendita Forecast],
			        KEEPFILTERS ( DIM_Calendario[Date] >= LastDateWithSales )
			    )
			RETURN
			    ForecastRemain
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast rimanente dalla data dell'ultima vendita"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita & Forecast' =
			
			[Qta Vendita] + [Qta Vendita Forecast Remain]
		displayFolder: KPI Forecast
		annotation PBI_Description = "Combinazione di quantità venduta reale e forecast rimanente"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita CUM vs Forecast CUM' =
			
			IF (
			    ISBLANK ( [Qta Vendita CUM] ),
			    BLANK (),
			    [Qta Vendita CUM] - [Qta Vendita Forecast CUM]
			)
		displayFolder: KPI Forecast
		annotation PBI_Description = "Differenza tra quantità cumulata reale e cumulata forecast"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Remain CUM' =
			
			CALCULATE (
			    [Qta Vendita Forecast Remain],
			    FILTER (
			        ALLSELECTED ( DIM_Calendario[Date] ),
			        DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			)
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast rimanente cumulato"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Remain Mediana' =
			
			MEDIANX ( DIM_Calendario, [Qta Vendita Forecast Remain] )
		displayFolder: KPI Forecast
		annotation PBI_Description = "Mediana del forecast rimanente"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression Line' = ```
			
			VAR data =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( DIM_Calendario ),
			            "x_values", DIM_Calendario[Date],
			            "y_values", [Qta Vendita CUM]
			        ),
			        AND ( NOT ( ISBLANK ( [x_values] ) ), NOT ( ISBLANK ( [y_values] ) ) )
			    )
			VAR y_sum =
			    SUMX ( data, [y_values] )
			VAR x_sum =
			    SUMX ( data, [x_values] )
			VAR x2 =
			    SUMX ( data, [x_values] ^ 2 )
			VAR xy =
			    SUMX ( data, [x_values] * [y_values] )
			VAR row_count =
			    COUNTROWS ( data ) -- Formula regressione lineare
			VAR Intercept =
			    DIVIDE ( ( y_sum * x2 - x_sum * xy ), ( row_count * x2 - ( x_sum ) ^ 2 ), 0 )
			VAR Slope =
			    DIVIDE (
			        ( row_count * xy - x_sum * y_sum ),
			        ( row_count * x2 - ( x_sum ) ^ 2 ),
			        0
			    )
			VAR Regression =
			    SUMX ( DIM_Calendario, Slope * DIM_Calendario[Date] + Intercept )
			RETURN
			    Regression
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Retta di regressione lineare sulle vendite cumulate"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression Slope' = ```
			
			VAR data =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( DIM_Calendario ),
			            "x_values", DIM_Calendario[Date],
			            "y_values", [Qta Vendita CUM]
			        ),
			        AND ( NOT ( ISBLANK ( [x_values] ) ), NOT ( ISBLANK ( [y_values] ) ) )
			    )
			VAR y_sum =
			    SUMX ( data, [y_values] )
			VAR x_sum =
			    SUMX ( data, [x_values] )
			VAR x2 =
			    SUMX ( data, [x_values] ^ 2 )
			VAR xy =
			    SUMX ( data, [x_values] * [y_values] )
			VAR row_count =
			    COUNTROWS ( data ) -- Formula regressione lineare
			VAR Slope = ( row_count * xy - x_sum * y_sum ) / ( row_count * x2 - ( x_sum ) ^ 2 )
			RETURN
			    Slope
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Pendenza della retta di regressione"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita ToDo' =
			
			VAR diff = [Valore Obiettivo Vendite] - [Qta Vendita ALL]
			RETURN
			    IF(diff >= 0, diff,0)
		formatString: #,0
		displayFolder: KPI Forecast
		annotation PBI_Description = "Quantità ancora da vendere per raggiungere l'obiettivo"

		changedProperty = FormatString

	measure 'Giorni Vendita x Obiettivo' = ```
			
			
			VAR div = DIVIDE ( [Qta Vendita ToDo], [Regression Slope], 0 )
			RETURN
			    IF( div >= 0, div, 0 ) 
			
			```
		formatString: 0
		displayFolder: KPI Forecast
		annotation PBI_Description = "Stima dei giorni necessari per raggiungere l'obiettivo"

		changedProperty = FormatString

	measure 'Data Obiettivo Vendita' =
			
			DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), DAY ( TODAY () ) + [Giorni Vendita x Obiettivo] )
		formatString: Short Date
		displayFolder: KPI Forecast
		annotation PBI_Description = "Data prevista per il raggiungimento dell'obiettivo di vendita"

		changedProperty = FormatString


	measure 'Importo Vendita AVG N Days LQ' =
			
			CALCULATE (
			    [Importo Vendita AVG N Days],
			    DATEADD ( 'FACT_DocumentoVendita'[DataRegistrazione], -1, QUARTER )
			)
		displayFolder: KPI Forecast
		annotation PBI_Description = "Media importo vendita N giorni, riferita al trimestre precedente"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast' = ```
			
			
			VAR first_year = VALUE(MIN(DIM_Calendario[YEAR]))
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            DIM_Calendario,
			            DIM_Calendario[Year],
			            DIM_Calendario[MonthName],
			            "qta_vendite_anno", [Qta Vendita]
			    	),
			    	VALUE(DIM_Calendario[Year]) >= first_year &&
				VALUE(DIM_Calendario[Year]) <= YEAR(TODAY())
			    	
			    )
			
			VAR media = 
			    AVERAGEX(
			        tab_dati,
			        [qta_vendite_anno]
			    )
			
			VAR forecast = media
			RETURN
			    forecast
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast quantità basato su medie storiche annuali"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Mediana' = ```
			
			
			VAR first_year = VALUE(MIN(DIM_Calendario[YEAR]))
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            DIM_Calendario,
			            DIM_Calendario[Year],
			            DIM_Calendario[MonthName],
			            "qta_vendite_anno", [Qta Vendita]
			    	),
			    	VALUE(DIM_Calendario[Year]) >= first_year &&
			    	VALUE(DIM_Calendario[Year]) <= YEAR(TODAY()) &&
			        [Qta Vendita] > 0
			    	
			    )
			
			VAR mediana = 
			    MEDIANX(
			        tab_dati,
			        [qta_vendite_anno]
			    )
			
			VAR forecast = mediana
			RETURN
			    forecast
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast quantità basato su mediana storica"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Netto Doc Vendita OLD' =
			
			DIVIDE ( [Importo Netto FILTER Doc Vendita], [Qta Doc Vendita Articolo], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		annotation PBI_Description = "Prezzo netto da documenti (versione precedente)"

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Costo Prodotto' = ```
			
			VAR cod_cliente =
			    SELECTEDVALUE ( DIM_Clienti[CodiceCliente] )
			VAR filtro_anno =
			    SELECTEDVALUE ( DIM_Calendario[Year] )
			VAR qta_cliente =
			    CALCULATE (
			        [Qta Doc Vendita Articolo],
			        'FACT_DocumentoVendita'[CodiceClienteFatturazione] = cod_cliente
			            && YEAR ( 'FACT_DocumentoVendita'[DataSpedizione] ) = VALUE ( filtro_anno )
			    )
			VAR costo_prod =
			    CALCULATE (
			        [COSTO GPL],
			        YEAR ( FACT_MovimentiCG[DataRegistrazione] ) = VALUE ( filtro_anno )
			    )
			VAR costo_cli =
			    DIVIDE ( [COSTO GPL], qta_cliente, 0 )
			RETURN
			    qta_cliente & "_" & [COSTO GPL]
			```
		annotation PBI_Description = "Calcolo del costo prodotto per cliente e anno"

	measure 'Costo Prodotto 2' =
			
			CALCULATE ( [Costo Prodotto], DIM_Clienti[CodiceCliente] = "C00033" )
		annotation PBI_Description = "Costo prodotto specifico per cliente C00033"

	measure '% Importo Margine Doc Vendita' =
			
			DIVIDE ( [Importo Margine Doc Vendita], [Importo Netto Doc Vendita], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Percentuale del margine sull'importo netto da documenti"

	measure 'Margine Ton Doc Vendita' =
			
			[Prezzo Netto Doc Vendita OLD] - [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Margine per tonnellata da documenti (Prezzo - CMP)"

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo Netto Doc Vendita' =
			
			DIVIDE ( [Importo Netto FILTER Doc Vendita], [Qta Doc Vendita FT], 0 )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Prezzo netto unitario da documenti"

		changedProperty = FormatString

	measure 'Prezzo Trasporto Doc Vendita' =
			
			CALCULATE (
			    AVERAGEX ( 'FACT_DocumentoVendita', 'FACT_DocumentoVendita'[CostoTrasporto] ),
			    'FACT_DocumentoVendita'[TipoRiga] = "Articolo"
			)
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Prezzo medio di trasporto da documenti"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Doc Vendita - Trasporto' =
			
			DIVIDE (
			    [Importo Doc Vendita - Trasporto],
			    [Qta Doc Vendita Gruppo Articolo],
			    0
			)
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Prezzo al netto del trasporto"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Vendita' = ```
			
			    CALCULATE(
			        DIVIDE([Importo Vendita],[Qta Vendita],0),
			        'FACT_DocumentoVendita'[CodiceCategoria] IN {"NAZ","UE","NAZPERM"}
			    )
			```
		displayFolder: KPI Vendite Documento
		annotation PBI_Description = "Prezzo vendita medio per categorie principali"

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Media 2' = ```
			AVERAGEX(DIM_Calendario,[Qta Vendita Forecast])
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Media del forecast quantità sull'intero calendario"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast NEW' = ```
			
			
			VAR CurYear = SELECTEDVALUE(DIM_Calendario[Year])
			VAR FirstYear = MIN(DIM_Calendario[Year])
			VAR LastYear = MAX(DIM_Calendario[Year])
			VAR No_of_years = CurYear - LastYear
			
			VAR qta_last_year = CALCULATE([Qta Vendita], DIM_Calendario[Year] = LastYear)
			VAR qta_first_year = CALCULATE([Qta Vendita], DIM_Calendario[Year] = FirstYear)
			
			VAR CAGR = POWER(
			                DIVIDE(qta_last_year,qta_first_year),
			                DIVIDE(1,LastYear - FirstYear)
			            ) - 1
			
			VAR forecast = qta_last_year * POWER((1 + CAGR), No_of_years)
			
			RETURN
			
			    IF(
			        CurYear > LastYear,
			        forecast
			    )
			
			```
		formatString: 0.00
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast quantità basato su CAGR (Compound Annual Growth Rate)"

		changedProperty = FormatString

	measure 'Qta Vendita Data Reg' = ```
			
			    CALCULATE(
			        [Qta Vendita],
			        USERELATIONSHIP(DIM_Calendario[Date],'FACT_DocumentoVendita'[DataRegistrazione])
			    )
			```
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta riferita alla Data Registrazione (relazione inattiva)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast 3Y' = DIVIDE([Qta Vendita LY] + [Qta Vendita 2LY] + [Qta Vendita 3LY], 3,0)
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast quantità basato sulla media degli ultimi 3 anni"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast 3Y CUM' =
			
			CALCULATE (
			    [Qta Vendita Forecast 3Y],
			    FILTER (
			        ALLSELECTED ( DIM_Calendario[Date] ),
			        DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			)
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast 3 anni cumulato"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita NEW' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			
			VAR qta_mix = CALCULATE(
			        SUMX('FACT_Vendite', 'FACT_Vendite'[Quantity]),
			        'FACT_Vendite'[CodiceArticolo] IN {"1","1T"}
			)
			
			VAR qta_propano = CALCULATE(
			        SUMX('FACT_Vendite', 'FACT_Vendite'[Quantity]),
			        'FACT_Vendite'[CodiceArticolo] IN {"1","1T"}
			)
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano
			    )
			
			```
		displayFolder: KPI Qta
		annotation PBI_Description = "Nuova misura quantità per test star schema"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Bar = MIN([Importo Vendita],[Importo Vendita Forecast])
		displayFolder: Target vs Actual CHART
		annotation PBI_Description = "Base per grafico Target vs Actual"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita Forecast' = ```
			
			
			VAR first_year = VALUE(MIN(DIM_Calendario[YEAR]))
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            DIM_Calendario,
			            DIM_Calendario[Year],
			            DIM_Calendario[MonthName],
			            "importo_vendite_anno", [Importo Vendita]
			    	),
			    	VALUE(DIM_Calendario[Year]) >= first_year &&
				VALUE(DIM_Calendario[Year]) <= YEAR(TODAY())
			    	
			    )
			
			VAR media = 
			    AVERAGEX(
			        tab_dati,
			        [importo_vendite_anno]
			    )
			
			VAR forecast = media
			RETURN
			    IF(
			        forecast <> BLANK(),
			        forecast,
			        0
			    )
			
			```
		displayFolder: KPI Forecast
		annotation PBI_Description = "Forecast importo vendita basato su medie storiche"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unmet Bar' =
			
			VAR Sales = [Importo Vendita]
			VAR Target = [Importo Vendita Forecast]
			RETURN
			    IF(
			        Target > Sales,
			        [Marker Value] - [Bar]
			    )
		displayFolder: Target vs Actual CHART
		annotation PBI_Description = "Quota mancante per raggiungere il target (grafico)"

	measure 'Met Bar' =
			
			VAR Sales = [Importo Vendita]
			VAR Target = [Importo Vendita Forecast]
			RETURN
			    IF(
			        Sales >= Target,
			        [Marker Value] - [Bar]
			    )
		displayFolder: Target vs Actual CHART
		annotation PBI_Description = "Quota raggiunta del target (grafico)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Marker Value' = MAX([Importo Vendita],[Importo Vendita Forecast])
		displayFolder: Target vs Actual CHART
		annotation PBI_Description = "Valore massimo tra vendita e target (per marker grafico)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita PREV' = SUM(LinestResult[Intercept]) + SUM(LinestResult[Slope1])*SUM('FACT_Vendite'[Date])
		displayFolder: KPI Forecast
		annotation PBI_Description = "Quantità prevista tramite LINEST"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita CONTINUA' = ```
			
			    IF(ISBLANK([Qta Vendita]),
			        [Qta Vendita AVG Month],
			        [Qta Vendita]
			    )
			```
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta continua (riempie i vuoti con la media)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita AVG Month' =
			
			AVERAGEX ( VALUES(DIM_Calendario[MonthnYear]), [Qta Vendita] )
		displayFolder: KPI Qta
		annotation PBI_Description = "Media mensile della quantità venduta"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Diff Actual/Previous' = [Value Previous] - SELECTEDMEASURE()
		annotation PBI_Description = "Differenza tra valore attuale e periodo precedente"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Prodotto' = ```
			
			
			 
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			
			VAR qta_propano = [Qta Vendita]
			VAR qta_mix = [Qta Doc Vendita IPEM]
			VAR qta_tot = qta_propano + qta_mix
			
			VAR qta = 
			    { 
			        SWITCH (
			            TRUE (),
			            filtro_gruppo = "PROPANO", qta_propano,
			            filtro_gruppo = "MIX", qta_mix,
			            qta_tot
			        )
			    }
			
			RETURN
			    qta
			```
		displayFolder: KPI Qta
		annotation PBI_Description = "Quantità venduta per prodotto con logica di switch"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition KPI_VenditeDocumento = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
				    #"Rimosse colonne"

	annotation PBI_ResultType = Table
