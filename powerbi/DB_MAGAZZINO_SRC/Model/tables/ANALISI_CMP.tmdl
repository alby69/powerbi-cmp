table ANALISI_CMP

	measure Qta_CMP = SUM(MAGAZZINO_CMP[Qta_BIL])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Costo_Medio_Acquisto_CMP = DIVIDE([Imp_Acquisto_CMP],[Qta_CMP])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Giacenza_Qta_CMP = ```
			CALCULATE(
			    MAX(Tab_Stock[Giacenza_Qta]),
			    LASTDATE(CALENDARIO[Date])
			)
			
			
			
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Giacenza_Valore_CMP = ```
			CALCULATE(
			    MAX(Tab_Stock[Giacenza_Imp]),
			    LASTDATE(CALENDARIO[Date])
			)
			
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CMP =
			
			DIVIDE(
			    [Giacenza_Valore_CMP],
			    [Giacenza_Qta_CMP]
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure COGS =
			
			SUM(Tab_Stock[Qta_Ven]) * [CMP]

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Giacenza_Qta_Periodo_CMP =
			
			SUM(Tab_Stock[Qta_Stock])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Giacenza_Valore_Periodo_CMP =
			
			SUM(Tab_Stock[Valore_Stock])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Importo_CMP = SUM(MAGAZZINO_CMP[Importo])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ANALISI_CMP = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
				    #"Rimosse colonne"

	annotation PBI_ResultType = Table

