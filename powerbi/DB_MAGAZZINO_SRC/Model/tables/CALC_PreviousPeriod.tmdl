table CALC_PreviousPeriod

	calculationGroup
		precedence: 2

		calculationItem Value = SELECTEDMEASURE()

		calculationItem 'Last DAY' =
				VAR NumOfInterval = SELECTEDVALUE(PARAM_TimeRange[PARAM_TimeRange], 1)
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( DIM_Calendario[Date], -NumOfInterval, DAY )
				)
				
				RETURN
				    Result

		calculationItem 'Last MONTH' =
				VAR NumOfInterval = SELECTEDVALUE(PARAM_TimeRange[PARAM_TimeRange], 1)
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( DIM_Calendario[Date], -NumOfInterval, MONTH )
				)
				
				RETURN
				    Result

		calculationItem 'Last QUARTER' =
				VAR NumOfInterval = SELECTEDVALUE(PARAM_TimeRange[PARAM_TimeRange], 1)
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( DIM_Calendario[Date], -NumOfInterval, QUARTER )
				)
				
				RETURN
				    Result

		calculationItem 'Last YEAR' =
				VAR NumOfInterval = SELECTEDVALUE(PARAM_TimeRange[PARAM_TimeRange], 1)
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( DIM_Calendario[Date], -NumOfInterval, YEAR )
				)
				
				RETURN
				    Result

		calculationItem 'Same Period Last Year' =
				CALCULATE (
				    SELECTEDMEASURE(),
				    SAMEPERIODLASTYEAR ( DIM_Calendario[Date] )
				)

	measure 'Value Previous' = SUMX('CALC_PreviousPeriod','CALC_PreviousPeriod'[PreviousPeriod])
		formatString: 0

	column PreviousPeriod
		dataType: string
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		isHidden
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic
