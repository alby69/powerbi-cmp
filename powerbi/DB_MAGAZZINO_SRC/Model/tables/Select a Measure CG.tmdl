table 'Select a Measure CG'

	calculationGroup
		precedence: 4

		calculationItem 'Qta Vendita' = [Qta Vendita]

		calculationItem 'Importo Vendita' = [Importo Vendita]

		calculationItem 'CMP Acquisto' = [CMP Acquisto]

		calculationItem 'Prezzo Vendita' = [Prezzo Vendita]

		calculationItem Margine = [Margine Unitario]

	column 'Select a Measure'
		dataType: string
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		isHidden
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

