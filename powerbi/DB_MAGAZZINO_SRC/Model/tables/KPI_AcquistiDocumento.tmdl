table KPI_AcquistiDocumento

	measure 'Importo Acquisti (Doc)' =
			
			SUMX ( 'FACT_DocumentoAcquisto', 'FACT_DocumentoAcquisto'[Importo] )
		displayFolder: KPI Acquisti Documento

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Materia Prima (Doc)' =
			
			CALCULATE (
			    [Importo Acquisti (Doc)],
			    'FACT_DocumentoAcquisto'[CodiceArticolo] = "4020002"
			)
		displayFolder: KPI Acquisti Documento

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisti (Doc)' =
			
			SUMX ( 'FACT_DocumentoAcquisto', 'FACT_DocumentoAcquisto'[Quantity] )
		displayFolder: KPI Acquisti Documento

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition KPI_AcquistiDocumento = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
				    #"Rimosse colonne"

	annotation PBI_ResultType = Table
