table ANALISI_MAGAZZINO

	measure 'Qta Ton' =
			
			VAR qta = SUMX ( MAGAZZINO, MAGAZZINO[Quantità] )
			
			RETURN
			    DIVIDE ( qta, 1000, 0 )
			/*
			    SWITCH(
			        [Unità Misura] ,
			        "KG", DIVIDE ( qta, 1000, 0 ),
			        "TON", qta,
			        0
			    )
			*/
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CUM ALL' =
			
			CALCULATE (
			    [Qta Ton],
			    FILTER ( ALL ( CALENDARIO ), CALENDARIO[Date] <= MAX ( CALENDARIO[Date] ) )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton YTD' =
			
			TOTALYTD ( [Qta Ton], CALENDARIO[Date] )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton LY' =
			
			CALCULATE ( [Qta Ton], DATEADD ( CALENDARIO[Date], -1, YEAR ) )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Diff YoY' =
			
			[Qta Ton] - [Qta Ton LY]
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisto' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			VAR filtro_articolo = { SELECTEDVALUE ( ARTICOLI[Codice Articolo], BLANK () ) }
			
			VAR qta_mix = [Qta RESA MIX] //[Qta BIL MIX]
			VAR qta_propano = SUMX('Tab PROPANO', 'Tab PROPANO'[Qta Ton IPEM] )
			
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano //IF(filtro_articolo IN {"1","1T"},qta_mix,qta_propano)
			    )
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Importo = ```
			
			CALCULATE(
			    SUMX(MOVCG,MOVCG[Importo]),
			    REMOVEFILTERS(MOVCG[Categoria])
			)
			
			/*
			Importo = 
			SUMX(MOVCG,MOVCG[Importo])
			*/
			
			
			```
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Fornitori' =
			
			CALCULATE ( [Importo], FILTER ( MOVCG, MOVCG[Conto] = "2030001" ) )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Acquisto CG' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER ( MOVCG, MOVCG[Conto] IN { "4020002" } )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

	measure 'Importo x Doc Date' =
			
			CALCULATE (
			    SUMX ( MOVCG, MOVCG[Importo] ),
			    USERELATIONSHIP ( CALENDARIO[Date], MOVCG[Data Documento] )
			)
		displayFolder: IMPORTO_MAG

	measure 'Importo Acquisto ALTRO' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER ( MOVCG, MOVCG[Conto] IN { "3100001" } && MOVCG[Progetto] = "PS01" )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Accantonamenti' =
			
			SUMX ( ACCANTONAMENTI, ACCANTONAMENTI[Importo] )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton CUM YTD' =
			
			[Qta Ton CUM YTD] * [Costo Acquisto Qta Ton]
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton' =
			
			[Qta Ton] * [Costo Acquisto Qta Ton]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Qta Ton YTD' =
			
			TOTALYTD ( [Importo Qta Ton], CALENDARIO[Date] )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton CUM YTD LY' =
			
			IF (
			    HASONEVALUE ( CALENDARIO[MonthName] ),
			    CALCULATE ( [Importo Qta Ton CUM YTD], DATEADD ( CALENDARIO[Date], -1, YEAR ) ),
			    BLANK ()
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton CY-LY' =
			
			ANALISI_MAGAZZINO[Importo Qta Ton CUM YTD] - ANALISI_MAGAZZINO[Importo Qta Ton CUM YTD LY]
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton Vendita' =
			
			[Qta Ton Vendita] * [Costo Acquisto Qta Ton]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Mag Progr' =
			
			VAR filtro_articolo =
			    { SELECTEDVALUE ( ARTICOLI[Codice Articolo] ) }
			VAR anno_inizio = 2021
			VAR tab_filtro =
			    FILTER (
			        ALL ( MAGAZZINO ),
			        MAGAZZINO[Deposito] = "IPEM"
			            && MAGAZZINO[Articolo]
			                IN filtro_articolo
			                    && MAGAZZINO[Data] >= DATE ( anno_inizio, 1, 1 )
			                    && MAGAZZINO[Data] <= MAX ( CALENDARIO[Date] )
			    )
			RETURN
			    CALCULATE ( [Importo], tab_filtro )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Mag Progr 2' =
			
			[CMP Acquisto Mag Progr] * [Qta Acquisto Progr]
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton Prev' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo] ) }
			VAR cur_date =
			    { SELECTEDVALUE ( CALENDARIO[Date] ) }
			VAR importo_iniziale =
			    SUMX (
			        FILTER (
			            GIACENZA,
			            GIACENZA[Data] = DATE ( 2021, 1, 1 )
			                && GIACENZA[Gruppo] = filtro_gruppo
			        ),
			        GIACENZA[Importo]
			    )
			VAR tab_filtro =
			    FILTER (
			        ALLSELECTED ( CALENDARIO ),
			        CALENDARIO[Date] < MAX ( CALENDARIO[Date] )
			    )
			RETURN
			    CALCULATE (
			        IF (
			            cur_date = DATE ( 2021, 1, 1 )
			                || ISBLANK ( [Qta Ton] ),
			            importo_iniziale,
			            [Qta Ton]
			        ),
			        tab_filtro
			    )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita CG' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER (
			        MOVCG,
			        MOVCG[Conto] IN { "3000002", "3000003", "3000004", "3000005" }
			    )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Passaggi CG' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER (
			        MOVCG,
			        MOVCG[Conto] IN { "3100001", "3100002", "3100003", "3100004", "3100005" }
			    )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Rimanenze Iniziali PROPANO CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( MOVCG, MOVCG[Conto] IN { "4010002" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Rimanenze Finali PROPANO CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( MOVCG, MOVCG[Conto] IN { "3300002" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo CMP' =
			
			[Importo Rimanenze Iniziali PROPANO CG] + [Importo Acquisto CG]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Inventario' = ([Qta Acquisto] + [Qta Ton CD Giacenza IPEM]) * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Rimanenze Finali MIX CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( MOVCG, MOVCG[Conto] IN { "3300003" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Rimanenze Iniziali MIX CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( MOVCG, MOVCG[Conto] IN { "4010003" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Acquisto IPEM CD' =
			
			CALCULATE (
			    [Qta Ton CD],
			    FILTER (
			        CONTO_DEPOSITO,
			        CONTO_DEPOSITO[Movimento] = "Acquisto"
			            && CONTO_DEPOSITO[Deposito] = "IPEM"
			    )
			)
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CD' =
			
			SUMX ( CONTO_DEPOSITO, CONTO_DEPOSITO[Quantità] )
		formatString: #,0.000
		displayFolder: QTA CONTO DEPOSITO

	measure 'Qta Ton Acquisto IPEM CD CUM ALL' =
			
			CALCULATE (
			    [Qta Ton Acquisto IPEM CD],
			    FILTER ( ALL ( CALENDARIO ), CALENDARIO[Date] <= MAX ( CALENDARIO[Date] ) )
			)
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CD CUM' = ```
			
			VAR InizioPeriodo =
			    CALCULATE(
			        MIN(CONTO_DEPOSITO[Data Competenza]),
			        ALLSELECTED(CONTO_DEPOSITO)
			    )
			VAR DataCorrente = MAX(CONTO_DEPOSITO[Data Competenza])
			VAR OrdineCorrente = MAX(CONTO_DEPOSITO)
			
			VAR UltimaGiacenzaPrecedente =
			MAXX(
			    FILTER(
			        ALL(CONTO_DEPOSITO),
			        CONTO_DEPOSITO[Movimento] = "Giacenza" &&
			        CONTO_DEPOSITO <= InizioPeriodo
			    ),
			    CONTO_DEPOSITO[Data Movimento]
			)
			
			VAR Tab_Filtro =
			FILTER(
			    ALLSELECTED(CONTO_DEPOSITO),
			    (
			        CONTO_DEPOSITO[Movimento] = "Giacenza" &&
			        CONTO_DEPOSITO[Data Movimento] = UltimaGiacenzaPrecedente
			    )
			    ||
			    (
			        CONTO_DEPOSITO[Movimento] <> "Giacenza" &&
			        CONTO_DEPOSITO[Data Movimento] >= InizioPeriodo &&
			        (
			            CONTO_DEPOSITO[Data Movimento] < DataCorrente
			            ||
			            (
			                CONTO_DEPOSITO[Data Movimento] = DataCorrente &&
			                CONTO_DEPOSITO[Ordine Movimento] <= OrdineCorrente
			            )
			        )
			    )
			)
			
			VAR Risultato = CALCULATE([Qta Ton CD], Tab_Filtro)
			
			RETURN
			IF(
			    HASONEVALUE(CONTO_DEPOSITO[Data Movimento]),
			    Risultato,
			    BLANK()
			)
			
			
			/* Qta Ton CD CUM Base = 
			VAR InizioPeriodo =
			    MIN ( CONTO_DEPOSITO[Data Movimento] )
			VAR DataCorrente =
			    MAX ( CONTO_DEPOSITO[Data Movimento] )
			VAR OrdineCorrente =
			    MAX ( CONTO_DEPOSITO[Ordine Movimento] )
			VAR UltimaGiacenzaPrecedente =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( CONTO_DEPOSITO ),
			            CONTO_DEPOSITO[Movimento] = "Giacenza"
			                && CONTO_DEPOSITO[Data Movimento] <= InizioPeriodo
			        ),
			        CONTO_DEPOSITO[Data Movimento]
			    )
			VAR Tab_Filtro =
			    FILTER (
			        ALLSELECTED ( CONTO_DEPOSITO ),
			        (
			            CONTO_DEPOSITO[Movimento] = "Giacenza"
			                && CONTO_DEPOSITO[Data Movimento] = UltimaGiacenzaPrecedente
			        )
			            ||
			        (
			            CONTO_DEPOSITO[Movimento] <> "Giacenza"
			                && CONTO_DEPOSITO[Data Movimento] >= InizioPeriodo
			                && (
			                    CONTO_DEPOSITO[Data Movimento] < DataCorrente
			                        || (
			                            CONTO_DEPOSITO[Data Movimento] = DataCorrente
			                                && CONTO_DEPOSITO[Ordine Movimento] <= OrdineCorrente
			                        )
			                )
			        )
			    )
			RETURN
			    CALCULATE ( [Qta Ton CD], Tab_Filtro )
			
			
			
			*/
			
			```
		displayFolder: QTA CONTO DEPOSITO

	measure 'Qta Ton Acquisto IPEM CD LY' =
			
			IF (
			    HASONEVALUE ( CALENDARIO[MonthName] ),
			    CALCULATE ( [Qta Ton Acquisto IPEM CD], DATEADD ( CALENDARIO[Date], -1, YEAR ) ),
			    BLANK ()
			)
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CD Giacenza IPEM' =
			
			CALCULATE (
			    [Qta Ton CD],
			    FILTER (
			        CONTO_DEPOSITO,
			        CONTO_DEPOSITO[Movimento] IN { "Giacenza" } &&
			        CONTO_DEPOSITO[Deposito] IN { "IPEM" }
			    )
			)
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valore Magazzino' =
			
			[Qta Ton CUM ALL] * [CMP Acquisto CUM]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

	measure 'Valore Magazzino 2' =
			
			[Qta Ton CUM ALL] * [CMP Prodotto CUM]

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rapporto Inventario' = DIVIDE([Importo Vendita N DAYS],[Importo Inventario],0)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Dare CG' = ```
			
			    CALCULATE(
			        SUMX ( MOVCG, MOVCG[Importo]),
			        MOVCG[Importo] > 0
			    )
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unità Misura' = MINX(MAGAZZINO,MAGAZZINO[Unità])

	measure 'Qta Ton CUM YTD' =
			
			CALCULATE (
			    [Qta Ton],
			    FILTER (
			        ALL ( CALENDARIO ),
			        CALENDARIO[Year] <= MAX ( CALENDARIO[Year] )
			            && CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			    )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza' = ```
			[Qta Giacenza Iniziale] + [Qta Acquisto] - [Qta Vendita]
			
			/*
			VAR DataInizio = DATE(2025,1,1)  // la tua data di riferimento
			VAR QtaIniziale = 5571.546             // <-- metti qui la quantità a quella data (in tonnellate)
			VAR QtaCumulata =
			    CALCULATE(
			        [Qta Ton],
			        FILTER(
			            ALL(CALENDARIO),
			            CALENDARIO[Date] > DataInizio &&
			            CALENDARIO[Date] <= MAX(CALENDARIO[Date])
			        )
			    )
			RETURN
			QtaIniziale + QtaCumulata
			*/
			
			/*
			Qta Ton Giacenza = 
			VAR DataInizio = DATE(2025,2,1)   // cambia qui la tua data di partenza
			RETURN
			IF(
			    ISBLANK([Qta Ton]),
			    BLANK(),
			    CALCULATE(
			        [Qta Ton],
			        FILTER(
			            ALL(CALENDARIO),
			            CALENDARIO[Date] >= DataInizio &&
			            CALENDARIO[Date] <= MAX(CALENDARIO[Date])
			        )
			    )
			)
			*/
			/*
			Qta Ton Giacenza = 
			IF(ISBLANK([Qta Ton]),
			    BLANK(),
			    CALCULATE (
			        [Qta Ton],
			        FILTER ( ALL ( CALENDARIO ), CALENDARIO[Date] <= MAX ( CALENDARIO[Date] ) )
			    )
			)
			*/
			
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza OLD' = ```
			
			    CALCULATE(
			        [Qta Ton CUM ALL],
			        REMOVEFILTERS(GRUPPI_VENDITE)
			    )
			/*
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			
			VAR qta_propano = [Qta Ton CD Giacenza IPEM]
			VAR qta_mix =  [Qta Ton CUM ALL]
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX",  qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), DIVIDE(qta_mix + qta_propano,2,0)
			    )
			*/        
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Prev' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo] ) }
			VAR cur_date =
			    { SELECTEDVALUE ( CALENDARIO[Date] ) }
			VAR qta_iniziale =
			    SUMX (
			        FILTER (
			            GIACENZA,
			            GIACENZA[Data] = DATE ( 2021, 1, 1 )
			                && GIACENZA[Gruppo] = filtro_gruppo
			        ),
			        GIACENZA[Qta]
			    )
			VAR tab_filtro =
			    FILTER (
			        ALLSELECTED ( CALENDARIO ),
			        CALENDARIO[Date] < MAX ( CALENDARIO[Date] )
			    )
			RETURN
			    CALCULATE (
			        IF (
			            cur_date = DATE ( 2021, 1, 1 )
			                || ISBLANK ( [Qta Ton] ),
			            qta_iniziale,
			            [Qta Ton]
			        ),
			        tab_filtro
			    )
		displayFolder: QTA

	measure 'Qta Ton Giacenza LM' =
			
			CALCULATE ( [Qta Ton Giacenza OLD], DATEADD ( CALENDARIO[Date], -1, MONTH ) )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza IPEM' = ```
			
			    CALCULATE(
			        [Qta Ton Giacenza OLD],
			        MAGAZZINO[Deposito] = "IPEM"
			    )
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CD x Mov' =
			
			VAR cur_mov = SELECTEDVALUE(CONTO_DEPOSITO[Movimento],0)
			
			RETURN
			    IF(cur_mov = "Vendita", [Qta Vendita Deposito], [Qta Ton CD])
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Deposito' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			VAR filtro_deposito = { SELECTEDVALUE ( CONTO_DEPOSITO_OLD[Deposito], BLANK () ) }
			VAR filtro_cliente = 
			    {
			    SWITCH (
			        TRUE (),
			        filtro_deposito = "IPEM", "",
			        filtro_deposito = "AUTOGASNORD", "C00525",
			        filtro_deposito = "BUTANGAS", "C00229",
			        filtro_deposito = "LIQUIGAS", "C00261",
			        filtro_deposito = "VERSALIS", "C00794"
			    ) }
			    
			VAR qta_mix = CALCULATE(
			        SUMX('Tab VENDITE', 'Tab VENDITE'[Qta]),
			        FILTER('Tab VENDITE','Tab VENDITE'[Codice Articolo] IN {"1","1T"} &&
			            IF( filtro_cliente <> "",'Tab VENDITE'[Soggetto] IN filtro_cliente, 
			                ('Tab VENDITE'[Categoria] <> "PASSAGGIO")
			            )
			        )
			)
			
			VAR qta_propano = CALCULATE(
			        SUMX('Tab VENDITE', 'Tab VENDITE'[Qta]),
			        FILTER('Tab VENDITE','Tab VENDITE'[Codice Articolo] IN {"2","2T"} &&
			            IF( filtro_cliente <> "",'Tab VENDITE'[Soggetto] IN filtro_cliente, 
			                ('Tab VENDITE'[Categoria] <> "PASSAGGIO")
			            )
			        )
			)
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano
			    )
			
			```
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza 2' = ```
			
			VAR prodotto = SELECTEDVALUE(ARTICOLI[Gruppo Articolo])
			VAR start_date = DATE(2024,1,1)
			
			VAR giacenza_prop = 4901
			VAR giacenza_mix = 219.520
			VAR giacenza = IF(prodotto = "PROPANO",giacenza_prop,giacenza_mix)
			
			VAR qta_acquisto_prop = TOTALYTD ( [Qta Acquisto], CALENDARIO[Date] )
			VAR qta_acquisto_mix = TOTALYTD ( [Qta Acquisto], CALENDARIO[Date] )
			VAR qta_acquisto_tot = qta_acquisto_prop + qta_acquisto_mix
			
			VAR qta_vendita_propano = TOTALYTD ( [Qta Vendita], CALENDARIO[Date] )
			VAR qta_vendita_mix = TOTALYTD ( [Qta Vendita Prodotto], CALENDARIO[Date] )
			VAR qta_vendita_tot = qta_vendita_propano + qta_vendita_mix
			
			VAR qta_vendita = 
			    { 
			        SWITCH (
			            TRUE (),
			            prodotto = "PROPANO", qta_vendita_propano,
			            prodotto = "MIX", qta_vendita_mix,
			            qta_vendita_tot
			        )
			    }
			
			
			VAR qta_acquisto = 
			    { 
			        SWITCH (
			            TRUE (),
			            prodotto = "PROPANO", qta_acquisto_prop,
			            prodotto = "MIX", qta_acquisto_mix,
			            qta_acquisto_tot
			        )
			    }
			
			
			RETURN
			
			    IF(
			        AND(MIN(CALENDARIO[Date]) = start_date, MAX(CALENDARIO[Date]) = DATE(2024,1,31)),
			        giacenza, // + start_qta,
			        giacenza + qta_acquisto - qta_vendita
			    )
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Vendita MAG' =
			CALCULATE(
			    [Qta Ton],
			    MAGAZZINO[Movimento] = "Vendita"
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisto CUM' =
			
			IF (
			    ISBLANK ( [Qta Acquisto] ),
			    BLANK (),
			    CALCULATE (
			        [Qta Acquisto],
			        FILTER (
			            ALLSELECTED ( CALENDARIO[Date] ),
			            CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			        )
			    )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Acquisto' =
			
			// non funziona perchè in magazzino IPEM la navi sono inserite come totale e non spaccato per ubicazione
			    CALCULATE(
			        [Qta Ton],
			        FILTER(MAGAZZINO,MAGAZZINO[Movimento] IN {"Acquisto","Rettifica Positiva"})
			    )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mostra Giacenza No Movimenti' = ```
			
			VAR HaQuantita = NOT(ISBLANK([Qta Ton CD]))
			VAR InizioAnno = DATE(YEAR(MAX(CONTO_DEPOSITO[Data Competenza])), 1, 1)
			VAR IsGiacenzaIniziale = 
			    MAX(CONTO_DEPOSITO[Movimento]) = "Giacenza" 
			    && MAX(CONTO_DEPOSITO[Data Movimento]) <= InizioAnno
			VAR IsAltroMovimento = MAX(CONTO_DEPOSITO[Movimento]) <> "Giacenza"
			RETURN
			IF(
			    HaQuantita && (IsGiacenzaIniziale || IsAltroMovimento),
			    1,
			    BLANK()
			)
			```
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FiltroAttivo = ```
			
			VAR filtroGruppo = ISFILTERED(GRUPPI_VENDITE[Gruppo])
			VAR filtroCat = ISFILTERED(MOVCG[Categoria])
			RETURN
			"Gruppo: " & IF(filtroGruppo, "✅", "❌") & 
			" | Categoria: " & IF(filtroCat, "✅", "❌")
			
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Giacenza Iniziale' = [Qta Ton CD Giacenza IPEM]
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ANALISI_MAGAZZINO-3b02172a-ba09-403e-b211-9e256f29e098 = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
