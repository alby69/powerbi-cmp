table CALC_ToDate

	calculationGroup
		precedence: 1

		calculationItem Value = SELECTEDMEASURE()

		calculationItem MTD = TOTALMTD (SELECTEDMEASURE(), DIM_Calendario[Date] )

		calculationItem QTD = TOTALQTD (SELECTEDMEASURE(), DIM_Calendario[Date] )

		calculationItem YTD = TOTALYTD (SELECTEDMEASURE(), DIM_Calendario[Date] )

	column DIM
		dataType: string
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

