table LocalDateTable_5fdf6b65-ed73-4edd-bab3-05204d992959
	isHidden
	showAsVariationsOnly

	column Date
		isHidden
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	column Anno = YEAR([Date])
		isHidden
		dataCategory: Years
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Year

	column NumMese = MONTH([Date])
		isHidden
		dataCategory: MonthOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = MonthNumber

	column Mese = FORMAT([Date], "MMMM")
		isHidden
		dataCategory: Months
		summarizeBy: none
		sortByColumn: NumMese

		annotation SummarizationSetBy = User

		annotation TemplateId = Month

	column NumTrimestre = INT(([NumMese] + 2) / 3)
		isHidden
		dataCategory: QuarterOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = QuarterNumber

	column Trimestre = "Trim " & [NumTrimestre]
		isHidden
		dataCategory: Quarters
		summarizeBy: none
		sortByColumn: NumTrimestre

		annotation SummarizationSetBy = User

		annotation TemplateId = Quarter

	column Giorno = DAY([Date])
		isHidden
		dataCategory: DayOfMonth
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Day

	hierarchy 'Gerarchia data'

		level Anno
			column: Anno

		level Trimestre
			column: Trimestre

		level Mese
			column: Mese

		level Giorno
			column: Giorno

		annotation TemplateId = DateHierarchy

	partition LocalDateTable_5fdf6b65-ed73-4edd-bab3-05204d992959-f99ec74e-b119-48e7-ac5a-e6bccaac6cc4 = calculated
		mode: import
		source = Calendar(Date(Year(MIN('CALENDARIO'[Date])), 1, 1), Date(Year(MAX('CALENDARIO'[Date])), 12, 31))

	annotation __PBI_LocalDateTable = true

