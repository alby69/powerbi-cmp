	column GruppoProdotto = ```
			
			    SWITCH( TRUE(),
			        DIM_Articoli[CodiceArticolo] IN {"1","1T"},"MIX",
			        DIM_Articoli[CodiceArticolo] IN {"2","2T"},"PROPANO",
			        DIM_Articoli[CodiceArticolo] IN {"2M","2MT"},"BLEND",
			        DIM_Articoli[CodiceArticolo] IN {"3","3T"},"BUTANO",
			        DIM_Articoli[CodiceArticolo] IN {"D"},"DENAT",
			        BLANK()
			    )
			```
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CodiceArticolo
