			    { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo] ) }
			
			VAR qta_propano = [Qta Vendita]
			VAR qta_mix = [Qta Doc Vendita IPEM]
			VAR qta_tot = qta_propano + qta_mix
			
			VAR qta = 
			    { 
			        SWITCH (
			            TRUE (),
			            filtro_gruppo = "PROPANO", qta_propano,
			            filtro_gruppo = "MIX", qta_mix,
			            qta_tot
