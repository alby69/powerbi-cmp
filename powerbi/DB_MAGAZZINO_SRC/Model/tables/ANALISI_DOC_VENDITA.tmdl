	measure 'Unmet Bar' =
			
			VAR Sales = [Importo Vendita]
			VAR Target = [Importo Vendita Forecast]
			RETURN
			    IF(
			        Target > Sales,
			        [Marker Value] - [Bar]
			    )
		displayFolder: Target vs Actual CHART

	measure 'Met Bar' =
			
			VAR Sales = [Importo Vendita]
			VAR Target = [Importo Vendita Forecast]
			RETURN
			    IF(
			        Sales >= Target,
			        [Marker Value] - [Bar]
			    )
		displayFolder: Target vs Actual CHART

