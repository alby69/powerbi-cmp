table ANALISI_DOC_VENDITA

	measure 'Importo Doc Vendita' =
			
			SUMX ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Importo] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO

		changedProperty = FormatString

	measure 'Importo Articolo Doc Vendita' =
			
			CALCULATE (
			    ANALISI_DOC_VENDITA[Importo Doc Vendita],
			    FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Tipo Riga] = "Articolo" )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo FT Doc Vendita' =
			
			CALCULATE (
			    ANALISI_DOC_VENDITA[Importo Doc Vendita],
			    FILTER (
			        'DOCUMENTO VENDITA',
			        'DOCUMENTO VENDITA'[Tipo Riga] = "Articolo"
			            && 'DOCUMENTO VENDITA'[Tipo Documento] = "FT VENDITA"
			    )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo NC Doc Vendita' =
			
			CALCULATE (
			    ANALISI_DOC_VENDITA[Importo Doc Vendita],
			    FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Tipo Documento] = "NC VENDITA" )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita' =
			
			ANALISI_DOC_VENDITA[Importo FT Doc Vendita] - ANALISI_DOC_VENDITA[Importo Trasporto Doc Vendita] - ANALISI_DOC_VENDITA[Importo NC Doc Vendita]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Costo Prodotto Doc Vendita' =
			
			[Costo Prodotto Mov_Val] * [Qta Doc Vendita Articolo]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Margine Doc Vendita' =
			
			[Margine Ton Doc Vendita] * [Qta Doc Vendita Articolo]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo FT PASSAGGIO Doc Vendita' =
			
			CALCULATE (
			    ANALISI_DOC_VENDITA[Importo Doc Vendita],
			    REMOVEFILTERS ( ARTICOLI ),
			    'DOCUMENTO VENDITA'[Tipo Riga] = "Conto",
			    'DOCUMENTO VENDITA'[Tipo Documento] = "FT VENDITA"
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo NC PASSAGGIO Doc Vendita' =
			
			CALCULATE (
			    ANALISI_DOC_VENDITA[Importo Doc Vendita],
			    FILTER (
			        'DOCUMENTO VENDITA',
			        'DOCUMENTO VENDITA'[Tipo Riga] = "Conto"
			            && 'DOCUMENTO VENDITA'[Tipo Documento] = "NC VENDITA"
			    )
			)
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto PASSAGGIO Doc Vendita' =
			
			ANALISI_DOC_VENDITA[Importo FT PASSAGGIO Doc Vendita] - ANALISI_DOC_VENDITA[Importo NC PASSAGGIO Doc Vendita]
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto FILTER Doc Vendita' =
			
			IF (
			    SELECTEDVALUE ( GRUPPI_VENDITE[Gruppo] ) = "PASSAGGIO",
			    ANALISI_DOC_VENDITA[Importo Netto PASSAGGIO Doc Vendita],
			    ANALISI_DOC_VENDITA[Importo Netto Doc Vendita]
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Controllo (Doc - CG)' =
			
			ANALISI_VENDITE[Importo Vendite] - ANALISI_VENDITE[Importo Vendite CG]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Trasporto Doc Vendita' =
			
			SUMX ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Costo Trasporto] )
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Doc Vendita - Trasporto' =
			
			ANALISI_DOC_VENDITA[Importo Doc Vendita] - ANALISI_DOC_VENDITA[Importo Trasporto Doc Vendita]
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita' = ```
			[Importo Netto Doc Vendita]   //[Qta Vendita] * [Prezzo Vendite]
			/*
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo] ) }
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "PROPANO", [Importo Netto Doc Vendita],
			        filtro_gruppo = "MIX", [Importo Doc Vendita - Trasporto],
			        filtro_gruppo = BLANK (), [Importo Doc Vendita - Trasporto]
			    )
			*/    
			```
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Acquisto Cliente' = [Qta Vendita] * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO

		changedProperty = FormatString

	measure 'Importo Vendita %' =
			
			VAR vendite_cliente = [Importo Vendita]
			VAR tot_vendite =
			    CALCULATE (
			        [Importo Vendita],
			        REMOVEFILTERS ( CLIENTI[Nome] )
			    )
			RETURN
			    DIVIDE ( vendite_cliente, tot_vendite, 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: IMPORTO

		changedProperty = FormatString

	measure 'Importo Vendita % LQ' =
			
			CALCULATE ( [Importo Vendita %], DATEADD ( CALENDARIO[Date], -1, QUARTER ) )
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita N DAYS' = ```
			
			VAR NrOfDays = 90
			VAR ris = 
			    CALCULATE(
			        [Importo Vendita],
			        DATEADD(CALENDARIO[Date],-NrOfDays,DAY)
			    )
			RETURN
			    ris
			```
		displayFolder: IMPORTO

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita IPEM N DAYS' = ```
			
			VAR NrOfDays = 90
			VAR importo_vendita_IPEM = 
			    CALCULATE(
			        [Importo Vendita],
			        //FILTER(UBICAZIONE,UBICAZIONE[Code]= "IPEM")
			        FILTER('DOCUMENTO VENDITA','DOCUMENTO VENDITA'[Ubicazione] = "IPEM")
			    )
			
			VAR ris = 
			    CALCULATE(
			        importo_vendita_IPEM,
			        DATEADD(CALENDARIO[Date], -NrOfDays, DAY)
			    )
			RETURN
			    ris
			```
		displayFolder: IMPORTO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita Articolo' =
			
			CALCULATE (
			    [Qta Doc Vendita],
			    FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Tipo Riga] = "Articolo" )
			)
		formatString: #,0.00
		displayFolder: QTA

	measure 'Qta Doc Vendita Cliente' =
			
			CALCULATE (
			    [Qta Doc Vendita Articolo],
			    FILTER ( CLIENTI, CLIENTI[Codice Cliente] = SELECTEDVALUE ( CLIENTI[Codice Cliente] ) )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita' =
			
			SUMX ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Quantity] )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita IPEM' =
			
			CALCULATE (
			    [Qta Doc Vendita Articolo],
			    FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Ubicazione] = "IPEM" )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita FT' =
			
			CALCULATE (
			    [Qta Doc Vendita Articolo],
			    FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Tipo Documento] = "FT VENDITA" )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita NC' =
			
			CALCULATE (
			    [Qta Doc Vendita],
			    FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Tipo Documento] = "NC VENDITA" )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita Netta' =
			
			[Qta Doc Vendita FT] - [Qta Doc Vendita NC]
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita YTD' =
			
			TOTALYTD ( [Qta Doc Vendita Articolo], CALENDARIO[Date] )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita Gruppo Articolo' =
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo] ) }
			RETURN
			    IF(filtro_gruppo <> BLANK(),
			        CALCULATE (
			            [Qta Doc Vendita],
			            FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Gen_ Prod_ Posting Group] = filtro_gruppo )
			        ),
			        0
			    )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita' = ```
			[Qta Doc Vendita Netta]
			
			 /*
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo] ) }
			
			VAR qta_propano = [Qta Doc Vendita FT] + [Qta Doc Vendita 3000002]
			VAR qta_mix = [Qta Doc Vendita Articolo] //[Qta Doc Vendita Gruppo Articolo]
			VAR qta_tot = qta_propano + qta_mix
			
			VAR qta = 
			    { 
			        SWITCH (
			            TRUE (),
			            filtro_gruppo = "PROPANO", qta_propano,
			            filtro_gruppo = "MIX", qta_mix,
			            qta_tot
			        )
			    }
			
			RETURN
			    qta
			*/
			
			/*
			    IF(
			        ISINSCOPE(ARTICOLI[Gruppo Articolo]),
			        qta,
			        qta_tot
			    )
			*/
			```
		formatString: #,0.00
		displayFolder: QTA

		changedProperty = FormatString

	measure 'Qta Vendita LY' =
			
			CALCULATE ( [Qta Vendita], DATEADD ( CALENDARIO[Date], -1, YEAR ) )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita 2LY' =
			
			CALCULATE ( [Qta Vendita], DATEADD ( CALENDARIO[Date], -2, YEAR ) )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita 3LY' =
			
			CALCULATE ( [Qta Vendita], DATEADD ( CALENDARIO[Date], -3, YEAR ) )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita CUM' =
			
			IF (
			    ISBLANK ( [Qta Vendita] ),
			    BLANK (),
			    CALCULATE (
			        [Qta Vendita],
			        FILTER (
			            ALLSELECTED ( CALENDARIO[Date] ),
			            CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			        )
			    )
			)
		formatString: #,0.00
		displayFolder: QTA

		changedProperty = FormatString

	measure 'Qta Vendita Mediana' =
			
			MEDIANX ( CALENDARIO, [Qta Vendita] )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita AVG Day' =
			
			AVERAGEX ( VALUES(CALENDARIO[Date]), [Qta Vendita] )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita AVG N Days' =
			
			VAR nr_days = 28
			VAR Period =
			    DATESINPERIOD (
			        'DOCUMENTO VENDITA'[Data Registrazione],
			        LASTDATE ( 'DOCUMENTO VENDITA'[Data Registrazione] ),
			        - nr_days,
			        DAY
			    )
			VAR sum_sales =
			    CALCULATE ( [Qta Vendita], Period )
			VAR nr_sales =
			    CALCULATE ( DISTINCTCOUNT ('DOCUMENTO VENDITA'[Data Registrazione] ), Period )
			RETURN
			    DIVIDE ( sum_sales, nr_sales, 0 )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita R12' =
			
			VAR NumOfMonths = 12
			VAR LastSelectedDay =
			    MAX ( CALENDARIO[Date] )
			VAR Period =
			    DATESINPERIOD ( CALENDARIO[Date], LastSelectedDay, - NumOfMonths, MONTH )
			VAR Result =
			    CALCULATE (
			        AVERAGEX ( VALUES ( CALENDARIO[MonthInCalendar] ), [Qta Vendita] ),
			        Period
			    )
			VAR LastDateWithSale =
			    MAX ( 'DOCUMENTO VENDITA'[Data Registrazione] ) // Trova ultimo giorno di vendita
			VAR FirstVisibleDate =
			    MIN ( CALENDARIO[Date] ) // Trova la prima data visibile
			RETURN
			    IF ( FirstVisibleDate <= LastDateWithSale, Result )
			// controlla che la data sia nel range delle vendite
		displayFolder: QTA

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita ALL' =
			
			SUMX ( ALL ( 'DOCUMENTO VENDITA' ), [Qta Vendita] )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Doc Vendita 3000002' = ```
			
			CALCULATE (
			    [Qta Doc Vendita],
			    FILTER ( 'DOCUMENTO VENDITA', 
			        'DOCUMENTO VENDITA'[No_] = "3000002" &&
			        'DOCUMENTO VENDITA'[Tipo Documento] = "FT VENDITA"
			    )
			)
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita YTD' =
			
			TOTALYTD ( [Qta Vendita], CALENDARIO[Date] )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita AVG YTD Monthly' = ```
			
			
			    CALCULATE(
			        [Qta Vendita AVG Day],
			        FILTER(
			            ALL(CALENDARIO),
			            CALENDARIO[MonthInCalendar] <= MAX(CALENDARIO[MonthInCalendar]) &&
			            CALENDARIO[Year] = MAX(CALENDARIO[Year])
			        )
			    )
			```
		formatString: #,0.00
		displayFolder: QTA

		changedProperty = FormatString

	measure 'Qta Vendita IPEM' = ```
			
			    CALCULATE(
			        [Qta Vendita],
			        'DOCUMENTO VENDITA'[Ubicazione] = "IPEM"
			    )
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Media Pesata' = ```
			
			VAR qta_vendita_anno = 
			    CALCULATE(
			        [Qta Vendita],
			        ALL(CALENDARIO[MonthName],CALENDARIO[MonthOfYear])
			    )
			VAR tab_mese =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'DOCUMENTO VENDITA',
			            CALENDARIO[Year],
			            CALENDARIO[MonthName]
			        ),
			        "Qta Mese", [Qta Vendita],
			        "Peso", DIVIDE([Qta Vendita],qta_vendita_anno,0)
			    )
			RETURN
			    SUMX(
			        tab_mese,
			        [Peso] * [Qta Mese]
			    )
			```
		formatString: #,0.00
		displayFolder: QTA

		changedProperty = FormatString

	measure 'Qta Vendita Cliente CUM' =
			
			VAR cliente_rank =
			    RANKX(
			        ALL(CLIENTI[Nome & Codice]),
			        [Qta Vendita],,
			        DESC,
			        Dense
			    )
			VAR RunningTotal =
			    CALCULATE(
			        [Qta Vendita],
			        FILTER(
			            ALL(CLIENTI[Nome & Codice]),
			            cliente_rank >= RANKX(
			                                ALL(CLIENTI[Nome & Codice]),
			                                [Qta Vendita],,
			                                DESC,
			                                Dense
			                            )
			        )
			    )
			RETURN
			    IF(
			        [Qta Vendita]<> BLANK(),
			        RunningTotal
			    )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita CUM' =
			
			CALCULATE (
			    [Importo Netto Doc Vendita],
			    FILTER (
			        ALLSELECTED ( CALENDARIO ),
			        CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			    )
			)
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita LM' =
			
			CALCULATE (
			    [Importo Netto Filter Doc Vendita],
			    DATEADD ( CALENDARIO[Date], -1, MONTH )
			)
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita LM CUM' =
			
			CALCULATE (
			    [Importo Netto Doc Vendita LM],
			    FILTER (
			        ALLSELECTED ( CALENDARIO ),
			        CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			    )
			)
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita -2M' =
			
			CALCULATE (
			    [Importo Netto Filter Doc Vendita],
			    DATEADD ( CALENDARIO[Date], -2, MONTH )
			)
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita -2M CUM' =
			
			CALCULATE (
			    [Importo Netto Doc Vendita -2M],
			    FILTER (
			        ALLSELECTED ( CALENDARIO ),
			        CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			    )
			)
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Netto Doc Vendita LY' =
			
			IF (
			    HASONEVALUE ( CALENDARIO[Date] ),
			    CALCULATE (
			        [Importo Netto Filter Doc Vendita],
			        DATEADD ( CALENDARIO[Date], -1, YEAR )
			    ),
			    BLANK ()
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: TIME

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Vendite CY-LY' =
			
			ANALISI_DOC_VENDITA[Importo Netto Filter Doc Vendita] - ANALISI_DOC_VENDITA[Importo Netto Doc Vendita LY]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: TIME

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Vendita LY' =
			
			CALCULATE ( [Importo Vendita], DATEADD ( CALENDARIO[Date], -1, YEAR ) )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: TIME

		changedProperty = FormatString

	measure 'Importo Vendita LQ' =
			
			CALCULATE ( [Importo Vendita], DATEADD ( CALENDARIO[Date], -1, QUARTER ) )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast CUM' = ```
			
			SUMX(
			    FILTER (
			        ALLSELECTED ( CALENDARIO[Date] ),
			        CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			    ),
			    [Qta Vendita Forecast]
			    
			)
			/*
			CALCULATE (
			    [Qta Vendita Forecast],
			    FILTER (
			        ALLSELECTED ( CALENDARIO[Date] ),
			        CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			    )
			)
			*/
			```
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast MA 30D' =
			
			VAR day_week =
			    SELECTEDVALUE ( CALENDARIO[DayOfWeekName] )
			VAR weekend =
			    IF ( day_week IN { "sabato", "domenica" }, TRUE (), FALSE () )
			RETURN
			    IF( ISBLANK([Qta Vendita]) && weekend = FALSE(),
			        AVERAGEX (
			            DATESINPERIOD ( CALENDARIO[Date], LASTDATE ( CALENDARIO[Date] ), -30, DAY ),
			            [Qta Vendita]
			        ),
			        BLANK ()
			    )
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast TOT' =
			
			IF (
			    ISBLANK ( [Qta Vendita] ),
			    CALCULATE (
			        [Qta Vendita Forecast MA 30D],
			        SAMEPERIODLASTYEAR ( CALENDARIO[Date] )
			    ),
			    BLANK ()
			)
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Remain' =
			
			VAR LastDateWithSales =
			    CALCULATE ( MAX ( 'DOCUMENTO VENDITA'[Data Spedizione] ), REMOVEFILTERS () )
			VAR ForecastRemain =
			    CALCULATE (
			        [Qta Vendita Forecast],
			        KEEPFILTERS ( CALENDARIO[Date] >= LastDateWithSales )
			    )
			RETURN
			    ForecastRemain
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita & Forecast' =
			
			[Qta Vendita] + [Qta Vendita Forecast Remain]
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita CUM vs Forecast CUM' =
			
			IF (
			    ISBLANK ( [Qta Vendita CUM] ),
			    BLANK (),
			    [Qta Vendita CUM] - [Qta Vendita Forecast CUM]
			)
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Remain CUM' =
			
			CALCULATE (
			    [Qta Vendita Forecast Remain],
			    FILTER (
			        ALLSELECTED ( CALENDARIO[Date] ),
			        CALENDARIO[Date] <= MAX ( CALENDARIO[Date] )
			    )
			)
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Remain Mediana' =
			
			MEDIANX ( CALENDARIO, [Qta Vendita Forecast Remain] )
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression Line' =
			
			VAR data =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( CALENDARIO ),
			            "x_values", CALENDARIO[Date],
			            "y_values", [Qta Vendita CUM]
			        ),
			        AND ( NOT ( ISBLANK ( [x_values] ) ), NOT ( ISBLANK ( [y_values] ) ) )
			    )
			VAR y_sum =
			    SUMX ( data, [y_values] )
			VAR x_sum =
			    SUMX ( data, [x_values] )
			VAR x2 =
			    SUMX ( data, [x_values] ^ 2 )
			VAR xy =
			    SUMX ( data, [x_values] * [y_values] )
			VAR row_count =
			    COUNTROWS ( data ) -- Formula regressione lineare
			VAR Intercept =
			    DIVIDE ( ( y_sum * x2 - x_sum * xy ), ( row_count * x2 - ( x_sum ) ^ 2 ), 0 )
			VAR Slope =
			    DIVIDE (
			        ( row_count * xy - x_sum * y_sum ),
			        ( row_count * x2 - ( x_sum ) ^ 2 ),
			        0
			    )
			VAR Regression =
			    SUMX ( CALENDARIO, Slope * CALENDARIO[Date] + Intercept )
			RETURN
			    Regression
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Regression Slope' =
			
			VAR data =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( CALENDARIO ),
			            "x_values", CALENDARIO[Date],
			            "y_values", [Qta Vendita CUM]
			        ),
			        AND ( NOT ( ISBLANK ( [x_values] ) ), NOT ( ISBLANK ( [y_values] ) ) )
			    )
			VAR y_sum =
			    SUMX ( data, [y_values] )
			VAR x_sum =
			    SUMX ( data, [x_values] )
			VAR x2 =
			    SUMX ( data, [x_values] ^ 2 )
			VAR xy =
			    SUMX ( data, [x_values] * [y_values] )
			VAR row_count =
			    COUNTROWS ( data ) -- Formula regressione lineare
			VAR Slope = ( row_count * xy - x_sum * y_sum ) / ( row_count * x2 - ( x_sum ) ^ 2 )
			RETURN
			    Slope
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita ToDo' =
			
			VAR diff = [Valore Obiettivo Vendite] - [Qta Vendita ALL]
			RETURN
			    IF(diff >= 0, diff,0)
		formatString: #,0
		displayFolder: FORECAST

		changedProperty = FormatString

	measure 'Giorni Vendita x Obiettivo' = ```
			
			
			VAR div = DIVIDE ( [Qta Vendita ToDo], [Regression Slope], 0 )
			RETURN
			    IF( div >= 0, div, 0 ) 
			
			```
		formatString: 0
		displayFolder: FORECAST

		changedProperty = FormatString

	measure 'Data Obiettivo Vendita' =
			
			DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), DAY ( TODAY () ) + [Giorni Vendita x Obiettivo] )
		formatString: Short Date
		displayFolder: FORECAST

		changedProperty = FormatString

	measure 'Importo Vendita AVG N Days' =
			
			VAR nr_days = 28
			VAR Period =
			    DATESINPERIOD (
			        'DOCUMENTO VENDITA'[Data Registrazione],
			        LASTDATE ( 'DOCUMENTO VENDITA'[Data Registrazione] ),
			        - nr_days,
			        DAY
			    )
			VAR sum_sales =
			    CALCULATE ( [Importo Vendita], Period )
			VAR nr_sales =
			    CALCULATE ( DISTINCTCOUNT ( 'DOCUMENTO VENDITA'[Data Registrazione] ), Period )
			RETURN
			    DIVIDE ( sum_sales, nr_sales, 0 )
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita AVG N Days LQ' =
			
			CALCULATE (
			    [Importo Vendita AVG N Days],
			    DATEADD ( 'DOCUMENTO VENDITA'[Data Registrazione], -1, QUARTER )
			)
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast' = ```
			
			
			VAR first_year = VALUE(MIN(CALENDARIO[YEAR]))
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            CALENDARIO,
			            CALENDARIO[Year],
			            CALENDARIO[MonthName],
			            "qta_vendite_anno", [Qta Vendita]
			    	),
			    	VALUE(CALENDARIO[Year]) >= first_year &&
			    	VALUE(CALENDARIO[Year]) <= YEAR(TODAY()) //&&
			        //[Qta Vendita] > 0
			    	
			    )
			
			VAR media = 
			    AVERAGEX(
			        tab_dati,
			        [qta_vendite_anno]
			    )
			
			VAR forecast = media
			RETURN
			    forecast
			/*
			    IF(
			        ISBLANK([Qta Vendita]),
			        forecast,
			        BLANK()
			    )
			*/
			```
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Mediana' = ```
			
			
			VAR first_year = VALUE(MIN(CALENDARIO[YEAR]))
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            CALENDARIO,
			            CALENDARIO[Year],
			            CALENDARIO[MonthName],
			            "qta_vendite_anno", [Qta Vendita]
			    	),
			    	VALUE(CALENDARIO[Year]) >= first_year &&
			    	VALUE(CALENDARIO[Year]) <= YEAR(TODAY()) &&
			        [Qta Vendita] > 0
			    	
			    )
			
			VAR mediana = 
			    MEDIANX(
			        tab_dati,
			        [qta_vendite_anno]
			    )
			
			VAR forecast = mediana
			RETURN
			    forecast
			```
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Netto Doc Vendita OLD' =
			
			DIVIDE ( [Importo Netto Filter Doc Vendita], [Qta Doc Vendita Articolo], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Costo Prodotto' =
			
			VAR cod_cliente =
			    SELECTEDVALUE ( CLIENTI[Codice Cliente] )
			VAR filtro_anno =
			    SELECTEDVALUE ( CALENDARIO[Year] )
			VAR qta_cliente =
			    CALCULATE (
			        [Qta Doc Vendita Articolo],
			        FILTER (
			            'DOCUMENTO VENDITA',
			            'DOCUMENTO VENDITA'[Codice Cliente Fatturazione]
			                IN { cod_cliente }
			                    && YEAR ( 'DOCUMENTO VENDITA'[Data Spedizione] ) IN { VALUE ( filtro_anno ) }
			        )
			    )
			VAR costo_prod =
			    CALCULATE (
			        [COSTO GPL],
			        FILTER ( MOVCG, YEAR ( MOVCG[Data Registrazione] ) IN { VALUE ( filtro_anno ) } )
			    )
			VAR costo_cli =
			    DIVIDE ( [COSTO GPL], qta_cliente, 0 )
			RETURN
			    //cod_cliente & "_" & filtro_anno & "_" & qta_cliente & "_" & costo_prod & "_" & costo_cli
			    qta_cliente & "_" & [COSTO GPL]
			//DIVIDE([COSTO GPL],[Qta Doc Vendita],0)

	measure 'Costo Prodotto 2' =
			
			CALCULATE ( [Costo Prodotto], CLIENTI[Codice Cliente] = "C00033" )

	measure '% Importo Margine Doc Vendita' =
			
			DIVIDE ( [Importo Margine Doc Vendita], [Importo Netto Doc Vendita], 0 )
		formatString: 0.00%;-0.00%;0.00%

	measure 'Margine Ton Doc Vendita' =
			
			[Prezzo Netto Doc Vendita OLD] - [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo Netto Doc Vendita' =
			
			DIVIDE ( [Importo Netto Filter Doc Vendita], [Qta Doc Vendita FT], 0 )
			/*
			    CALCULATE(
			        AVERAGEX('DOC VENDITA','DOC VENDITA'[Unit Price]),
			            FILTER('DOC VENDITA',
			                'DOC VENDITA'[Tipo_Riga] = "Articolo"
			            )
			    )
			*/
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"

		changedProperty = FormatString

	measure 'Prezzo Trasporto Doc Vendita' =
			
			CALCULATE (
			    AVERAGEX ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Costo Trasporto] ),
			    FILTER ( 'DOCUMENTO VENDITA', 'DOCUMENTO VENDITA'[Tipo Riga] = "Articolo" )
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Doc Vendita - Trasporto' =
			
			DIVIDE (
			    [Importo Doc Vendita - Trasporto],
			    [Qta Doc Vendita Gruppo Articolo],
			    0
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Vendita' = ```
			
			    CALCULATE(
			        DIVIDE([Importo Vendita],[Qta Vendita],0),
			        'DOCUMENTO VENDITA'[Categoria] IN {"NAZ","UE","NAZPERM"}
			    )
			
			// Prezzo Vendita = DIVIDE([Importo Vendita],[Qta Vendita],0)
			/*
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo] ) }
			
			VAR qta_propano = [Qta Doc Vendita FT] + [Qta Doc Vendita 3000002]
			VAR qta_mix = [Qta Doc Vendita Gruppo Articolo]
			
			VAR prezzo_propano =
			    DIVIDE ( [Importo Vendita], qta_propano, 0 )
			    //DIVIDE ( [Importo Netto Doc Vendita], qta_propano, 0 )
			    
			VAR prezzo_mix =
			    DIVIDE ( [Importo Doc Vendita - Trasporto], qta_mix, 0)
			
			VAR importo_tot = [Importo Vendita] + [Importo Doc Vendita - Trasporto]
			VAR qta_tot = qta_propano + qta_mix
			
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "PROPANO", prezzo_propano,
			        filtro_gruppo = "MIX", prezzo_mix,
			        filtro_gruppo = BLANK (), DIVIDE(importo_tot,qta_tot,0)
			    )
			*/
			```

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast Media 2' = ```
			AVERAGEX(CALENDARIO,[Qta Vendita Forecast])
			/*
			VAR first_year = IF(
			        SELECTEDVALUE(CALENDARIO[Year]) <> BLANK(),
			        SELECTEDVALUE(CALENDARIO[Year]) - 6,
			        MIN(CALENDARIO[Year])
			    )
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            CALENDARIO,
			            CALENDARIO[Year],
			            "qta_vendite_anno", [Qta Vendita]
			    	),
			    	VALUE(CALENDARIO[Year]) >= first_year &&
			    	VALUE(CALENDARIO[Year]) <= YEAR(TODAY()) &&
			        [Qta Vendita] > 0
			    	
			    )
			
			VAR media = 
			    AVERAGEX(
			        tab_dati,
			        [qta_vendite_anno]
			    )
			
			VAR forecast = media
			RETURN
			    forecast
			*/    
			```
		displayFolder: FORECAST

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Forecast NEW' = ```
			
			
			VAR CurYear = SELECTEDVALUE(CALENDARIO[Year])
			VAR FirstYear = MIN(CALENDARIO[Year])
			VAR LastYear = MAX(CALENDARIO[Year])
			VAR No_of_years = CurYear - LastYear
			
			VAR qta_last_year = CALCULATE([Qta Vendita], CALENDARIO[Year] = LastYear)
			VAR qta_first_year = CALCULATE([Qta Vendita], CALENDARIO[Year] = FirstYear)
			
			VAR CAGR = POWER(
			                DIVIDE(qta_last_year,qta_first_year),
			                DIVIDE(1,LastYear - FirstYear)
			            ) - 1
			
			VAR forecast = qta_last_year * POWER((1 + CAGR), No_of_years)
			
			RETURN
			
			    IF(
			        CurYear > LastYear,
			        forecast
			    )
			
			```
		formatString: 0.00
		displayFolder: FORECAST

		changedProperty = FormatString

	measure 'Qta Vendita Data Reg' = ```
			
			    CALCULATE(
			        [Qta Vendita],
			        USERELATIONSHIP(CALENDARIO[Date],'DOCUMENTO VENDITA'[Data Registrazione])
			    )
			```
