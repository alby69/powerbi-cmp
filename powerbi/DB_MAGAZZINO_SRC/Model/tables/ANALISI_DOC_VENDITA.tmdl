		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita NEW' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( ARTICOLI[Gruppo Articolo], BLANK () ) }
			
			VAR qta_mix = CALCULATE(
			        SUMX('Tab VENDITE', 'Tab VENDITE'[Qta]),
			        'Tab VENDITE'[Codice Articolo] IN {"1","1T"}
			)
			
			VAR qta_propano = CALCULATE(
			        SUMX('Tab VENDITE', 'Tab VENDITE'[Qta]),
			        'Tab VENDITE'[Codice Articolo] IN {"1","1T"}
			)
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano
			    )
			
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Bar = MIN([Importo Vendita],[Importo Vendita Forecast])
		displayFolder: Target vs Actual CHART

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita Forecast' = ```
			
			
			VAR first_year = VALUE(MIN(CALENDARIO[YEAR]))
			
			VAR tab_dati = 
			    FILTER(
			    	SUMMARIZE(
			            CALENDARIO,
			            CALENDARIO[Year],
			            CALENDARIO[MonthName],
			            "importo_vendite_anno", [Importo Vendita]
			    	),
			    	VALUE(CALENDARIO[Year]) >= first_year &&
			    	VALUE(CALENDARIO[Year]) <= YEAR(TODAY()) //&&
			        //[Qta Vendita] > 0
			    	
			    )
			
			VAR media = 
			    AVERAGEX(
			        tab_dati,
			        [importo_vendite_anno]
			    )
			
			VAR forecast = media
			RETURN
			    IF(
			        forecast <> BLANK(),
			        forecast,
			        0
			    )
			
			```
