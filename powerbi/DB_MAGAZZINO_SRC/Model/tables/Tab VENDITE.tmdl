table 'Tab VENDITE'

	measure 'Qta Tab Vendite' = SUMX('Tab VENDITE','Tab VENDITE'[Qta])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Qta Vendite' = SUM('Tab VENDITE'[# Qta])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Codice Articolo'
		summarizeBy: none
		isNameInferred
		sourceColumn: ARTICOLI[Codice Articolo]

		annotation SummarizationSetBy = Automatic

	column Qta
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Qta]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Soggetto
		summarizeBy: none
		isNameInferred
		sourceColumn: MAGAZZINO[Soggetto]

		annotation SummarizationSetBy = Automatic

	column Categoria
		summarizeBy: none
		isNameInferred
		sourceColumn: MAGAZZINO[Categoria]

		annotation SummarizationSetBy = Automatic

	column Deposito
		summarizeBy: none
		isNameInferred
		sourceColumn: MAGAZZINO[Deposito]

		annotation SummarizationSetBy = Automatic

	column MonthInCalendar
		summarizeBy: none
		isNameInferred
		sourceColumn: CALENDARIO[MonthInCalendar]

		annotation SummarizationSetBy = Automatic

	column Date
		formatString: Short Date
		summarizeBy: none
		isNameInferred
		sourceColumn: CALENDARIO[Date]

		annotation SummarizationSetBy = Automatic

	column Gruppo =
			
			IF (
			    'Tab VENDITE'[Categoria] = "NAZPERM",
			    SWITCH (
			        TRUE(),
			        'Tab VENDITE'[Soggetto] = "C00261", "LIQUIGAS",
			        'Tab VENDITE'[Soggetto] = "C00229", "BUTANGAS",
			        'Tab VENDITE'[Soggetto] = "C00525", "ANORD",
			        "IPEM"
			    ),
			    BLANK()    -- oppure puoi mettere un valore di default, es. "Altro"
			)
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '# Qta'
		formatString: 0
		summarizeBy: sum
		sourceColumn: [# Qta]

		annotation SummarizationSetBy = Automatic

	partition 'Tab VENDITE-64a33be6-1e7a-4d2e-8b36-05c752792334' = calculated
		mode: import
		source = ```
				
				VAR filtro_articolo = {"1","1T","2","2T"}
				
				VAR tab_vendite =
				        SUMMARIZECOLUMNS(            
				            CALENDARIO[MonthInCalendar],
				            CALENDARIO[Date],
				            ARTICOLI[Codice Articolo],
				            MAGAZZINO[Soggetto],
				            MAGAZZINO[Categoria],
				            MAGAZZINO[Deposito],
				            FILTER(MAGAZZINO,MAGAZZINO[Movimento] = "Vendita"),
				            TREATAS(filtro_articolo,ARTICOLI[Codice Articolo]),            
				            "Qta", ABS([Qta Ton]),
				            "# Qta",COUNT(MAGAZZINO[Indice])
				
				        )
				RETURN
				    FILTER(
				        tab_vendite,
				        CALENDARIO[MonthInCalendar] <> BLANK()
				    )
				
				```

	annotation PBI_Id = 3ac231cfec2b4c2589b5b284d7fb0a55

