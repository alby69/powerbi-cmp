table KPI_Magazzino

	measure 'Qta Ton' =
			
			VAR qta = SUMX ( FACT_Magazzino, FACT_Magazzino[Quantity] )
			
			RETURN
			    DIVIDE ( qta, 1000, 0 )
			/*
			    SWITCH(
			        [Unità Misura] ,
			        "KG", DIVIDE ( qta, 1000, 0 ),
			        "TON", qta,
			        0
			    )
			*/
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CUM ALL' =
			
			CALCULATE (
			    [Qta Ton],
			    FILTER ( ALL ( DIM_Calendario ), DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] ) )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}


	measure 'Qta Ton Diff YoY' =
			
			[Qta Ton] - [Qta Ton LY]
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisto' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			VAR filtro_articolo = { SELECTEDVALUE ( DIM_Articoli[CodiceArticolo], BLANK () ) }
			
			VAR qta_mix = [Qta RESA MIX] //[Qta BIL MIX]
			VAR qta_propano = SUMX('FACT_Propano', 'FACT_Propano'[QuantityIPEM] )
			
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano //IF(filtro_articolo IN {"1","1T"},qta_mix,qta_propano)
			    )
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Importo = ```
			
			CALCULATE(
			    SUMX(FACT_MovimentiCG,FACT_MovimentiCG[Importo]),
			    REMOVEFILTERS(FACT_MovimentiCG[Categoria])
			)
			
			/*
			Importo = 
			SUMX(FACT_MovimentiCG,FACT_MovimentiCG[Importo])
			*/
			
			
			```
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Fornitori' =
			
			CALCULATE ( [Importo], FILTER ( FACT_MovimentiCG, FACT_MovimentiCG[Conto] = "2030001" ) )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Acquisto CG' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER ( FACT_MovimentiCG, FACT_MovimentiCG[Conto] IN { "4020002" } )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

	measure 'Importo x Doc Date' =
			
			CALCULATE (
			    SUMX ( FACT_MovimentiCG, FACT_MovimentiCG[Importo] ),
			    USERELATIONSHIP ( DIM_Calendario[Date], FACT_MovimentiCG[Data Documento] )
			)
		displayFolder: IMPORTO_MAG

	measure 'Importo Acquisto ALTRO' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER ( FACT_MovimentiCG, FACT_MovimentiCG[Conto] IN { "3100001" } && FACT_MovimentiCG[Progetto] = "PS01" )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Accantonamenti' =
			
			SUMX ( FACT_Accantonamenti, FACT_Accantonamenti[Importo] )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton CUM YTD' =
			
			[Qta Ton CUM YTD] * [Costo Acquisto Qta Ton]
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton' =
			
			[Qta Ton] * [Costo Acquisto Qta Ton]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}


	measure 'Importo Qta Ton CY-LY' =
			
			KPI_Magazzino[Importo Qta Ton CUM YTD] - KPI_Magazzino[Importo Qta Ton CUM YTD LY]
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton Vendita' =
			
			[Qta Vendite] * [Costo Acquisto Qta Ton]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Mag Progr' =
			
			VAR filtro_articolo =
			    { SELECTEDVALUE ( DIM_Articoli[CodiceArticolo] ) }
			VAR anno_inizio = 2021
			VAR tab_filtro =
			    FILTER (
			        ALL ( FACT_Magazzino ),
			        FACT_Magazzino[CodiceDeposito] = "IPEM"
			            && FACT_Magazzino[CodiceArticolo]
			                IN filtro_articolo
			                    && FACT_Magazzino[Date] >= DATE ( anno_inizio, 1, 1 )
			                    && FACT_Magazzino[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE ( [Importo], tab_filtro )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Mag Progr 2' =
			
			[CMP Acquisto Mag Progr] * [Qta Acquisto Progr]
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton Prev' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			VAR cur_date =
			    { SELECTEDVALUE ( DIM_Calendario[Date] ) }
			VAR importo_iniziale =
			    SUMX (
			        FILTER (
			            FACT_Giacenza,
			            FACT_Giacenza[Data] = DATE ( 2021, 1, 1 )
			                && FACT_Giacenza[Gruppo] = filtro_gruppo
			        ),
			        FACT_Giacenza[Importo]
			    )
			VAR tab_filtro =
			    FILTER (
			        ALLSELECTED ( DIM_Calendario ),
			        DIM_Calendario[Date] < MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE (
			        IF (
			            cur_date = DATE ( 2021, 1, 1 )
			                || ISBLANK ( [Qta Ton] ),
			            importo_iniziale,
			            [Qta Ton]
			        ),
			        tab_filtro
			    )
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendita CG' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER (
			        FACT_MovimentiCG,
			        FACT_MovimentiCG[Conto] IN { "3000002", "3000003", "3000004", "3000005" }
			    )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Passaggi CG' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER (
			        FACT_MovimentiCG,
			        FACT_MovimentiCG[Conto] IN { "3100001", "3100002", "3100003", "3100004", "3100005" }
			    )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Rimanenze Iniziali PROPANO CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( FACT_MovimentiCG, FACT_MovimentiCG[Conto] IN { "4010002" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Rimanenze Finali PROPANO CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( FACT_MovimentiCG, FACT_MovimentiCG[Conto] IN { "3300002" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo CMP' =
			
			[Importo Rimanenze Iniziali PROPANO CG] + [Importo Acquisti (CG)]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Inventario' = ([Qta Acquisto] + [Qta Ton CD Giacenza IPEM]) * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: IMPORTO_MAG

		changedProperty = FormatString

	measure 'Importo Rimanenze Finali MIX CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( FACT_MovimentiCG, FACT_MovimentiCG[Conto] IN { "3300003" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Rimanenze Iniziali MIX CG' =
			
			CALCULATE (
			    ABS ( [Importo Dare CG] ),
			    FILTER ( FACT_MovimentiCG, FACT_MovimentiCG[Conto] IN { "4010003" } )
			)
		displayFolder: IMPORTO_MAG

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Acquisto IPEM CD' =
			
			CALCULATE (
			    [Qta Ton CD],
			    FILTER (
			        FACT_ContoDeposito,
			        FACT_ContoDeposito[Movimento] = "Acquisto"
			            && FACT_ContoDeposito[Deposito] = "IPEM"
			    )
			)
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CD' =
			
			SUMX ( FACT_ContoDeposito, FACT_ContoDeposito[Quantità] )
		formatString: #,0.000
		displayFolder: QTA CONTO DEPOSITO

	measure 'Qta Ton Acquisto IPEM CD CUM ALL' =
			
			CALCULATE (
			    [Qta Ton Acquisto IPEM CD],
			    FILTER ( ALL ( DIM_Calendario ), DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] ) )
			)
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CD CUM' = ```
			
			VAR InizioPeriodo =
			    CALCULATE(
			        MIN(FACT_ContoDeposito[Data Competenza]),
			        ALLSELECTED(FACT_ContoDeposito)
			    )
			VAR DataCorrente = MAX(FACT_ContoDeposito[Data Competenza])
			VAR OrdineCorrente = MAX(FACT_ContoDeposito)
			
			VAR UltimaGiacenzaPrecedente =
			MAXX(
			    FILTER(
			        ALL(FACT_ContoDeposito),
			        FACT_ContoDeposito[Movimento] = "Giacenza" &&
			        FACT_ContoDeposito <= InizioPeriodo
			    ),
			    FACT_ContoDeposito[Data Movimento]
			)
			
			VAR Tab_Filtro =
			FILTER(
			    ALLSELECTED(FACT_ContoDeposito),
			    (
			        FACT_ContoDeposito[Movimento] = "Giacenza" &&
			        FACT_ContoDeposito[Data Movimento] = UltimaGiacenzaPrecedente
			    )
			    ||
			    (
			        FACT_ContoDeposito[Movimento] <> "Giacenza" &&
			        FACT_ContoDeposito[Data Movimento] >= InizioPeriodo &&
			        (
			            FACT_ContoDeposito[Data Movimento] < DataCorrente
			            ||
			            (
			                FACT_ContoDeposito[Data Movimento] = DataCorrente &&
			                FACT_ContoDeposito[Ordine Movimento] <= OrdineCorrente
			            )
			        )
			    )
			)
			
			VAR Risultato = CALCULATE([Qta Ton CD], Tab_Filtro)
			
			RETURN
			IF(
			    HASONEVALUE(FACT_ContoDeposito[Data Movimento]),
			    Risultato,
			    BLANK()
			)
			
			
			/* Qta Ton CD CUM Base = 
			VAR InizioPeriodo =
			    MIN ( FACT_ContoDeposito[Data Movimento] )
			VAR DataCorrente =
			    MAX ( FACT_ContoDeposito[Data Movimento] )
			VAR OrdineCorrente =
			    MAX ( FACT_ContoDeposito[Ordine Movimento] )
			VAR UltimaGiacenzaPrecedente =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( FACT_ContoDeposito ),
			            FACT_ContoDeposito[Movimento] = "Giacenza"
			                && FACT_ContoDeposito[Data Movimento] <= InizioPeriodo
			        ),
			        FACT_ContoDeposito[Data Movimento]
			    )
			VAR Tab_Filtro =
			    FILTER (
			        ALLSELECTED ( FACT_ContoDeposito ),
			        (
			            FACT_ContoDeposito[Movimento] = "Giacenza"
			                && FACT_ContoDeposito[Data Movimento] = UltimaGiacenzaPrecedente
			        )
			            ||
			        (
			            FACT_ContoDeposito[Movimento] <> "Giacenza"
			                && FACT_ContoDeposito[Data Movimento] >= InizioPeriodo
			                && (
			                    FACT_ContoDeposito[Data Movimento] < DataCorrente
			                        || (
			                            FACT_ContoDeposito[Data Movimento] = DataCorrente
			                                && FACT_ContoDeposito[Ordine Movimento] <= OrdineCorrente
			                        )
			                )
			        )
			    )
			RETURN
			    CALCULATE ( [Qta Ton CD], Tab_Filtro )
			
			
			
			*/
			
			```
		displayFolder: QTA CONTO DEPOSITO


	measure 'Qta Ton CD Giacenza IPEM' =
			
			CALCULATE (
			    [Qta Ton CD],
			    FILTER (
			        FACT_ContoDeposito,
			        FACT_ContoDeposito[Movimento] IN { "Giacenza" } &&
			        FACT_ContoDeposito[Deposito] IN { "IPEM" }
			    )
			)
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valore Magazzino' =
			
			[Qta Ton CUM ALL] * [CMP Acquisto CUM]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

	measure 'Valore Magazzino 2' =
			
			[Qta Ton CUM ALL] * [CMP Prodotto CUM]

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rapporto Inventario' = DIVIDE([Importo Vendita N DAYS],[Importo Inventario],0)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Dare CG' = ```
			
			    CALCULATE(
			        SUMX ( FACT_MovimentiCG, FACT_MovimentiCG[Importo]),
			        FACT_MovimentiCG[Importo] > 0
			    )
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unità Misura' = MINX(FACT_Magazzino,FACT_Magazzino[UnitàMisura])

	measure 'Qta Ton CUM YTD' =
			
			CALCULATE (
			    [Qta Ton],
			    FILTER (
			        ALL ( DIM_Calendario ),
			        DIM_Calendario[Year] <= MAX ( DIM_Calendario[Year] )
			            && DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza' = ```
			[Qta Giacenza Iniziale] + [Qta Acquisto] - [Qta Vendita]
			
			/*
			VAR DataInizio = DATE(2025,1,1)  // la tua data di riferimento
			VAR QtaIniziale = 5571.546             // <-- metti qui la quantità a quella data (in tonnellate)
			VAR QtaCumulata =
			    CALCULATE(
			        [Qta Ton],
			        FILTER(
			            ALL(DIM_Calendario),
			            DIM_Calendario[Date] > DataInizio &&
			            DIM_Calendario[Date] <= MAX(DIM_Calendario[Date])
			        )
			    )
			RETURN
			QtaIniziale + QtaCumulata
			*/
			
			/*
			Qta Ton Giacenza = 
			VAR DataInizio = DATE(2025,2,1)   // cambia qui la tua data di partenza
			RETURN
			IF(
			    ISBLANK([Qta Ton]),
			    BLANK(),
			    CALCULATE(
			        [Qta Ton],
			        FILTER(
			            ALL(DIM_Calendario),
			            DIM_Calendario[Date] >= DataInizio &&
			            DIM_Calendario[Date] <= MAX(DIM_Calendario[Date])
			        )
			    )
			)
			*/
			/*
			Qta Ton Giacenza = 
			IF(ISBLANK([Qta Ton]),
			    BLANK(),
			    CALCULATE (
			        [Qta Ton],
			        FILTER ( ALL ( DIM_Calendario ), DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] ) )
			    )
			)
			*/
			
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza OLD' = ```
			
			    CALCULATE(
			        [Qta Ton CUM ALL],
			        REMOVEFILTERS(DIM_GruppiVendita)
			    )
			/*
			VAR filtro_gruppo = { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			
			VAR qta_propano = [Qta Ton CD Giacenza IPEM]
			VAR qta_mix =  [Qta Ton CUM ALL]
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX",  qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), DIVIDE(qta_mix + qta_propano,2,0)
			    )
			*/        
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Prev' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			VAR cur_date =
			    { SELECTEDVALUE ( DIM_Calendario[Date] ) }
			VAR qta_iniziale =
			    SUMX (
			        FILTER (
			            FACT_Giacenza,
			            FACT_Giacenza[Data] = DATE ( 2021, 1, 1 )
			                && FACT_Giacenza[Gruppo] = filtro_gruppo
			        ),
			        FACT_Giacenza[Qta]
			    )
			VAR tab_filtro =
			    FILTER (
			        ALLSELECTED ( DIM_Calendario ),
			        DIM_Calendario[Date] < MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE (
			        IF (
			            cur_date = DATE ( 2021, 1, 1 )
			                || ISBLANK ( [Qta Ton] ),
			            qta_iniziale,
			            [Qta Ton]
			        ),
			        tab_filtro
			    )
		displayFolder: QTA

	measure 'Qta Ton Giacenza LM' =
			
			CALCULATE ( [Qta Ton Giacenza OLD], DATEADD ( DIM_Calendario[Date], -1, MONTH ) )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza IPEM' = ```
			
			    CALCULATE(
			        [Qta Ton Giacenza OLD],
			        FACT_Magazzino[CodiceDeposito] = "IPEM"
			    )
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton CD x Mov' =
			
			VAR cur_mov = SELECTEDVALUE(FACT_ContoDeposito[Movimento],0)
			
			RETURN
			    IF(cur_mov = "Vendita", [Qta Vendita Deposito], [Qta Ton CD])
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Deposito' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			VAR filtro_deposito = { SELECTEDVALUE ( FACT_ContoDepositoOLD[Deposito], BLANK () ) }
			VAR filtro_cliente = 
			    {
			    SWITCH (
			        TRUE (),
			        filtro_deposito = "IPEM", "",
			        filtro_deposito = "AUTOGASNORD", "C00525",
			        filtro_deposito = "BUTANGAS", "C00229",
			        filtro_deposito = "LIQUIGAS", "C00261",
			        filtro_deposito = "VERSALIS", "C00794"
			    ) }
			    
			VAR qta_mix = CALCULATE(
			        SUMX('FACT_Vendite', 'FACT_Vendite'[Qta]),
			        FILTER('FACT_Vendite','FACT_Vendite'[CodiceArticolo] IN {"1","1T"} &&
			            IF( filtro_cliente <> "",'FACT_Vendite'[CodiceSoggetto] IN filtro_cliente,
			                ('FACT_Vendite'[CodiceCategoria] <> "PASSAGGIO")
			            )
			        )
			)
			
			VAR qta_propano = CALCULATE(
			        SUMX('FACT_Vendite', 'FACT_Vendite'[Qta]),
			        FILTER('FACT_Vendite','FACT_Vendite'[CodiceArticolo] IN {"2","2T"} &&
			            IF( filtro_cliente <> "",'FACT_Vendite'[CodiceSoggetto] IN filtro_cliente,
			                ('FACT_Vendite'[CodiceCategoria] <> "PASSAGGIO")
			            )
			        )
			)
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano
			    )
			
			```
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Giacenza 2' = ```
			
			VAR prodotto = SELECTEDVALUE(DIM_Articoli[GruppoProdotto])
			VAR start_date = DATE(2024,1,1)
			
			VAR giacenza_prop = 4901
			VAR giacenza_mix = 219.520
			VAR giacenza = IF(prodotto = "PROPANO",giacenza_prop,giacenza_mix)
			
			VAR qta_acquisto_prop = TOTALYTD ( [Qta Acquisto], DIM_Calendario[Date] )
			VAR qta_acquisto_mix = TOTALYTD ( [Qta Acquisto], DIM_Calendario[Date] )
			VAR qta_acquisto_tot = qta_acquisto_prop + qta_acquisto_mix
			
			VAR qta_vendita_propano = TOTALYTD ( [Qta Vendita], DIM_Calendario[Date] )
			VAR qta_vendita_mix = TOTALYTD ( [Qta Vendita Prodotto], DIM_Calendario[Date] )
			VAR qta_vendita_tot = qta_vendita_propano + qta_vendita_mix
			
			VAR qta_vendita = 
			    { 
			        SWITCH (
			            TRUE (),
			            prodotto = "PROPANO", qta_vendita_propano,
			            prodotto = "MIX", qta_vendita_mix,
			            qta_vendita_tot
			        )
			    }
			
			
			VAR qta_acquisto = 
			    { 
			        SWITCH (
			            TRUE (),
			            prodotto = "PROPANO", qta_acquisto_prop,
			            prodotto = "MIX", qta_acquisto_mix,
			            qta_acquisto_tot
			        )
			    }
			
			
			RETURN
			
			    IF(
			        AND(MIN(DIM_Calendario[Date]) = start_date, MAX(DIM_Calendario[Date]) = DATE(2024,1,31)),
			        giacenza, // + start_qta,
			        giacenza + qta_acquisto - qta_vendita
			    )
			```
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Vendita MAG' =
			CALCULATE(
			    [Qta Ton],
			    FACT_Magazzino[TipoMovimento] = "Vendita"
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisto CUM' =
			
			IF (
			    ISBLANK ( [Qta Acquisto] ),
			    BLANK (),
			    CALCULATE (
			        [Qta Acquisto],
			        FILTER (
			            ALLSELECTED ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			        )
			    )
			)
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Acquisto' =
			
			// non funziona perchè in magazzino IPEM la navi sono inserite come totale e non spaccato per ubicazione
			    CALCULATE(
			        [Qta Ton],
			        FILTER(FACT_Magazzino,FACT_Magazzino[TipoMovimento] IN {"Acquisto","Rettifica Positiva"})
			    )
		displayFolder: QTA

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mostra Giacenza No Movimenti' = ```
			
			VAR HaQuantita = NOT(ISBLANK([Qta Ton CD]))
			VAR InizioAnno = DATE(YEAR(MAX(FACT_ContoDeposito[Data Competenza])), 1, 1)
			VAR IsGiacenzaIniziale = 
			    MAX(FACT_ContoDeposito[Movimento]) = "Giacenza" 
			    && MAX(FACT_ContoDeposito[Data Movimento]) <= InizioAnno
			VAR IsAltroMovimento = MAX(FACT_ContoDeposito[Movimento]) <> "Giacenza"
			RETURN
			IF(
			    HaQuantita && (IsGiacenzaIniziale || IsAltroMovimento),
			    1,
			    BLANK()
			)
			```
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FiltroAttivo = ```
			
			VAR filtroGruppo = ISFILTERED(DIM_GruppiVendita[Gruppo])
			VAR filtroCat = ISFILTERED(FACT_MovimentiCG[Categoria])
			RETURN
			"Gruppo: " & IF(filtroGruppo, "✅", "❌") & 
			" | Categoria: " & IF(filtroCat, "✅", "❌")
			
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Giacenza Iniziale' = [Qta Ton CD Giacenza IPEM]
		displayFolder: QTA CONTO DEPOSITO

		annotation PBI_FormatHint = {"isGeneralNumber":true}

