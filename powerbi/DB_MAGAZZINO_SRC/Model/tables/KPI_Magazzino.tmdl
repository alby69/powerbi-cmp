table KPI_Magazzino

	measure 'Qta Magazzino' =
			
			VAR qta = SUMX ( FACT_Magazzino, FACT_Magazzino[Quantity] )
			
			RETURN
			    DIVIDE ( qta, 1000, 0 )
		displayFolder: KPI Magazzino
		annotation PBI_Description = "Quantità in magazzino in tonnellate (da Kg)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Progressivo' =
			
			CALCULATE (
			    [Qta Magazzino],
			    FILTER ( ALL ( DIM_Calendario ), DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] ) )
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Differenza YoY' =
			
			[Qta Magazzino] - CALCULATE([Qta Magazzino], SAMEPERIODLASTYEAR(DIM_Calendario[Date]))
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisti' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			
			VAR qta_mix = [Qta RESA MIX]
			VAR qta_propano = SUMX(FACT_Propano, FACT_Propano[QuantityIPEM] )
			
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano
			    )
			```
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Magazzino' = ```
			
			CALCULATE(
			    SUMX(FACT_MovimentiCG,FACT_MovimentiCG[Importo]),
			    REMOVEFILTERS(FACT_MovimentiCG[CodiceCategoria])
			)
			```
		displayFolder: KPI Magazzino
		annotation PBI_Description = "Importo totale movimenti di magazzino da CG"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Fornitori' =
			
			CALCULATE ( [Importo Magazzino], FACT_MovimentiCG[CodiceConto] = "2030001" )
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Acquisti (CG)' =
			
			CALCULATE (
			    ABS ( [Importo Magazzino] ),
			    FACT_MovimentiCG[CodiceConto] = "4020002"
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

	measure 'Importo per Data Documento' =
			
			CALCULATE (
			    SUMX ( FACT_MovimentiCG, FACT_MovimentiCG[Importo] ),
			    USERELATIONSHIP ( DIM_Calendario[Date], FACT_MovimentiCG[DataDocumento] )
			)
		displayFolder: KPI Magazzino

	measure 'Importo Acquisti Altro' =
			
			CALCULATE (
			    ABS ( [Importo Magazzino] ),
			    FACT_MovimentiCG[CodiceConto] = "3100001" && FACT_MovimentiCG[Progetto] = "PS01"
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Accantonamenti' =
			
			SUMX ( FACT_Accantonamenti, FACT_Accantonamenti[Importo] )
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton Progressivo YTD' =
			
			[Qta Magazzino Progressivo YTD] * [Costo Acquisto Qta Ton]
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton' =
			
			[Qta Magazzino] * [Costo Acquisto Qta Ton]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}


	measure 'Importo Qta Ton Differenza CY-LY' =
			
			[Importo Qta Ton Progressivo YTD] - CALCULATE([Importo Qta Ton Progressivo YTD], SAMEPERIODLASTYEAR(DIM_Calendario[Date]))
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton Vendita' =
			
			[Qta Vendite] * [Costo Acquisto Qta Ton]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Magazzino Progressivo' =
			
			VAR filtro_articolo =
			    { SELECTEDVALUE ( DIM_Articoli[CodiceArticolo] ) }
			VAR anno_inizio = 2021
			VAR tab_filtro =
			    FILTER (
			        ALL ( FACT_Magazzino ),
			        FACT_Magazzino[CodiceDeposito] = "IPEM"
			            && FACT_Magazzino[CodiceArticolo]
			                IN filtro_articolo
			                    && FACT_Magazzino[Date] >= DATE ( anno_inizio, 1, 1 )
			                    && FACT_Magazzino[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE ( [Importo Magazzino], tab_filtro )
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Magazzino Progressivo (2)' =
			
			[CMP Acquisto Mag Progr] * [Qta Acquisto Progr]
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Qta Ton Previsto' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			VAR cur_date =
			    { SELECTEDVALUE ( DIM_Calendario[Date] ) }
			VAR importo_iniziale =
			    SUMX (
			        FILTER (
			            FACT_Giacenza,
			            FACT_Giacenza[Date] = DATE ( 2021, 1, 1 )
			                && FACT_Giacenza[GruppoProdotto] = filtro_gruppo
			        ),
			        FACT_Giacenza[Importo]
			    )
			VAR tab_filtro =
			    FILTER (
			        ALLSELECTED ( DIM_Calendario ),
			        DIM_Calendario[Date] < MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE (
			        IF (
			            cur_date = DATE ( 2021, 1, 1 )
			                || ISBLANK ( [Qta Magazzino] ),
			            importo_iniziale,
			            [Qta Magazzino]
			        ),
			        tab_filtro
			    )
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite (CG)' =
			
			CALCULATE (
			    ABS ( [Importo Magazzino] ),
			    FACT_MovimentiCG[CodiceConto] IN { "3000002", "3000003", "3000004", "3000005" }
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

		changedProperty = FormatString

	measure 'Importo Passaggi (CG)' =
			
			CALCULATE (
			    ABS ( [Importo Magazzino] ),
			    FACT_MovimentiCG[CodiceConto] IN { "3100001", "3100002", "3100003", "3100004", "3100005" }
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

		changedProperty = FormatString

	measure 'Importo Rimanenze Iniziali Propano (CG)' =
			
			CALCULATE (
			    ABS ( [Importo Dare (CG)] ),
			    FACT_MovimentiCG[CodiceConto] = "4010002"
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Rimanenze Finali Propano (CG)' =
			
			CALCULATE (
			    ABS ( [Importo Dare (CG)] ),
			    FACT_MovimentiCG[CodiceConto] = "3300002"
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo CMP' =
			
			[Importo Rimanenze Iniziali Propano (CG)] + [Importo Acquisti (CG)]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

		changedProperty = FormatString

	measure 'Importo Inventario' = ([Qta Acquisti] + [Qta Magazzino CD Giacenza IPEM]) * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

		changedProperty = FormatString

	measure 'Importo Rimanenze Finali Mix (CG)' =
			
			CALCULATE (
			    ABS ( [Importo Dare (CG)] ),
			    FACT_MovimentiCG[CodiceConto] = "3300003"
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Rimanenze Iniziali Mix (CG)' =
			
			CALCULATE (
			    ABS ( [Importo Dare (CG)] ),
			    FACT_MovimentiCG[CodiceConto] = "4010003"
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Acquisto IPEM CD' =
			
			CALCULATE (
			    [Qta Magazzino CD],
			    FACT_ContoDeposito[TipoMovimento] = "Acquisto"
			        && FACT_ContoDeposito[CodiceDeposito] = "IPEM"
			)
		displayFolder: KPI Magazzino CD

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino CD' =
			
			SUMX ( FACT_ContoDeposito, FACT_ContoDeposito[Quantity] )
		formatString: #,0.000
		displayFolder: KPI Magazzino CD

	measure 'Qta Magazzino Acquisto IPEM CD Progressivo' =
			
			CALCULATE (
			    [Qta Magazzino Acquisto IPEM CD],
			    FILTER ( ALL ( DIM_Calendario ), DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] ) )
			)
		displayFolder: KPI Magazzino CD

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino CD Progressivo' = ```
			
			VAR InizioPeriodo =
			    CALCULATE(
			        MIN(FACT_ContoDeposito[DataMovimento]),
			        ALLSELECTED(FACT_ContoDeposito)
			    )
			VAR DataCorrente = MAX(FACT_ContoDeposito[DataMovimento])
			VAR OrdineCorrente = MAX(FACT_ContoDeposito[EntryNo])
			
			VAR UltimaGiacenzaPrecedente =
			MAXX(
			    FILTER(
			        ALL(FACT_ContoDeposito),
			        FACT_ContoDeposito[TipoMovimento] = "Giacenza" &&
			        FACT_ContoDeposito[DataMovimento] <= InizioPeriodo
			    ),
			    FACT_ContoDeposito[DataMovimento]
			)
			
			VAR Tab_Filtro =
			FILTER(
			    ALLSELECTED(FACT_ContoDeposito),
			    (
			        FACT_ContoDeposito[TipoMovimento] = "Giacenza" &&
			        FACT_ContoDeposito[DataMovimento] = UltimaGiacenzaPrecedente
			    )
			    ||
			    (
			        FACT_ContoDeposito[TipoMovimento] <> "Giacenza" &&
			        FACT_ContoDeposito[DataMovimento] >= InizioPeriodo &&
			        (
			            FACT_ContoDeposito[DataMovimento] < DataCorrente
			            ||
			            (
			                FACT_ContoDeposito[DataMovimento] = DataCorrente &&
			                FACT_ContoDeposito[EntryNo] <= OrdineCorrente
			            )
			        )
			    )
			)
			
			VAR Risultato = CALCULATE([Qta Magazzino CD], Tab_Filtro)
			
			RETURN
			IF(
			    HASONEVALUE(FACT_ContoDeposito[DataMovimento]),
			    Risultato,
			    BLANK()
			)
			```
		displayFolder: KPI Magazzino CD


	measure 'Qta Magazzino CD Giacenza IPEM' =
			
			CALCULATE (
			    [Qta Magazzino CD],
			    FACT_ContoDeposito[TipoMovimento] = "Giacenza" &&
			    FACT_ContoDeposito[CodiceDeposito] = "IPEM"
			)
		displayFolder: KPI Magazzino CD

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valore Magazzino' =
			
			[Qta Magazzino Progressivo] * [CMP Acquisto CUM]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Magazzino

	measure 'Valore Magazzino (2)' =
			
			[Qta Magazzino Progressivo] * [CMP Prodotto CUM]
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rapporto Inventario' = DIVIDE([Importo Vendita N DAYS],[Importo Inventario],0)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Dare (CG)' = ```
			
			    CALCULATE(
			        SUMX ( FACT_MovimentiCG, FACT_MovimentiCG[Importo]),
			        FACT_MovimentiCG[Importo] > 0
			    )
			```
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unità Misura' = MINX(FACT_Magazzino,FACT_Magazzino[UnitàMisura])
		displayFolder: KPI Magazzino

	measure 'Qta Magazzino Progressivo YTD' =
			
			CALCULATE (
			    [Qta Magazzino],
			    FILTER (
			        ALL ( DIM_Calendario ),
			        DIM_Calendario[Year] <= MAX ( DIM_Calendario[Year] )
			            && DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Giacenza' = [Qta Giacenza Iniziale] + [Qta Acquisti] - [Qta Vendite]
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Giacenza OLD' = ```
			
			    CALCULATE(
			        [Qta Magazzino Progressivo],
			        REMOVEFILTERS(DIM_GruppiVendita)
			    )
			```
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Prevista' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			VAR cur_date =
			    { SELECTEDVALUE ( DIM_Calendario[Date] ) }
			VAR qta_iniziale =
			    SUMX (
			        FILTER (
			            FACT_Giacenza,
			            FACT_Giacenza[Date] = DATE ( 2021, 1, 1 )
			                && FACT_Giacenza[GruppoProdotto] = filtro_gruppo
			        ),
			        FACT_Giacenza[Quantity]
			    )
			VAR tab_filtro =
			    FILTER (
			        ALLSELECTED ( DIM_Calendario ),
			        DIM_Calendario[Date] < MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE (
			        IF (
			            cur_date = DATE ( 2021, 1, 1 )
			                || ISBLANK ( [Qta Magazzino] ),
			            qta_iniziale,
			            [Qta Magazzino]
			        ),
			        tab_filtro
			    )
		displayFolder: KPI Magazzino

	measure 'Qta Magazzino Giacenza LM' =
			
			CALCULATE ( [Qta Magazzino Giacenza OLD], DATEADD ( DIM_Calendario[Date], -1, MONTH ) )
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Giacenza IPEM' = ```
			
			    CALCULATE(
			        [Qta Magazzino Giacenza OLD],
			        FACT_Magazzino[CodiceDeposito] = "IPEM"
			    )
			```
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino CD per Movimento' =
			
			VAR cur_mov = SELECTEDVALUE(FACT_ContoDeposito[TipoMovimento],0)
			
			RETURN
			    IF(cur_mov = "Vendita", [Qta Vendita Deposito], [Qta Magazzino CD])
		displayFolder: KPI Magazzino CD

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendita Deposito' = ```
			
			
			VAR filtro_gruppo = { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			VAR filtro_deposito = { SELECTEDVALUE ( FACT_ContoDepositoOLD[CodiceDeposito], BLANK () ) }
			VAR filtro_cliente = 
			    {
			    SWITCH (
			        TRUE (),
			        filtro_deposito = "IPEM", "",
			        filtro_deposito = "AUTOGASNORD", "C00525",
			        filtro_deposito = "BUTANGAS", "C00229",
			        filtro_deposito = "LIQUIGAS", "C00261",
			        filtro_deposito = "VERSALIS", "C00794"
			    ) }
			    
			VAR qta_mix = CALCULATE(
			        SUMX(FACT_Vendite, FACT_Vendite[Quantity]),
			        FILTER(FACT_Vendite,FACT_Vendite[CodiceArticolo] IN {"1","1T"} &&
			            IF( filtro_cliente <> "",FACT_Vendite[CodiceSoggetto] IN filtro_cliente,
			                (FACT_Vendite[CodiceCategoria] <> "PASSAGGIO")
			            )
			        )
			)
			
			VAR qta_propano = CALCULATE(
			        SUMX(FACT_Vendite, FACT_Vendite[Quantity]),
			        FILTER(FACT_Vendite,FACT_Vendite[CodiceArticolo] IN {"2","2T"} &&
			            IF( filtro_cliente <> "",FACT_Vendite[CodiceSoggetto] IN filtro_cliente,
			                (FACT_Vendite[CodiceCategoria] <> "PASSAGGIO")
			            )
			        )
			)
			    
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", qta_mix,
			        filtro_gruppo = "PROPANO", qta_propano,
			        filtro_gruppo = BLANK (), qta_mix + qta_propano
			    )
			
			```
		displayFolder: KPI Magazzino CD

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Giacenza (2)' = ```
			
			VAR prodotto = SELECTEDVALUE(DIM_Articoli[GruppoProdotto])
			VAR start_date = DATE(2024,1,1)
			
			VAR giacenza_prop = 4901
			VAR giacenza_mix = 219.520
			VAR giacenza = IF(prodotto = "PROPANO",giacenza_prop,giacenza_mix)
			
			VAR qta_acquisto_prop = TOTALYTD ( [Qta Acquisti], DIM_Calendario[Date] )
			VAR qta_acquisto_mix = TOTALYTD ( [Qta Acquisti], DIM_Calendario[Date] )
			VAR qta_acquisto_tot = qta_acquisto_prop + qta_acquisto_mix
			
			VAR qta_vendita_propano = TOTALYTD ( [Qta Vendite], DIM_Calendario[Date] )
			VAR qta_vendita_mix = TOTALYTD ( [Qta Vendita Prodotto], DIM_Calendario[Date] )
			VAR qta_vendita_tot = qta_vendita_propano + qta_vendita_mix
			
			VAR qta_vendita = 
			    { 
			        SWITCH (
			            TRUE (),
			            prodotto = "PROPANO", qta_vendita_propano,
			            prodotto = "MIX", qta_vendita_mix,
			            qta_vendita_tot
			        )
			    }
			
			
			VAR qta_acquisto = 
			    { 
			        SWITCH (
			            TRUE (),
			            prodotto = "PROPANO", qta_acquisto_prop,
			            prodotto = "MIX", qta_acquisto_mix,
			            qta_acquisto_tot
			        )
			    }
			
			
			RETURN
			
			    IF(
			        AND(MIN(DIM_Calendario[Date]) = start_date, MAX(DIM_Calendario[Date]) = DATE(2024,1,31)),
			        giacenza, // + start_qta,
			        giacenza + qta_acquisto - qta_vendita
			    )
			```
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Vendita (MAG)' =
			CALCULATE(
			    [Qta Magazzino],
			    FACT_Magazzino[TipoMovimento] = "Vendita"
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisti Progressivo' =
			
			IF (
			    ISBLANK ( [Qta Acquisti] ),
			    BLANK (),
			    CALCULATE (
			        [Qta Acquisti],
			        FILTER (
			            ALLSELECTED ( DIM_Calendario ),
			            DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			        )
			    )
			)
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Magazzino Acquisto' =
			
			    CALCULATE(
			        [Qta Magazzino],
			        FACT_Magazzino[TipoMovimento] IN {"Acquisto","Rettifica Positiva"}
			    )
		displayFolder: KPI Magazzino

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mostra Giacenza No Movimenti' = ```
			
			VAR HaQuantita = NOT(ISBLANK([Qta Magazzino CD]))
			VAR InizioAnno = DATE(YEAR(MAX(FACT_ContoDeposito[DataMovimento])), 1, 1)
			VAR IsGiacenzaIniziale = 
			    MAX(FACT_ContoDeposito[TipoMovimento]) = "Giacenza"
			    && MAX(FACT_ContoDeposito[DataMovimento]) <= InizioAnno
			VAR IsAltroMovimento = MAX(FACT_ContoDeposito[TipoMovimento]) <> "Giacenza"
			RETURN
			IF(
			    HaQuantita && (IsGiacenzaIniziale || IsAltroMovimento),
			    1,
			    BLANK()
			)
			```
		displayFolder: KPI Magazzino CD

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FiltroAttivo = ```
			
			VAR filtroGruppo = ISFILTERED(DIM_GruppiVendita[Gruppo])
			VAR filtroCat = ISFILTERED(FACT_MovimentiCG[CodiceCategoria])
			RETURN
			"Gruppo: " & IF(filtroGruppo, "✅", "❌") & 
			" | Categoria: " & IF(filtroCat, "✅", "❌")
			
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Giacenza Iniziale' = [Qta Magazzino CD Giacenza IPEM]
		displayFolder: KPI Magazzino CD

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition KPI_Magazzino = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
				    #"Rimosse colonne"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigazione
