table UTIL_DataflowQuery

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: Name

		annotation SummarizationSetBy = Automatic

	column Value
		dataType: string
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic

	partition UTIL_DataflowQuery = m
		mode: import
		queryGroup: DIM
		source =
				//==================================================
				// UTIL_DataflowQuery
				//==================================================

				let
				    Output =
				        [
				            FACT_Ordini = FACT_Ordini,
				            FACT_MovimentiCG = FACT_MovimentiCG,
				            FACT_DocumentoVendita = FACT_DocumentoVendita,
				            FACT_ContoDepositoOLD = FACT_ContoDepositoOLD,
				            FACT_Cambi = FACT_Cambi
				        ]
				in
				    Output

	annotation PBI_NavigationStepName = Navigazione

	annotation PBI_ResultType = Record
