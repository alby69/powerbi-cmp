table 'CALC_Previous Period'

	calculationGroup
		precedence: 2

		calculationItem Value = SELECTEDMEASURE()

		calculationItem 'Last DAY' =
				VAR NumOfInterval = { SELECTEDVALUE(TimeRange[TimeRange],BLANK()) }
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( CALENDARIO[Date], -NumOfInterval, DAY )
				)
				
				RETURN
				    Result

		calculationItem 'Last MONTH' =
				VAR NumOfInterval = { SELECTEDVALUE(TimeRange[TimeRange],BLANK()) }
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( CALENDARIO[Date], -NumOfInterval, MONTH )
				)
				
				RETURN
				    Result

		calculationItem 'Last QUARTER' =
				VAR NumOfInterval = { SELECTEDVALUE(TimeRange[TimeRange],BLANK()) }
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( CALENDARIO[Date], -NumOfInterval, QUARTER )
				)
				
				RETURN
				    Result

		calculationItem 'Last YEAR' =
				VAR NumOfInterval = { SELECTEDVALUE(TimeRange[TimeRange],BLANK()) }
				
				VAR Result =
				CALCULATE (
				    SELECTEDMEASURE(),
				    DATEADD ( CALENDARIO[Date], -NumOfInterval, YEAR )
				)
				
				RETURN
				    Result

	measure 'Value Previous' = SUMX('CALC_Previous Period','CALC_Previous Period'[Previous Period])
		formatString: 0

	column 'Previous Period'
		dataType: string
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		isHidden
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

