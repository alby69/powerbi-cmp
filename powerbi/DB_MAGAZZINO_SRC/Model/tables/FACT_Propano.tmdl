table FACT_Propano

	measure 'Costo Propano' = DIVIDE([Total Costs NAVI],[Qta Magazzino Acquisto IPEM CD])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Costo Propano' = [Total Costs NAVI]

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column QuantityIPEM
		formatString: #,0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Qta Ton IPEM]

		annotation SummarizationSetBy = Automatic

	column MonthInCalendar
		summarizeBy: none
		isNameInferred
		sourceColumn: DIM_Calendario[MonthInCalendar]

		annotation SummarizationSetBy = Automatic

	column CodiceMezzo
		summarizeBy: none
		isNameInferred
		sourceColumn: DIM_MezziTrasporto[CodiceMezzo]

		annotation SummarizationSetBy = Automatic

	column CodiceArticolo
		summarizeBy: none
		isNameInferred
		sourceColumn: DIM_Articoli[CodiceArticolo]

		annotation SummarizationSetBy = Automatic

	partition FACT_Propano = calculated
		mode: import
		source = ```
				
				VAR filtro_articolo = {"2","2T"}
				
				VAR tab_propano =
				        SUMMARIZECOLUMNS(
				            DIM_Calendario[MonthInCalendar],
				            DIM_MezziTrasporto[CodiceMezzo],
				            DIM_Articoli[CodiceArticolo],
				            FILTER(DIM_MezziTrasporto,LEFT(DIM_MezziTrasporto[CodiceMezzo],1) = "N" ),
				            TREATAS(filtro_articolo,DIM_Articoli[CodiceArticolo]),
				            "Qta Ton IPEM", [Qta Magazzino Acquisto IPEM CD]
				        )
				RETURN
				    FILTER(tab_propano,
				        [Qta Ton IPEM] > 0 && DIM_Calendario[MonthInCalendar] <> ""
				    )
				```

	annotation PBI_Id = 92ab77ab20124dcf865872b2038dc98a
