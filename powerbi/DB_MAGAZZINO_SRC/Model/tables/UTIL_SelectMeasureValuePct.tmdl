table UTIL_SelectMeasureValuePct

	calculationGroup
		precedence: 3

		calculationItem Value = SELECTEDMEASURE()

		calculationItem % =
				DIVIDE (
				    SELECTEDMEASURE(),
				    CALCULATE(
				        SELECTEDMEASURE(),
				        ALLSELECTED(DIM_Calendario)
				    )
				)

	column Measure
		dataType: string
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

