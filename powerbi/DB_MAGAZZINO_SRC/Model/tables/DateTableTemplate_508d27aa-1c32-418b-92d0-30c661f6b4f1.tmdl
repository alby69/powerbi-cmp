table DateTableTemplate_508d27aa-1c32-418b-92d0-30c661f6b4f1
	isHidden
	isPrivate

	column Date
		isHidden
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	column Anno = YEAR([Date])
		isHidden
		dataCategory: Years
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Year

	column NumMese = MONTH([Date])
		isHidden
		dataCategory: MonthOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = MonthNumber

	column Mese = FORMAT([Date], "MMMM")
		isHidden
		dataCategory: Months
		summarizeBy: none
		sortByColumn: NumMese

		annotation SummarizationSetBy = User

		annotation TemplateId = Month

	column NumTrimestre = INT(([NumMese] + 2) / 3)
		isHidden
		dataCategory: QuarterOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = QuarterNumber

	column Trimestre = "Trim " & [NumTrimestre]
		isHidden
		dataCategory: Quarters
		summarizeBy: none
		sortByColumn: NumTrimestre

		annotation SummarizationSetBy = User

		annotation TemplateId = Quarter

	column Giorno = DAY([Date])
		isHidden
		dataCategory: DayOfMonth
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Day

	hierarchy 'Gerarchia data'

		level Anno
			column: Anno

		level Trimestre
			column: Trimestre

		level Mese
			column: Mese

		level Giorno
			column: Giorno

		annotation TemplateId = DateHierarchy

	partition DateTableTemplate_508d27aa-1c32-418b-92d0-30c661f6b4f1-66845dae-5191-4a29-a06d-604f804b9949 = calculated
		mode: import
		source = Calendar(Date(2015,1,1), Date(2015,1,1))

	annotation __PBI_TemplateDateTable = true

	annotation DefaultItem = DateHierarchy

