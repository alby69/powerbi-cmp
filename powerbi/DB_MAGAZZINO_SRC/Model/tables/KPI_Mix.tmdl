table KPI_Mix

	measure '# Tassi Mese' =
			
			COUNTROWS ( ALLSELECTED ( FACT_Cambi ) )
		formatString: 0
		displayFolder: KPI Mix
		annotation PBI_Description = "Numero di tassi di cambio rilevati nel mese"

	measure 'Tasso Giorno' =
			
			VAR data_cur =
			    SELECTEDVALUE ( FACT_Ordini[DataSpedizione] )
			VAR tasso_cur =
			    CALCULATE (
			        SELECTEDVALUE ( FACT_Cambi[Tasso] ),
			        FILTER ( FACT_Cambi, FACT_Cambi[Data] = data_cur )
			    )
			VAR tasso_cur_succ =
			    CALCULATE (
			        SELECTEDVALUE ( FACT_Cambi[Tasso] ),
			        FILTER ( FACT_Cambi, FACT_Cambi[Data] = data_cur + 3 )
			    )
			RETURN
			    IF ( tasso_cur <> 0, tasso_cur, tasso_cur_succ )
		formatString: 0.0000
		displayFolder: KPI Mix
		annotation PBI_Description = "Tasso di cambio giornaliero (USD/EUR)"

	measure 'Tasso Medio Mese' =
			
			VAR nr =
			    COUNTROWS ( FACT_Cambi )
			VAR tot =
			    CALCULATE ( SUMX ( FACT_Cambi, FACT_Cambi[Tasso] ), FACT_Cambi )
			RETURN
			    DIVIDE ( tot, nr, 0 )
		formatString: 0.0000
		displayFolder: KPI Mix
		annotation PBI_Description = "Tasso di cambio medio mensile"

	measure 'Prezzo USD' =
			
			VAR cliente_mix = { SELECTEDVALUE ( DIM_Clienti[CodiceCliente], 0 ) }
			VAR filtro_anno = { SELECTEDVALUE ( DIM_Calendario[Year], 0 ) }
			VAR filtro_mese = { SELECTEDVALUE ( DIM_Calendario[MonthName], 0 ) }
			
			VAR tab_filtro =
			    FILTER (
			        FACT_PrezziMix,
			        'FACT_PrezziMix'[Cliente] IN cliente_mix
			                && (
			                    FORMAT ( YEAR ( FACT_PrezziMix[Data] ), "String" )
			                        IN filtro_anno
			                            || MONTH ( FACT_PrezziMix[Data] ) IN filtro_mese
			                )
			    )
			VAR prezzo =
			    SELECTCOLUMNS ( tab_filtro, "Prezzo", FACT_PrezziMix[Prezzo USD] )
			RETURN
			    prezzo

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NR ATB Giorno' =
			
			COUNT ( FACT_Ordini[CodiceOrdine] )
		formatString: 0

	measure 'Prezzo Euro' =
			
			VAR cliente_mix =
			    SELECTEDVALUE ( FACT_Ordini[CodiceClienteFatturazione] )
			VAR base_cliente =
			    SELECTEDVALUE ( FACT_Ordini[CodiceDeposito] )
			VAR sono_TOTAL =
			    OR ( cliente_mix = "C00991", base_cliente = "TOTAL" )
			VAR sono_MITSUI =
			    OR ( cliente_mix = "C01049", base_cliente = "MITSUI" )
			RETURN
			    IF (
			        OR ( sono_TOTAL, sono_MITSUI ),
			        SWITCH (
			            TRUE (),
			            sono_TOTAL, DIVIDE ( [Prezzo USD], [Tasso Medio Mese], 0 ),
			            sono_MITSUI, DIVIDE ( [Prezzo USD], [Tasso Giorno], 0 )
			        ),
			        BLANK ()
			    )
		displayFolder: KPI Mix
		annotation PBI_Description = "Prezzo in Euro calcolato in base al cliente (MITSUI tasso giorno, TOTAL tasso mese)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta BIL' = ```
			
			CALCULATE(
			    SUMX(
			        FILTER(
			            FACT_Ordini,
			            LEFT(FACT_Ordini[CodiceOrdine], 3) = "ODA"
			        ),
			        IF(FACT_Ordini[Quantity] >= 1000,
			            DIVIDE(FACT_Ordini[Quantity], 1000, 0),
			            FACT_Ordini[Quantity]
			        )
			    )
			)
			```
		displayFolder: KPI Mix
		annotation PBI_Description = "Quantità BIL in tonnellate (da ordini ODA)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Resa' =
			
			
			VAR qta =
			    SUMX(
			        FILTER(
			            FACT_Ordini,
			            LEFT(FACT_Ordini[CodiceOrdine], 3) = "ODA"
			        ),
			        IF(FACT_Ordini[NetWeight] >= 1000,
			            DIVIDE(FACT_Ordini[NetWeight], 1000, 0),
			            FACT_Ordini[NetWeight]
			        )
			    )
			RETURN
			    qta
		displayFolder: KPI Mix
		annotation PBI_Description = "Quantità RESA in tonnellate (da ordini ODA)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo USD' =
			
			SUMX ( VALUES ( DIM_Calendario[MonthName] ), [Prezzo USD MIX] * [Qta BIL] )
		displayFolder: KPI Mix
		annotation PBI_Description = "Importo totale in USD per il Mix"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Accisa Unitario' =
			
			SUMX ( FACT_Ordini, FACT_Ordini[Accisa])
		displayFolder: KPI Mix
		annotation PBI_Description = "Accisa unitaria per tonnellata"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Accisa' =
			
			SUMX ( VALUES ( DIM_Calendario[MonthName] ), [Accisa Unitario] * [Qta BIL] )
		displayFolder: KPI Mix
		annotation PBI_Description = "Importo totale accisa"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trasporto Unitario' =
			
			VAR base_cliente =
			    SELECTEDVALUE ( FACT_Ordini[CodiceDeposito] )
			RETURN
			    SWITCH (
			        TRUE (),
			        base_cliente IN { "MITSUI", "TOTAL" }, 0,
			        base_cliente = "IPEM", 23,
			        0
			    )
		formatString: 0
		displayFolder: KPI Mix
		annotation PBI_Description = "Costo di trasporto unitario per tonnellata"

	measure 'Importo Trasporto' =
			
			[Trasporto Unitario] * [Qta BIL]
		displayFolder: KPI Mix
		annotation PBI_Description = "Importo totale trasporto"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo Totale' =
			
			KPI_Mix[Importo Euro] + KPI_Mix[Importo Trasporto]
		displayFolder: KPI Mix
		annotation PBI_Description = "Costo totale (Importo + Trasporto)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo Unitario' =
			
			DIVIDE ( [Costo Totale], [Qta BIL], 0 )
		displayFolder: KPI Mix
		annotation PBI_Description = "Costo unitario per tonnellata"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nome Spedizioniere' =
			
			CALCULATE (
			    FIRSTNONBLANK ( DIM_Spedizionieri[Name], 1 ),
			    FILTER (
			        DIM_Spedizionieri,
			        DIM_Spedizionieri[CodiceSpedizioniere] = SELECTEDVALUE ( FACT_Ordini[CodiceSpedizioniere] )
			    )
			)

	measure 'Tasso Giorno Medio' =
			
			AVERAGEX ( VALUES ( DIM_Calendario[Date] ), [Tasso Giorno] )
		formatString: 0.0000

	measure 'Costo €/T NEW' =
			
			IF (
			    HASONEVALUE ( FACT_Ordini[DataSpedizione] ),
			    [Costo €/T],
			    AVERAGEX ( VALUES ( FACT_Ordini[DataSpedizione] ), [Costo €/T] )
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo USD Mese' =
			
			AVERAGEX ( VALUES ( FACT_Ordini[DataSpedizione] ), [Prezzo USD MIX] )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo €/T Medio' =
			
			AVERAGEX ( VALUES ( DIM_Calendario[MonthInCalendar] ), [Costo €/T] )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Euro' =
			
			[Prezzo € MIX Mese] * [Qta BIL]
		displayFolder: KPI Mix
		annotation PBI_Description = "Importo totale in Euro per il Mix"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo MIX' =
			[Costo Tab MIX]
			/*
			VAR curr_cli = { SELECTEDVALUE(ClientiFattFiltrati[No_]) }
			
			RETURN
			    IF(HASONEVALUE(ClientiFattFiltrati[No_]),
			        CALCULATE(
			            AVERAGEX('Tab Costo MIX','Tab Costo MIX'[Costo]),
			            FILTER('Tab Costo MIX',
			                'Tab Costo MIX'[Cliente Fatturazione] IN curr_cli
			            )
			        ),
			        AVERAGEX('Tab Costo MIX','Tab Costo MIX'[Costo])
			    )
			*/
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo USD MIX' =
			
			AVERAGEX ( FACT_PrezziMix, FACT_PrezziMix[Prezzo USD] )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo MIX 2' =
			
			CALCULATE (
			    [Costo €/T],
			    FILTER (
			        FACT_Ordini,
			        FACT_Ordini[CodiceClienteFatturazione]
			            IN { "C00991", "C01049" }
			            && FACT_Ordini[CodiceArticolo] IN { "1", "1T" }
			    )
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo € MIX' = ```
			DIVIDE ( [Prezzo USD MIX], [Tasso Giorno Cliente], 0 )
			/*
			VAR cliente_mix =
			    SELECTEDVALUE ( 'ACQUISTO RIGHE'[Cliente Fatturazione] )
			VAR base_cliente =
			    SELECTEDVALUE ( 'ACQUISTO RIGHE'[Ubicazione] )
			VAR sono_TOTAL =
			    OR ( cliente_mix = "C00991", base_cliente = "TOTAL" )
			VAR sono_MITSUI =
			    OR ( cliente_mix = "C01049", base_cliente = "MITSUI" )
			VAR prezzo =
			    IF (
			        OR ( sono_TOTAL, sono_MITSUI ),
			        SWITCH (
			            TRUE (),
			            sono_TOTAL, DIVIDE ( [Prezzo USD MIX], [Tasso Medio Mese], 0 ),
			            sono_MITSUI, DIVIDE ( [Prezzo USD MIX], [Tasso Giorno Medio], 0 )
			        ),
			        BLANK ()
			    )
			RETURN
			    prezzo
			*/    
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo € MIX Mese' =
			
			
			AVERAGEX (
			    VALUES(DIM_Clienti[Nome & Codice]),
			    [Prezzo € MIX]
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo Totale Mese' =
			
			SUMX ( VALUES ( FACT_Ordini[DataSpedizione] ), [Costo Totale] )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tasso Giorno Medio 2' =
			
			IF ( HASONEVALUE ( DIM_Calendario[MonthName] ), [Tasso Giorno Medio], [Tasso Medio Mese] )
		formatString: 0.0000

		changedProperty = FormatString

	measure 'Tasso Mese 2' = ```
			
			
			VAR anno_curr = VALUE({ SELECTEDVALUE ( DIM_Calendario[Year] ) })
			VAR mese_curr = VALUE({SELECTEDVALUE ( DIM_Calendario[MonthnYear] )})
			   
			VAR nr =
			    CALCULATE (
			        COUNTROWS ( ALLSELECTED ( FACT_Cambi[Data] ) ),
			        YEAR(FACT_Cambi[Data]) = anno_curr &&
			        MONTH( FACT_Cambi[Data] ) = mese_curr
			    )
			VAR tot =
			    CALCULATE ( SUMX ( FACT_Cambi, FACT_Cambi[Tasso] ), ALLSELECTED ( FACT_Cambi ) )
			
			RETURN
			    {DIVIDE(tot,nr,0)}
			    
			```
		formatString: 0

	measure 'Tasso Giorno Cliente' =
			
			VAR cliente_mix =
			    SELECTEDVALUE ( DIM_Clienti[CodiceCliente] )
			VAR base_cliente =
			    SELECTEDVALUE ( DIM_Deposito[CodiceDeposito] )
			VAR sono_TOTAL =
			    OR ( cliente_mix = "C00991", base_cliente = "TOTAL" )
			VAR sono_MITSUI =
			    OR ( cliente_mix = "C01049", base_cliente = "MITSUI" )
			RETURN
			    IF (
			        OR ( sono_TOTAL, sono_MITSUI ),
			        SWITCH (
			            TRUE (),
			            sono_TOTAL, [Tasso Medio Mese],
			            sono_MITSUI, [Tasso Giorno Medio]
			        ),
			        BLANK ()
			    )
		formatString: 0.0000

		changedProperty = FormatString

	measure '# Qta_BIL' = COUNT(FACT_Ordini[CodiceOrdine])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta BIL (2)' =
			
			CALCULATE(
			    SUMX(FACT_Ordini,FACT_Ordini[Quantity]),
			    FILTER(
			            FACT_Ordini,
			            LEFT(FACT_Ordini[CodiceOrdine], 3) = "ODA"
			        )
			    )
		displayFolder: KPI Mix

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Spedizionieri Attivi' =
			
			IF(
			    CALCULATE(
			        COUNTROWS(FACT_Ordini),
			        FACT_Ordini[CodiceArticolo] IN {"1", "1T"}
			    ) > 0,
			    SELECTEDVALUE(DIM_Spedizionieri[Name])
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ordini MIX' =
			
			CALCULATE(
			    COUNTROWS(FACT_Ordini),
			    FILTER(FACT_Ordini,
			    FACT_Ordini[CodiceArticolo] IN {"1", "1T"} &&
			    FACT_Ordini[CodiceClienteVendita] IN {"C00991","C01049"}
			    )
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Acquisto MIX Tempa' = SUMX(FACT_AcquistiMixTemp,FACT_AcquistiMixTemp[Qta])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Qta Acquisto MIX Tempa' = COUNTX(FACT_AcquistiMixTemp,FACT_AcquistiMixTemp[Qta])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ANALISI_MIX-dddb181b-4aa3-428d-9cff-c9bc04599ccd = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
				    #"Rimosse colonne"

	annotation PBI_ResultType = Table

