table KPI_Vendite

	measure 'Total Sales' =
			
			[Importo Vendita]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Gestione MARGINI

	measure 'Total Profits Customer' =
			
			[Total Sales] - [Total Costs Customer]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Gestione MARGINI

	measure 'Total Costs' =
			
			[Importo Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

	measure 'Profit Margins Customer' =
			
			DIVIDE ( [Total Profits Customer], [Total Sales], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

	measure 'Profit Margins Customer LY' =
			
			CALCULATE ( [Profit Margins Customer], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

	measure 'Margin Growth %' =
			
			DIVIDE (
			    [Profit Margins Customer] - [Profit Margins Customer LY],
			    [Profit Margins Customer LY],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Clienti_Fatt_Vendita","TableItemName":"Nome & Codice (cluster)","ObjectType":4},"LinkType":"UsedInGroup"}]

	measure 'YoY Growth %' =
			
			DIVIDE ( [Total Sales] - [Total Sales LY], [Total Sales LY], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Clienti_Fatt_Vendita","TableItemName":"Nome & Codice (cluster)","ObjectType":4},"LinkType":"UsedInGroup"}]

	measure 'Total Sales LY' =
			
			CALCULATE ( [Total Sales], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

	measure 'Total Profits Customer LY' =
			
			CALCULATE ( [Total Profits Customer], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

	measure 'Total Costs Customer' =
			
			[Qta Vendita] * [CMP Acquisto Prodotto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Gestione MARGINI

		changedProperty = FormatString

	measure 'Importo Vendite LM' =
			
			CALCULATE ( [Importo Vendite], DATEADD ( DIM_Calendario[Date], -1, MONTH ) )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite LY' =
			
			CALCULATE ( [Importo Vendite], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite -2M' =
			
			CALCULATE ( [Importo Vendite], DATEADD ( DIM_Calendario[Date], -2, MONTH ) )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite MTD' =
			
			TOTALMTD ( [Importo Vendite], DIM_Calendario[Date] )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite LM MTD' =
			
			TOTALMTD ( [Importo Vendite LM], DIM_Calendario[Date] )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite -2M MTD' =
			
			TOTALMTD ( [Importo Vendite -2M], DIM_Calendario[Date] )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite YTD' =
			
			TOTALYTD ( [Importo Vendite], DIM_Calendario[Date] )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite LY YTD' =
			
			TOTALYTD ( [Importo Vendite LY], DIM_Calendario[Date] )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite -2Y' =
			
			CALCULATE ( [Importo Vendite], DATEADD ( DIM_Calendario[Date], -2, YEAR ) )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite -2Y YTD' =
			
			TOTALYTD ( [Importo Vendite -2Y], DIM_Calendario[Date] )
		displayFolder: TIME

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nuovi Clienti' = ```
			
			// Calcola nr di clienti che hanno acquistato in un certo mese e non acquistano da nr_giorni
			VAR nr_giorni = SELECTEDVALUE(NrGiorni[NrGiorni],90)
			VAR Tab_Clienti = VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione] )
			
			VAR Clienti_Precedenti =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - nr_giorni && 
			            DIM_Calendario[Date] < MIN ( DIM_Calendario[Date] )
			        )
			    )
			RETURN
			    COUNTROWS (
			        EXCEPT ( Tab_Clienti, Clienti_Precedenti )
			        // estrae nr Clienti in Tab_Clienti ma non presenti in Clienti_Precedenti
			    )
			```
		formatString: 0
		displayFolder: CHURNING

	measure 'Clienti Persi' =
			
			// Clienti che non acquistano da 365 giorni si considerano persi
			VAR nr_giorni = 60
			VAR Tab_Clienti_Vendita = VALUES ('FACT_DocumentoVendita'[Codice Cliente Fatturazione]  )
			
			VAR Tab_Clienti_Attivi =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - 365 &&
			            DIM_Calendario[Date] <= MIN ( DIM_Calendario[Date] ) - nr_giorni
			        )
			    )
			VAR Clienti_Precedenti =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - nr_giorni &&
			            DIM_Calendario[Date] <= MIN ( DIM_Calendario[Date] )
			        )
			    )
			RETURN
			    COUNTROWS ( EXCEPT ( Tab_Clienti_Attivi, Clienti_Precedenti ) ) * -1
		formatString: 0
		displayFolder: CHURNING

	measure 'Data Ultimo Acquisto Cliente' = LASTDATE('FACT_DocumentoVendita'[Data Spedizione])
		displayFolder: CHURNING

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Ultimo Acquisto' = ```
			
			    MAXX(
			        ALL('FACT_DocumentoVendita'),
			       'FACT_DocumentoVendita'[Data Spedizione]
			    )
			```
		displayFolder: CHURNING

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Giorni da ultimo Acquisto' = ```
			
			    IF(
			        ISBLANK([Data Ultimo Acquisto Cliente]),
			        BLANK(),
			        VALUE([Data Ultimo Acquisto] - [Data Ultimo Acquisto Cliente] )
			    )
			```
		formatString: 0
		displayFolder: CHURNING

		changedProperty = FormatString

	measure 'Clienti Persi 2' = ```
			
			// Sono Clienti che non hanno acquistato negli ultimi nr_days, ma hanno acquistato prima
			
			VAR Lista_Clienti = ALL('FACT_DocumentoVendita'[Codice Cliente Fatturazione])
			VAR nr_days = SELECTEDVALUE(NrGiorni[NrGiorni],90)
			
			VAR tab_data = 
			    FILTER(
			        ALLSELECTED(CALENDARIO),
			        DIM_Calendario[Date] > ( MIN(DIM_Calendario[Date]) - nr_days ) &&
			        DIM_Calendario[Date] < MIN(DIM_Calendario[Date])
			    )
			VAR tab_clienti_persi = 
			    FILTER(
			        Lista_Clienti,
			        CALCULATE(
			            COUNTROWS('FACT_DocumentoVendita'),
			            tab_data
			        ) = 0
			    )
			
			RETURN
			    COUNTROWS(tab_clienti_persi)
			```
		displayFolder: CHURNING

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nuovi Clienti 2' = ```
			
			// Sono Clienti che hanno acquistato negli ultimi nr_days, ma NON hanno acquistato prima
			
			VAR Lista_Clienti = VALUES('FACT_DocumentoVendita'[Codice Cliente Fatturazione])
			VAR nr_days = SELECTEDVALUE(NrGiorni[NrGiorni],90)
			
			VAR tab_data = 
			    FILTER(
			        ALLSELECTED(CALENDARIO),        
			        DIM_Calendario[Date] < MIN(DIM_Calendario[Date])
			    )
			
			VAR tab_clienti_nuovi = 
			    FILTER(
			        Lista_Clienti,
			        CALCULATE(
			            COUNTROWS('FACT_DocumentoVendita'),
			            tab_data
			        ) = 0
			    )
			
			RETURN
			    CALCULATE(
			        COUNTROWS(VALUES('FACT_DocumentoVendita'[Codice Cliente Fatturazione])),
			            tab_clienti_nuovi
			    )
			
			
			```
		displayFolder: CHURNING

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clienti Ritornati' = ```
			
			
			// Sono Clienti che hanno acquistato negli ultimi nr_days e anche prima
			
			VAR Lista_Clienti = VALUES('FACT_DocumentoVendita'[Codice Cliente Fatturazione])
			VAR nr_days = SELECTEDVALUE(NrGiorni[NrGiorni],90)
			
			VAR tab_data =
			    FILTER(
			        ALLSELECTED(CALENDARIO),
			        DIM_Calendario[Date] > ( MIN(DIM_Calendario[Date]) - nr_days ) &&
			        DIM_Calendario[Date] < MIN(DIM_Calendario[Date])
			    )
			
			
			VAR tab_clienti_ritornati = 
			    FILTER(
			        Lista_Clienti,
			        CALCULATE(
			            COUNTROWS('FACT_DocumentoVendita'),
			            tab_data
			        ) = 0
			    )
			
			RETURN
			    COUNTROWS(tab_clienti_ritornati)
			// valuta nr_clienti ritornati se non ci sono vendite negli ultimi nr_days
			```
		displayFolder: CHURNING

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Ton Vendita' =
			
			CALCULATE (
			    ABS ( [Qta Ton] ),
			    FILTER ( MAGAZZINO, FACT_Magazzino[Movimento] = "Vendita" )
			)
		formatString: #,0.00

		changedProperty = FormatString

	measure 'Prezzo Vendite' = ```
			
			 CALCULATE(
			    AVERAGEX(
			        'FACT_DocumentoVendita',
			        'FACT_DocumentoVendita'[Prezzo Unitario]),
			    'FACT_DocumentoVendita'[Categoria] IN {"NAZ","UE","NAZPERM"}
			 )
			
			/*        
			VAR filtro_vendite =
			    { SELECTEDVALUE ( DIM_GruppiVendita[Gruppo], BLANK () ) }
			RETURN
			    IF (
			        filtro_vendite = "PASSAGGIO",
			        [Prezzo Passaggio],
			        [Prezzo Netto Doc Vendita] - [Prezzo Trasporto Doc Vendita]
			    )
			*/    
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cliente Rank' =
			
			RANKX ( ALL ( CLIENTI ), [Importo Vendita],, DESC )
		formatString: 0

	measure 'Top 10 Clienti Vendite' =
			
			IF (
			    ISFILTERED ( DIM_Clienti[Nome] ),
			    IF ( [Cliente Rank] <= 10, [Importo Vendite CG], BLANK () ),
			    CALCULATE (
			        [Importo Vendite CG],
			        TOPN ( 10, VALUES ( DIM_Clienti[Nome] ), [Importo Vendite CG] )
			    )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0

	measure 'Importo Vendite CG' =
			
			IF (
			    [Importo Clienti Vendite] <> 0,
			    [Importo Clienti Vendite],
			    //[Importo Clienti Vendite] - [Recupero Spese Trasporto],
			    [Importo Clienti Passaggi]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

	measure 'Importo Clienti Passaggi' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER (
			        MOVCG,
			        FACT_MovimentiCG[Conto] IN { "3100001", "3100002", "3100003", "3100004" }
			    )
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Clienti Vendite' = ```
			
			//VAR filtro_conti = {"3000002","3000003","3000004","3000005"}
			VAR filtro_conti = { "3000002", "3000003", "3000005" }
			VAR filtro_anno =
			    { SELECTEDVALUE ( DIM_Calendario[Year], 0 ) }
			VAR filtro_mese =
			    { SELECTEDVALUE ( DIM_Calendario[MonthName], 0 ) }
			VAR filtro_cliente =
			    { SELECTEDVALUE ( DIM_Clienti[Nome] ) }
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[Gruppo Articolo] ) }
			VAR filtro_doc =
			    { SELECTEDVALUE ( 'FACT_DocumentoVendita'[Documento] ) }
			VAR filtro_progetto =
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "PROPANO", "PROPAN",
			        filtro_gruppo = "MIX", "MIX",
			        filtro_gruppo = BLANK (), BLANK ()
			    )
			VAR tab_filtro =
			    FILTER (
			        'MOVCG',
			        //FORMAT(YEAR(FACT_MovimentiCG[Document Date]),"String") IN filtro_anno &&
			        FACT_MovimentiCG[Conto]
			            IN filtro_conti
			            && //FACT_MovimentiCG[Source No_] IN filtro_cliente ||
			        FACT_MovimentiCG[Progetto] = filtro_progetto
			            && //FORMAT(MONTH(FACT_MovimentiCG[Document Date]),"String") IN filtro_mese ||                                    
			        //FACT_MovimentiCG[Document No_] = filtro_doc ||            
			        FACT_MovimentiCG[Tipo Documento]
			            IN { "Fattura", "Nota Credito" }
			    ) /*
			VAR tab_filtro = 
					FILTER(
						ALL('MOVCG'),
			            //MOVCG,
			            FORMAT(YEAR(FACT_MovimentiCG[Document Date]),"String") IN filtro_anno &&
			            FACT_MovimentiCG[Conto CG] IN filtro_conti &&
			            FACT_MovimentiCG[Source No_] IN filtro_cliente ||
			            FACT_MovimentiCG[Progetto] = filtro_progetto ||            
			            FORMAT(MONTH(FACT_MovimentiCG[Document Date]),"String") IN filtro_mese ||                                    
			            //FACT_MovimentiCG[Document No_] = filtro_doc ||            
			            FACT_MovimentiCG[Document Type] IN {"Fattura","Nota Credito"}                                   
			            
			        )
			*/
			VAR importo =
			    CALCULATE ( ABS ( [Importo] ), tab_filtro )
			RETURN
			    importo
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo Dirette' =
			
			DIVIDE ( [Importo Clienti Vendite], [Qta Ton Vendita], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

	measure 'Prezzo Passaggio' =
			
			DIVIDE ( [Importo Clienti Passaggi], [Qta Ton Vendita], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

	measure 'Total Costs CUM ALL' =
			
			CALCULATE (
			    [Total Costs NAVI],
			    FILTER ( ALL ( CALENDARIO ), DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] ) )
			)

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tot Clienti Vendita' =
			
			VAR Tab_Clienti_Vendita =
			    CALCULATETABLE (
			        VALUES ( MOV_VAL[Codice] ),
			        FILTER ( MOV_VAL, MOV_VAL[Tipo Movimento] = "Vendita" )
			    )
			RETURN
			    COUNTROWS ( Tab_Clienti_Vendita )
		formatString: 0

	measure 'Importo Vendite x Gruppo Cliente' =
			
			CALCULATE (
			    [Importo Vendite CG],
			    FILTER (
			        VALUES ( FACT_MovimentiCG[Importo] ),
			        COUNTROWS (
			            FILTER (
			                'Gruppo Vendite Clienti',
			                FACT_MovimentiCG[Importo] >= MIN ( 'Gruppo Vendite Clienti'[Min] )
			                    && FACT_MovimentiCG[Importo] < MAX ( 'Gruppo Vendite Clienti'[Max] )
			            )
			        ) > 0
			    )
			)

	measure 'Qta Ton Vendite Progr' =
			
			VAR tab_filtro =
			    FILTER (
			        ALL ( DIM_Calendario[Date] ),
			        DIM_Calendario[Date] >= DATE ( 2015, 1, 1 )
			            && DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE ( [Qta Ton Vendita], tab_filtro )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Vendite MIX' = ```
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[Gruppo Articolo], BLANK () ) }
			VAR filtro_calendario =
			    { SELECTEDVALUE ( DIM_Calendario[MonthInCalendar] ) }
			VAR tab_articolo =
			    CALCULATETABLE ( ARTICOLI, DIM_Articoli[Gruppo Articolo] IN filtro_gruppo )
			VAR filtro_articolo =
			    SELECTCOLUMNS ( tab_articolo, "@Articolo", DIM_Articoli[Codice Articolo] )
			VAR tab_filtro =
			    FILTER (
			        'FACT_Mix',
			        'FACT_Mix'[Codice Articolo]
			            IN filtro_articolo
			            && 'FACT_Mix'[MonthInCalendar] IN filtro_calendario
			    ) /*
			VAR imp_prezzo = 
			        SUMX(
			            tab_filtro,
			            'FACT_Mix'[Importo Costo]        
			        )
			VAR qta_prezzo = 
			        SUMX(
			            tab_filtro,
			            'FACT_Mix'[Qta BIL]        
			        )
			*/
			RETURN
			    //DIVIDE(imp_prezzo,qta_prezzo,0)
			    AVERAGEX (
			        tab_filtro,
			        'FACT_Mix'[Prezzo € Mese]
			    )
			```

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Permute' = [CMP Acquisto]

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite' = [Qta Vendita] * [Prezzo Vendite]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo Vendite YTD' =
			
			TOTALYTD ( [Prezzo Vendite], DIM_Calendario[Date] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Vendite OLD2' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[Gruppo Articolo], BLANK () ) }
			VAR filtro_vendite =
			    { SELECTEDVALUE ( DIM_GruppiVendita[Codice Categoria], BLANK () ) }
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", [Importo Clienti Vendite],
			        filtro_gruppo = "PROPANO",
			            SWITCH (
			                TRUE (),
			                filtro_vendite = "DIRETTE", KPI_Vendite[Importo Clienti Vendite],
			                filtro_vendite = "PASSAGGIO", KPI_Vendite[Importo Clienti Passaggi],
			                filtro_vendite = "PERMUTE", BLANK ()
			            ),
			        filtro_gruppo = BLANK (), BLANK ()
			    )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo Vendite CG' =
			
			DIVIDE ( KPI_Vendite[Importo Vendite CG], [Qta Ton Vendita], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Qta Ton Vendita LY' =
			
			CALCULATE ( [Qta Ton Vendita], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Vendite QTD' =
			
			TOTALQTD ( [Prezzo Vendite], DIM_Calendario[Date] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'CDV Vendite' =
			
			[Qta Doc Vendita Articolo] * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '# Clienti' = DISTINCTCOUNT('FACT_DocumentoVendita'[Codice Cliente Fatturazione])

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite Nuovi Clienti' = ```
			
			// Calcola vendite di clienti che hanno acquistato in un certo mese e non acquistano da nr_giorni
			VAR nr_giorni = SELECTEDVALUE(NrGiorni[NrGiorni],90)
			VAR Tab_Clienti = VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione] )
			
			VAR Clienti_Precedenti =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - nr_giorni && 
			            DIM_Calendario[Date] < MIN ( DIM_Calendario[Date] )
			        )
			    )
			RETURN
			    CALCULATE( 
			        [Importo Vendita],
			        EXCEPT ( Tab_Clienti, Clienti_Precedenti )
			    )
			```
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: CHURNING

		changedProperty = FormatString

	measure '% Importo Vendite Nuovi Clienti' = DIVIDE([Importo Vendite Nuovi Clienti],[Importo Vendita],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CHURNING

		changedProperty = FormatString

	measure '% Nuovi Clienti' = DIVIDE([Nuovi Clienti],[# Clienti],0)
		displayFolder: CHURNING

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite CMP Giacenza' = [Qta Vendita] * [CMP Giacenza]

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ANALISI_VENDITE-2eaa7963-9991-4913-9872-c4938329fe39 = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
				    #"Rimosse colonne"

	annotation PBI_ResultType = Table

