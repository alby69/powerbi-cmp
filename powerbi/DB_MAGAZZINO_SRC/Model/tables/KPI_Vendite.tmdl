table KPI_Vendite

	measure 'Importo Vendite (Doc)' =
			
			[Importo Vendita]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Margine
		annotation PBI_Description = "Importo vendite basato su documenti di vendita"

	measure 'Margine Cliente' =
			
			[Importo Vendite (Doc)] - [Costo Venduto Cliente]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Margine
		annotation PBI_Description = "Margine calcolato come differenza tra vendite e costo venduto"

	measure 'Importo Acquisti' =
			
			[Importo Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Margine
		annotation PBI_Description = "Importo totale acquisti"

		changedProperty = FormatString

	measure '% Margine Cliente' =
			
			DIVIDE ( [Margine Cliente], [Importo Vendite (Doc)], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Margine
		annotation PBI_Description = "Percentuale di margine sul cliente"

		changedProperty = FormatString

	measure '% Margine Cliente LY' =
			
			CALCULATE ( [% Margine Cliente], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Margine
		annotation PBI_Description = "Percentuale di margine sul cliente dello scorso anno"

		changedProperty = FormatString

	measure '% Crescita Margine' =
			
			DIVIDE (
			    [% Margine Cliente] - [% Margine Cliente LY],
			    [% Margine Cliente LY],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Margine
		annotation PBI_Description = "Percentuale di crescita del margine rispetto allo scorso anno"

		changedProperty = FormatString

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Clienti_Fatt_Vendita","TableItemName":"Nome & Codice (cluster)","ObjectType":4},"LinkType":"UsedInGroup"}]

	measure '% Crescita YoY' =
			
			DIVIDE ( [Importo Vendite (Doc)] - [Importo Vendite (Doc) LY], [Importo Vendite (Doc) LY], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Margine
		annotation PBI_Description = "Percentuale di crescita delle vendite anno su anno"

		changedProperty = FormatString

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Clienti_Fatt_Vendita","TableItemName":"Nome & Codice (cluster)","ObjectType":4},"LinkType":"UsedInGroup"}]

	measure 'Importo Vendite (Doc) LY' =
			
			CALCULATE ( [Importo Vendite (Doc)], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Margine
		annotation PBI_Description = "Importo vendite dello scorso anno"

		changedProperty = FormatString

	measure 'Margine Cliente LY' =
			
			CALCULATE ( [Margine Cliente], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Margine
		annotation PBI_Description = "Margine cliente dello scorso anno"

		changedProperty = FormatString

	measure 'Costo Venduto Cliente' =
			
			[Qta Vendita] * [CMP Acquisto Prodotto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Margine
		annotation PBI_Description = "Costo del venduto calcolato su quantità venduta e CMP"

		changedProperty = FormatString


	measure '# Nuovi Clienti' = ```
			
			// Calcola nr di clienti che hanno acquistato in un certo mese e non acquistano da nr_giorni
			VAR nr_giorni = SELECTEDVALUE(PARAM_NrGiorni[PARAM_NrGiorni],90)
			VAR Tab_Clienti = VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione] )
			
			VAR Clienti_Precedenti =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[CodiceClienteFatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - nr_giorni && 
			            DIM_Calendario[Date] < MIN ( DIM_Calendario[Date] )
			        )
			    )
			RETURN
			    COUNTROWS (
			        EXCEPT ( Tab_Clienti, Clienti_Precedenti )
			        // estrae nr Clienti in Tab_Clienti ma non presenti in Clienti_Precedenti
			    )
			```
		formatString: 0
		displayFolder: KPI Churn
		annotation PBI_Description = "Numero di nuovi clienti che non acquistavano da N giorni"

	measure '# Clienti Persi' =
			
			// Clienti che non acquistano da 365 giorni si considerano persi
			VAR nr_giorni = 60
			VAR Tab_Clienti_Vendita = VALUES ('FACT_DocumentoVendita'[CodiceClienteFatturazione]  )
			
			VAR Tab_Clienti_Attivi =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[CodiceClienteFatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - 365 &&
			            DIM_Calendario[Date] <= MIN ( DIM_Calendario[Date] ) - nr_giorni
			        )
			    )
			VAR Clienti_Precedenti =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[CodiceClienteFatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - nr_giorni &&
			            DIM_Calendario[Date] <= MIN ( DIM_Calendario[Date] )
			        )
			    )
			RETURN
			    COUNTROWS ( EXCEPT ( Tab_Clienti_Attivi, Clienti_Precedenti ) ) * -1
		formatString: 0
		displayFolder: KPI Churn
		annotation PBI_Description = "Numero di clienti persi (non acquistano da 365 giorni)"

	measure 'Data Ultimo Acquisto Cliente' = LASTDATE('FACT_DocumentoVendita'[Data Spedizione])
		displayFolder: KPI Churn

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Ultimo Acquisto' = ```
			
			    MAXX(
			        ALL('FACT_DocumentoVendita'),
			       'FACT_DocumentoVendita'[DataSpedizione]
			    )
			```
		displayFolder: KPI Churn

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Giorni da ultimo Acquisto' = ```
			
			    IF(
			        ISBLANK([Data Ultimo Acquisto Cliente]),
			        BLANK(),
			        VALUE([Data Ultimo Acquisto] - [Data Ultimo Acquisto Cliente] )
			    )
			```
		formatString: 0
		displayFolder: KPI Churn

		changedProperty = FormatString

	measure '# Clienti Persi (2)' = ```
			
			// Sono Clienti che non hanno acquistato negli ultimi nr_days, ma hanno acquistato prima
			
			VAR Lista_Clienti = ALL('FACT_DocumentoVendita'[Codice Cliente Fatturazione])
			VAR nr_days = SELECTEDVALUE(PARAM_NrGiorni[PARAM_NrGiorni],90)
			
			VAR tab_data = 
			    FILTER(
			        ALLSELECTED(DIM_Calendario),
			        DIM_Calendario[Date] > ( MIN(DIM_Calendario[Date]) - nr_days ) &&
			        DIM_Calendario[Date] < MIN(DIM_Calendario[Date])
			    )
			VAR tab_clienti_persi = 
			    FILTER(
			        Lista_Clienti,
			        CALCULATE(
			            COUNTROWS('FACT_DocumentoVendita'),
			            tab_data
			        ) = 0
			    )
			
			RETURN
			    COUNTROWS(tab_clienti_persi)
			```
		displayFolder: KPI Churn

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Nuovi Clienti (2)' = ```
			
			// Sono Clienti che hanno acquistato negli ultimi nr_days, ma NON hanno acquistato prima
			
			VAR Lista_Clienti = VALUES('FACT_DocumentoVendita'[Codice Cliente Fatturazione])
			VAR nr_days = SELECTEDVALUE(PARAM_NrGiorni[PARAM_NrGiorni],90)
			
			VAR tab_data = 
			    FILTER(
			        ALLSELECTED(DIM_Calendario),
			        DIM_Calendario[Date] < MIN(DIM_Calendario[Date])
			    )
			
			VAR tab_clienti_nuovi = 
			    FILTER(
			        Lista_Clienti,
			        CALCULATE(
			            COUNTROWS('FACT_DocumentoVendita'),
			            tab_data
			        ) = 0
			    )
			
			RETURN
			    CALCULATE(
			        COUNTROWS(VALUES('FACT_DocumentoVendita'[CodiceClienteFatturazione])),
			            tab_clienti_nuovi
			    )
			
			
			```
		displayFolder: KPI Churn

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Clienti Ritornati' = ```
			
			
			// Sono Clienti che hanno acquistato negli ultimi nr_days e anche prima
			
			VAR Lista_Clienti = VALUES('FACT_DocumentoVendita'[Codice Cliente Fatturazione])
			VAR nr_days = SELECTEDVALUE(PARAM_NrGiorni[PARAM_NrGiorni],90)
			
			VAR tab_data =
			    FILTER(
			        ALLSELECTED(DIM_Calendario),
			        DIM_Calendario[Date] > ( MIN(DIM_Calendario[Date]) - nr_days ) &&
			        DIM_Calendario[Date] < MIN(DIM_Calendario[Date])
			    )
			
			
			VAR tab_clienti_ritornati = 
			    FILTER(
			        Lista_Clienti,
			        CALCULATE(
			            COUNTROWS('FACT_DocumentoVendita'),
			            tab_data
			        ) = 0
			    )
			
			RETURN
			    COUNTROWS(tab_clienti_ritornati)
			// valuta nr_clienti ritornati se non ci sono vendite negli ultimi nr_days
			```
		displayFolder: KPI Churn

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qta Vendite' =
			
			CALCULATE (
			    ABS ( [Qta Ton] ),
			    FILTER ( FACT_Magazzino, FACT_Magazzino[TipoMovimento] = "Vendita" )
			)
		formatString: #,0.00
		displayFolder: KPI Vendite
		annotation PBI_Description = "Quantità totale venduta in tonnellate"

		changedProperty = FormatString

	measure 'Prezzo Medio Vendita' = ```
			
			 CALCULATE(
			    AVERAGEX(
			        'FACT_DocumentoVendita',
			        'FACT_DocumentoVendita'[PrezzoUnitario]),
			    'FACT_DocumentoVendita'[CodiceCategoria] IN {"NAZ","UE","NAZPERM"}
			 )
			
			/*        
			VAR filtro_vendite =
			    { SELECTEDVALUE ( DIM_GruppiVendita[Gruppo], BLANK () ) }
			RETURN
			    IF (
			        filtro_vendite = "PASSAGGIO",
			        [Prezzo Passaggio],
			        [Prezzo Netto Doc Vendita] - [Prezzo Trasporto Doc Vendita]
			    )
			*/    
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite
		annotation PBI_Description = "Prezzo medio unitario di vendita per categorie NAZ, UE, NAZPERM"

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Rank Cliente' =
			
			RANKX ( ALL ( DIM_Clienti ), [Importo Vendita],, DESC )
		formatString: 0
		displayFolder: KPI Vendite
		annotation PBI_Description = "Classifica del cliente per importo vendita"

	measure 'Top 10 Clienti Vendite' =
			
			IF (
			    ISFILTERED ( DIM_Clienti[Nome] ),
			    IF ( [Rank Cliente] <= 10, [Importo Vendite (CG)], BLANK () ),
			    CALCULATE (
			        [Importo Vendite (CG)],
			        TOPN ( 10, VALUES ( DIM_Clienti[Nome] ), [Importo Vendite (CG)] )
			    )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: KPI Vendite
		annotation PBI_Description = "Importo vendite per i primi 10 clienti"

	measure 'Importo Vendite (CG)' =
			
			IF (
			    [Importo Clienti Vendite] <> 0,
			    [Importo Clienti Vendite],
			    //[Importo Clienti Vendite] - [Recupero Spese Trasporto],
			    [Importo Clienti Passaggi]
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite
		annotation PBI_Description = "Importo vendite basato sui movimenti di contabilità generale (CG)"

	measure 'Importo Clienti Passaggi' =
			
			CALCULATE (
			    ABS ( [Importo] ),
			    FILTER (
			        FACT_MovimentiCG,
			        FACT_MovimentiCG[Conto] IN { "3100001", "3100002", "3100003", "3100004" }
			    )
			)
		displayFolder: KPI Vendite
		annotation PBI_Description = "Importo vendite per passaggi (conti CG 31*)"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Clienti Vendite' = ```
			
			//VAR filtro_conti = {"3000002","3000003","3000004","3000005"}
			VAR filtro_conti = { "3000002", "3000003", "3000005" }
			VAR filtro_anno =
			    { SELECTEDVALUE ( DIM_Calendario[Year], 0 ) }
			VAR filtro_mese =
			    { SELECTEDVALUE ( DIM_Calendario[MonthName], 0 ) }
			VAR filtro_cliente =
			    { SELECTEDVALUE ( DIM_Clienti[Nome] ) }
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto] ) }
			VAR filtro_doc =
			    { SELECTEDVALUE ( 'FACT_DocumentoVendita'[Documento] ) }
			VAR filtro_progetto =
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "PROPANO", "PROPAN",
			        filtro_gruppo = "MIX", "MIX",
			        filtro_gruppo = BLANK (), BLANK ()
			    )
			VAR tab_filtro =
			    FILTER (
			        'FACT_MovimentiCG',
			        //FORMAT(YEAR(FACT_MovimentiCG[Document Date]),"String") IN filtro_anno &&
			        FACT_MovimentiCG[Conto]
			            IN filtro_conti
			            && //FACT_MovimentiCG[Source No_] IN filtro_cliente ||
			        FACT_MovimentiCG[Progetto] = filtro_progetto
			            && //FORMAT(MONTH(FACT_MovimentiCG[Document Date]),"String") IN filtro_mese ||                                    
			        //FACT_MovimentiCG[Document No_] = filtro_doc ||            
			        FACT_MovimentiCG[Tipo Documento]
			            IN { "Fattura", "Nota Credito" }
			    ) /*
			VAR tab_filtro = 
					FILTER(
						ALL('FACT_MovimentiCG'),
			            //FACT_MovimentiCG,
			            FORMAT(YEAR(FACT_MovimentiCG[Document Date]),"String") IN filtro_anno &&
			            FACT_MovimentiCG[Conto CG] IN filtro_conti &&
			            FACT_MovimentiCG[Source No_] IN filtro_cliente ||
			            FACT_MovimentiCG[Progetto] = filtro_progetto ||            
			            FORMAT(MONTH(FACT_MovimentiCG[Document Date]),"String") IN filtro_mese ||                                    
			            //FACT_MovimentiCG[Document No_] = filtro_doc ||            
			            FACT_MovimentiCG[Document Type] IN {"Fattura","Nota Credito"}                                   
			            
			        )
			*/
			VAR importo =
			    CALCULATE ( ABS ( [Importo] ), tab_filtro )
			RETURN
			    importo
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo Dirette' =
			
			DIVIDE ( [Importo Clienti Vendite], [Qta Vendite], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite

	measure 'Prezzo Passaggio' =
			
			DIVIDE ( [Importo Clienti Passaggi], [Qta Vendite], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite

	measure 'Importo Acquisti Progressivo (NAVI)' =
			
			CALCULATE (
			    [Total Costs NAVI],
			    FILTER ( ALL ( DIM_Calendario ), DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] ) )
			)
		displayFolder: KPI Vendite

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Clienti Vendita' =
			
			VAR Tab_Clienti_Vendita =
			    CALCULATETABLE (
			        VALUES ( FACT_Magazzino[Codice] ),
			        FILTER ( FACT_Magazzino, FACT_Magazzino[Tipo Movimento] = "Vendita" )
			    )
			RETURN
			    COUNTROWS ( Tab_Clienti_Vendita )
		formatString: 0
		displayFolder: KPI Vendite

	measure 'Importo Vendite Gruppo Cliente' =
			
			CALCULATE (
			    [Importo Vendite (CG)],
			    FILTER (
			        VALUES ( FACT_MovimentiCG[Importo] ),
			        COUNTROWS (
			            FILTER (
			                'Gruppo Vendite Clienti',
			                FACT_MovimentiCG[Importo] >= MIN ( 'Gruppo Vendite Clienti'[Min] )
			                    && FACT_MovimentiCG[Importo] < MAX ( 'Gruppo Vendite Clienti'[Max] )
			            )
			        ) > 0
			    )
			)
		displayFolder: KPI Vendite

	measure 'Qta Vendite Progressivo' =
			
			VAR tab_filtro =
			    FILTER (
			        ALL ( DIM_Calendario[Date] ),
			        DIM_Calendario[Date] >= DATE ( 2015, 1, 1 )
			            && DIM_Calendario[Date] <= MAX ( DIM_Calendario[Date] )
			    )
			RETURN
			    CALCULATE ( [Qta Vendite], tab_filtro )
		displayFolder: KPI Vendite

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Medio Vendita Mix' = ```
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			VAR filtro_calendario =
			    { SELECTEDVALUE ( DIM_Calendario[MonthInCalendar] ) }
			VAR tab_articolo =
			    CALCULATETABLE ( DIM_Articoli, DIM_Articoli[GruppoProdotto] IN filtro_gruppo )
			VAR filtro_articolo =
			    SELECTCOLUMNS ( tab_articolo, "@Articolo", DIM_Articoli[CodiceArticolo] )
			VAR tab_filtro =
			    FILTER (
			        'FACT_Mix',
			        'FACT_Mix'[CodiceArticolo]
			            IN filtro_articolo
			            && 'FACT_Mix'[MonthInCalendar] IN filtro_calendario
			    )
			RETURN
			    AVERAGEX (
			        tab_filtro,
			        'FACT_Mix'[Prezzo Euro Mese]
			    )
			```
		displayFolder: KPI Vendite
		annotation PBI_Description = "Prezzo medio vendita per i prodotti Mix"

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Permute' = [CMP Acquisto]
		displayFolder: KPI Vendite

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite' = [Qta Vendita] * [Prezzo Medio Vendita]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Importo Vendite OLD2' =
			
			VAR filtro_gruppo =
			    { SELECTEDVALUE ( DIM_Articoli[GruppoProdotto], BLANK () ) }
			VAR filtro_vendite =
			    { SELECTEDVALUE ( DIM_GruppiVendita[CodiceCategoria], BLANK () ) }
			RETURN
			    SWITCH (
			        TRUE (),
			        filtro_gruppo = "MIX", [Importo Clienti Vendite],
			        filtro_gruppo = "PROPANO",
			            SWITCH (
			                TRUE (),
			                filtro_vendite = "DIRETTE", KPI_Vendite[Importo Clienti Vendite],
			                filtro_vendite = "PASSAGGIO", KPI_Vendite[Importo Clienti Passaggi],
			                filtro_vendite = "PERMUTE", BLANK ()
			            ),
			        filtro_gruppo = BLANK (), BLANK ()
			    )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Prezzo Medio Vendita (CG)' =
			
			DIVIDE ( KPI_Vendite[Importo Vendite (CG)], [Qta Vendite], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Qta Vendite LY' =
			
			CALCULATE ( [Qta Vendite], DATEADD ( DIM_Calendario[Date], -1, YEAR ) )
		displayFolder: KPI Vendite

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prezzo Medio Vendita QTD' =
			
			TOTALQTD ( [Prezzo Medio Vendita], DIM_Calendario[Date] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Vendite

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Costo Venduto (Doc)' =
			
			[Qta Doc Vendita Articolo] * [CMP Acquisto]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: KPI Margine

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '# Clienti' = DISTINCTCOUNT('FACT_DocumentoVendita'[Codice Cliente Fatturazione])
		displayFolder: KPI Vendite

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Nuovi Clienti' = ```
			
			// Calcola vendite di clienti che hanno acquistato in un certo mese e non acquistano da nr_giorni
			VAR nr_giorni = SELECTEDVALUE(PARAM_NrGiorni[PARAM_NrGiorni],90)
			VAR Tab_Clienti = VALUES ( 'FACT_DocumentoVendita'[Codice Cliente Fatturazione] )
			
			VAR Clienti_Precedenti =
			    CALCULATETABLE (
			        VALUES ( 'FACT_DocumentoVendita'[CodiceClienteFatturazione]  ),
			        FILTER (
			            ALL ( DIM_Calendario[Date] ),
			            DIM_Calendario[Date] > MIN ( DIM_Calendario[Date] ) - nr_giorni && 
			            DIM_Calendario[Date] < MIN ( DIM_Calendario[Date] )
			        )
			    )
			RETURN
			    CALCULATE( 
			        [Importo Vendita],
			        EXCEPT ( Tab_Clienti, Clienti_Precedenti )
			    )
			```
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: KPI Churn

		changedProperty = FormatString

	measure '% Importo Nuovi Clienti' = DIVIDE([Importo Nuovi Clienti],[Importo Vendita],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI Churn

		changedProperty = FormatString

	measure '% Nuovi Clienti' = DIVIDE([# Nuovi Clienti],[# Clienti],0)
		displayFolder: KPI Churn

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importo Vendite (CMP)' = [Qta Vendita] * [CMP Giacenza]
		displayFolder: KPI Vendite

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ANALISI_VENDITE-2eaa7963-9991-4913-9872-c4938329fe39 = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Colonna1 = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Colonna1", type text}}),
				    #"Rimosse colonne" = Table.RemoveColumns(#"Modificato tipo",{"Colonna1"})
				in
				    #"Rimosse colonne"

	annotation PBI_ResultType = Table

