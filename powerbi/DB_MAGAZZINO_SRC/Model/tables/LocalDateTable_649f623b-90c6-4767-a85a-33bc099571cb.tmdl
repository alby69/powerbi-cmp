table LocalDateTable_649f623b-90c6-4767-a85a-33bc099571cb
	isHidden
	showAsVariationsOnly

	column Date
		isHidden
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	column Anno = YEAR([Date])
		isHidden
		dataCategory: Years
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Year

	column NumMese = MONTH([Date])
		isHidden
		dataCategory: MonthOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = MonthNumber

	column Mese = FORMAT([Date], "MMMM")
		isHidden
		dataCategory: Months
		summarizeBy: none
		sortByColumn: NumMese

		annotation SummarizationSetBy = User

		annotation TemplateId = Month

	column NumTrimestre = INT(([NumMese] + 2) / 3)
		isHidden
		dataCategory: QuarterOfYear
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = QuarterNumber

	column Trimestre = "Trim " & [NumTrimestre]
		isHidden
		dataCategory: Quarters
		summarizeBy: none
		sortByColumn: NumTrimestre

		annotation SummarizationSetBy = User

		annotation TemplateId = Quarter

	column Giorno = DAY([Date])
		isHidden
		dataCategory: DayOfMonth
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation TemplateId = Day

	hierarchy 'Gerarchia data'

		level Anno
			column: Anno

		level Trimestre
			column: Trimestre

		level Mese
			column: Mese

		level Giorno
			column: Giorno

		annotation TemplateId = DateHierarchy

	partition LocalDateTable_649f623b-90c6-4767-a85a-33bc099571cb-db742d0f-09df-4126-af17-b8984167752c = calculated
		mode: import
		source = Calendar(Date(Year(MIN('ORDINI'[Data Registrazione])), 1, 1), Date(Year(MAX('ORDINI'[Data Registrazione])), 12, 31))

	annotation __PBI_LocalDateTable = true

