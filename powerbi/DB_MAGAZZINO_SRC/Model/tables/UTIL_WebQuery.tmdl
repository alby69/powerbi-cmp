table UTIL_WebQuery

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: Name

		annotation SummarizationSetBy = Automatic

	column Value
		dataType: string
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic

	partition UTIL_WebQuery = m
		mode: import
		queryGroup: DIM
		source =
				let
				    Output =
				        [
				            PREZZI = FACT_PrezziMix,
				            COMPETENZA = BRIDGE_Competenza
				        ]
				in
				    Output

	annotation PBI_ResultType = Record
