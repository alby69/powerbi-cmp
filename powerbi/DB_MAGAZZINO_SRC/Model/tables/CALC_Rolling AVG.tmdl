table 'CALC_Rolling AVG'

	calculationGroup

		calculationItem Value = SELECTEDMEASURE()

		calculationItem 'Rolling AVG DAY' = ```
				VAR NumOfInterval = { SELECTEDVALUE(TimeRange[TimeRange],BLANK()) }
				VAR LastSelectedDay = MAX ( CALENDARIO[Date] )
				
				VAR Period = DATESINPERIOD ( CALENDARIO[Date], LastSelectedDay, - NumOfInterval, DAY )
				    
				VAR Result = 
				    CALCULATE (
				        AVERAGEX ( VALUES ( CALENDARIO[MonthInCalendar] ), SELECTEDMEASURE() ),
				                Period
				     )
				
				VAR LastDateWithSale =
				    MAX ( 'DOCUMENTO VENDITA'[Data Registrazione] ) // Trova ultimo giorno di vendita
				VAR FirstVisibleDate =
				    MIN ( CALENDARIO[Date] ) // Trova la prima data visibile
				RETURN
				    
				    IF ( FirstVisibleDate <= LastDateWithSale, Result )
				// controlla che la data sia nel range delle vendite
				```

